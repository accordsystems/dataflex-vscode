{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"module": "nodenext",
		"target": "ES2024",
		"lib": [
			"ES2024"
		],
		"moduleResolution": "nodenext",
		"sourceMap": true,
		"strict": true,
		"outDir": "out",
		"rootDir": "src",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
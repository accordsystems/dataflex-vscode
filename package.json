{
  "name": "dataflex-vscode",
  "version": "1.0.0",
  "description": "Dataflex Language Server and Client for VsCode",
  "homepage": "https://github.com/accordsystems/dataflex-vscode#readme",
  "bugs": {
    "url": "https://github.com/accordsystems/dataflex-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/accordsystems/dataflex-vscode.git"
  },
  "license": "ISC",
  "author": "Kyle Campbell",
  "type": "commonjs",
  "main": "./client/out/extension",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "lint": "eslint",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "test": "sh ./scripts/e2e.sh"
  },
  "contributes": {
    "configuration": {
      "title": "example configuration",
      "type": "object",
      "properties": {
        "dataflexLanguageServer.maxNumberOfProblems": {
          "type": "integer",
          "default": 100,
          "scope": "resource",
          "description": "The maximum number of problems reported by the Dataflex language server."
        }
      }
    }
  },
  "dependencies": {
    "typescript": "^5.9.2"
  }
}

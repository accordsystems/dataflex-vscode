{
  "name": "dataflex-vscode",
  "version": "1.0.8",
  "description": "Dataflex Language Server and Client for VsCode",
  "homepage": "https://github.com/accordsystems/dataflex-vscode#readme",
  "bugs": {
    "url": "https://github.com/accordsystems/dataflex-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/accordsystems/dataflex-vscode.git"
  },
  "license": "ISC",
  "author": "Kyle Campbell",
  "type": "commonjs",
  "main": "./client/out/extension",
  "activationEvents": [],
  "engines": {
    "vscode": "^1.103.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "precompile": "npm version patch --no-git-tag-version",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "package": "vsce package"
  },
  "contributes": {
    "configuration": {
      "title": "dataflex configuration",
      "type": "object",
      "properties": {
        "dataflex.languageServer.maxNumberOfProblems": {
          "type": "integer",
          "default": 100,
          "scope": "resource",
          "description": "The maximum number of problems reported by the Dataflex language server."
        },
        "dataflex.consoleMode.compileScriptPath": {
          "type": "string",
          "default": "D:\\source\\dataflex\\Import2000-DF32\\Compile\\x64\\DFComp64-cI20.ps1",
          "description": "Path to the Dataflex Console Mode Compile Script"
        },
        "dataflex.additionalFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional file extensions to be treated as Dataflex source files."
        }
      }
    },
    "languages": [
      {
        "id": "dataflex",
        "aliases": [
          "Dataflex",
          "dataflex"
        ],
        "extensions": [
          ".src",
          ".vw",
          ".sl",
          ".dg",
          ".rv",
          ".bp",
          ".pkg",
          ".wo",
          ".dd",
          ".inc",
          ".tpl",
          ".cmd",
          ".dfo"
        ],
        "configuration": "./client/src/syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dataflex",
        "scopeName": "source.dataflex",
        "path": "./client/src/syntaxes/dataflex.tmLanguage.json"
      }
    ],
    "tokenColors": [
      {
        "scope": [
          "keyword.operator",
          "keyword.operator.comparison",
          "keyword.operator.comparison.dataflex",
          "keyword.operator.comparison.dataflex source.dataflex"
        ],
        "settings": {
          "foreground": "#FF0000"
        }
      }
    ],
    "commands": [
      {
        "command": "dataflex.compileConsoleMode",
        "title": "Compile Dataflex Console Mode Program"
      }
    ],
    "documentSymbol": [
      {
        "language": "dataflex"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}

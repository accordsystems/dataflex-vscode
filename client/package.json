{
  "name": "dataflex",
  "displayName": "dataflex",
  "description": "Dataflex Vs Code Language Support",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [           
  ],
  "contributes": {
    "languages": [
      {
        "id": "dataflex",
        "aliases": [
          "Dataflex",
          "dataflex"
        ],
        "extensions": [
          ".src",
          ".vw",
          ".sl",
          ".dg",
          ".rv",
          ".bp",
          ".pkg",
          ".wo",
          ".dd",
          ".inc",
          ".tpl",
          ".cmd",
          ".dfo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dataflex",
        "scopeName": "source.dataflex",
        "path": "./syntaxes/dataflex.tmLanguage.json"
      }
    ],
    "tokenColors": [
      {
        "scope": [
          "keyword.operator",
          "keyword.operator.comparison",
          "keyword.operator.comparison.dataflex",
          "keyword.operator.comparison.dataflex source.dataflex"
        ],
        "settings": {
          "foreground": "#FF0000"
        }
      }
    ],
    "commands": [
      {
        "command": "dataflex.compileConsoleMode",
        "title": "Compile Dataflex Console Mode Program"
      }      
    ],
    "documentSymbol": [
      {
        "language": "dataflex"
      }
    ],
    "configuration": {      
      "title": "Dataflex",
      "properties": {
        "dataflex.consoleMode.compileScriptPath": {
          "type": "string",
          "default": "D:\\source\\dataflex\\Import2000-DF32\\Compile\\x64\\DFComp64-cI20.ps1",
          "description": "Path to the Dataflex Console Mode Compile Script"
        }        
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/accordsystems/dataflex-vscode.git"
  },
  "dependencies": {
    "typescript": "^5.8.3",
    "vcse": "^1.0.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/vscode": "^1.99.1",
    "vscode": "^1.1.37"
  }
}

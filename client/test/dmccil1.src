   MOVE 0 TO CURRENT_IMAGE
// @SET_TITLE_LINE AUTO
   @SHOW_TITLE_LINE
   GOSUB im_SET_BACF_TITLE_LINE  // in Am.cmd based on record buffers for opcust and bacf being set
         im_SHOW_BACF_TITLE_LINE
RETURN


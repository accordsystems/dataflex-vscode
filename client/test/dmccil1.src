Procedure pRefreshQuantityScreen
    local Integer bHasCfia  bUsePrevious
    Send gmDisplay_Quantity_Shadow    // dmccil1.pkg   
    Send gmSet_Quantity_Uom_From_B3   // dmccil1.pkg 
//at "0. pRefreshQuantityScreen"
    If (giNewline_added) Begin
// 2019-02-25
// Old: default is EA and LBR (if KGM)
// New: If CFIA: Use EA and LBR (KGM if prev was KGM)
//      If not CFIA: Use Previous 
//                   If no previous: EA and LBR (if KGM)
//      If (s_cnt_uom_inv = "")    Move "EA"  to s_cnt_uom_inv
//      If (s_cnt_uom_iid = "")    Move "EA"  to s_cnt_uom_iid
//      If (s_wgt_uom_inv = "KGM") Move "LBR" to s_wgt_uom_inv   // 2018-12-06
        Move (s_pgapgm_list contains "1CFIA") to bHasCfia
// New rule#1: Always change KGM to LBR. May be overridden by Previous
        If (s_wgt_uom_inv = "KGM") Move "LBR" to s_wgt_uom_inv  // 2019-05-06
        
        If (((bHasCfia) and (not(gbPrev_HasCfia))) or (gsPrev_cnt_uom_inv = "")) Begin
// 2019-05-06 To override DZN on hs 0603.12.00.00
//         If (s_cnt_uom_inv = "")    Move "EA"  to s_cnt_uom_inv
//         If (s_cnt_uom_iid = "")    Move "EA"  to s_cnt_uom_iid
                                      Move "EA"  to s_cnt_uom_inv
                                      Move "EA"  to s_cnt_uom_iid
// 2019-05-06
           If (s_wgt_uom_inv = "KGM") Move "LBR" to s_wgt_uom_inv   // 2018-12-06
        End
        Else Begin
//at "2.1 gsPrev_cnt_uom_inv [" gsPrev_cnt_uom_inv "]"
//at "2.2 gsPrev_cnt_wgt_inv [" gsPrev_wgt_uom_inv "]"
//at "2.3 gsPrev_cnt_vol_inv [" gsPrev_vol_uom_inv "]"
            Move gsPrev_cnt_uom_inv to s_cnt_uom_inv
            Move gsPrev_cnt_uom_iid to s_cnt_uom_iid
            If (gsPrev_wgt_uom_inv <> "") Move gsPrev_wgt_uom_inv to s_wgt_uom_inv
            If (gsPrev_vol_uom_inv <> "") Move gsPrev_vol_uom_inv to s_vol_uom_inv
        End
// 2019-02-25 end

// 2019-05-06
// New rule#2: Keep Previous. Never set to blank  - done in Enter1.save

// New rule#3: If not required by Cadex for this line, blank it for this line.
        If (s_wgt_uom = "") Begin
            Move "" to s_wgt_uom_inv
            Move "" to s_wgt_uom_iid
        End
        If (s_vol_uom = "") Begin
            Move "" to s_vol_uom_inv
            Move "" to s_vol_uom_iid
        End
// Possible new fields on ccimas.lst_uom_cnt_inv
// Possible new fields on ccimas.lst_uom_wgt_inv
// Possible new fields on ccimas.lst_uom_vol_inv
// Possible new fields on ccimas.lst_uom_cnt_iid
// Nah. Maybe later.
// The only advantage is if you exit cci line entry then go back in and add a line. 
// It would have remembered the last previous.
// 2019-05-06 end

    End  // if (giNewline_added) 
    Send gmRecalc_Values_Quantity     // dmccil1.pkg 
End_Procedure





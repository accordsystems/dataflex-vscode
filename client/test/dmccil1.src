//-----------------------------------------
                              REFRESH_FILES:
//-----------------------------------------
// all the im_ routines are in am.cmd
im_STANDARD_INIT // Now 2023-11-05 sets gbIsCad and gbCadActive
                 // Now 2024-03-29 sets gbIsCad_[All/EnterCalc/Ccship] and gbCadActive
   [not im_GOT_CCSHIP] Begin
      @SYSTEM_PROBLEM EXIT "Not an CCI Shipment - BACF# " bacf.bacf#
   END
   im_MUSTHAVE_BACF_IMPORT GOTO @end_program
   im_MUSTHAVE_B3MAIN      GOTO @end_program
   im_MUSTHAVE_CCSHIP      GOTO @end_program
   im_MUSTHAVE_BACFSTAT    GOTO @end_program
   im_MUSTHAVE_OPCUST      GOTO @end_program
   im_MUSTHAVE_CCSHIP      GOTO @end_program
   if bacf.bacf# ne giBacf# begin
      @system_problem exit "BACF# changed from " giBacf# ;
                           " to " bacf.bacf#
   end
RETURN


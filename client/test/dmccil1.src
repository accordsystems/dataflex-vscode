    // 2023-03-01 end
// 2015-07-11
// Too many indicators to use [RATE_SUPERVISOR]
//   @@SET_RATE_SUPERVISOR_OPERATOR // 2015-07-11   in cbs.cmd

   Move sysfile2.sys_upd_app_rat to FIELDINDEX
   If FIELDINDEX GT 19 Move 3 to FIELDINDEX     // default is 3 - operations
   If FIELDINDEX LT  1 Move 3 to FIELDINDEX     // default is 3 - operations
   @DECREMENT FIELDINDEX

   If zrun.zu_lvl_ss1& GE sysfile2.lvl_upd_app_rat Begin
       Move (True)  to gbRateSupervisor   
   End
   Else Begin
       Move (False) to gbRateSupervisor
   End
// 2015-07-11 end

// Sets w#sl_ and w#s_ fields
// @D_SCREENS screenLIST screenENTER  
   @D_SCREENS screenLIST screenENTER  screenENTER1  // 2019-03-12

// Update OK parameter for use by F#... and other programs. pick one.
   CMDLINE param1
// INDICATE UPDATE_OK AS param1 NE "NO_UPDATE" // all others

// Must have a ccimas
   if not status ccimas begin
      @system_problem exit "Called with no active CCIMAS record."
   end
   relate ccimas  // ensure we got ccship, bacf, opcust

   move ccimas.cci_id to gsThis_cci_id
   Move ccimas.bacf#  to giBacf#
   Move Ccimas.dms_po_inv_date  to gdDefaultAcquisitionDate   // 2021-10-25
   Send pSet_gbUpdateOk giBacf#

    GOSUB REFRESH_FILES // Now 2023-11-05 sets gbIsCad and gbCadActive
                        // Now 2024-03-29 sets gbIsCad_[All, EnterCalc, Ccship] and gbCadActive
    //+ 2024-01-25
    //+ No to these tables
    //+ // 2023-11-05  From a bit higher up
    //+ If (gbCadActive) Begin
    //+     @OPEN_RO CadCode     // 2021-10-06
    //+     @OPEN_RO CadCodeType // 2021-10-06
    //+ End    
    //+ // 2023-11-05 end
    //+ 2024-01-25 end

   if (mInitialize_opcust(oRrec_info.obj, bacf.opcust_recnum)) eq giFalse begin
      @system_problem exit "Initializing oRrec_info at start"
   End
   
   // 2023-11-05 Move (Ccship.IsCad = "Y") to gbIsCaD   // 2023-05-30
   
//   Move (bacfstat.status_op >= 10) to gbRatingFinished  // 2015-05-02
   
// Main screen first
   move 1 to giScreen#

// Auto Page# - N for paper submissions where 1 CCI can have multiple pages
   im_SET_AUTO_PAGE#   //  am.cmd

// Warehouse indicators
   am_SET_WAREHOUSE b3main.f1_type  // am.cmd
                                    //  sets  giWH_need_prev_txn

// Low intensity fields
   SCREENMODE @colour_LO ON
      [im_AUTO_PAGE#] move s_page#              to s_page#
      [im_AUTO_PAGE#] move s_line#              to s_line#
      move s_cci_id             to s_cci_id
      move s_match_b3lc_descrip to s_match_b3lc_descrip
      move s_other_uom_cwv      to s_other_uom_cwv
//    move s_acr_uom_ok        to s_acr_uom_ok
//    move s_acr_uom_cwv       to s_acr_uom_cwv
//    move s_acr_uom_invalid   to s_acr_uom_invalid
//    move s_acr_uom_acr       to s_acr_uom_acr
//    move s_cnt_uom_b3        to s_cnt_uom_b3
//    move s_cnt_uom_ok        to s_cnt_uom_ok
//    move s_cnt_uom_b3_src    to s_cnt_uom_b3_src
//    move s_wgt_uom_b3        to s_wgt_uom_b3
//    move s_wgt_uom_ok        to s_wgt_uom_ok
//    move s_wgt_uom_b3_src    to s_wgt_uom_b3_src
// 2015-03-18
//+++++      Move s_opappr_ok         to s_opappr_ok
//+++++      Move s_opappr_code       to s_opappr_code
// 2015-03-18 end
//    Move s_vol_uom_b3        to s_vol_uom_b3
//    move s_vol_uom_ok        to s_vol_uom_ok
//    move s_vol_uom_b3_src    to s_vol_uom_b3_src
      move s_vfcc               to s_vfcc
   
      Send gmDisplay_quantity_shadow // 2018-10-09  
   SCREENMODE @colour_HI OFF
   

// If no ccilin's for this ccimas, if gbUpdateOk, goto add_ccilin
// gosub refresh_update_ok
   Send pSet_gbUpdateOk giBacf# // 2019-03-19
   
   Clear ccilin
   move gsThis_cci_id to ccilin.cci_id
   find ge ccilin by index.1  //  <cci_id> <line#>
   [found] indicate found as ccilin.cci_id eq gsThis_cci_id
// [not found] [update_ok] begin
   [not Found] If (gbUpdateOk) Begin  // 2019-03-19
      Clear ccilin
      page_help screenHELPlist
      screenmode @colour_LO ON
      blankform screenLIST
      screenmode @colour_HI OFF
      page      screenLISTend
      page      screenLIST
      move 1 to @scroll_LINE#   // 10/22/1996 for @enterend_scroll
      gosub @scroll.display_extra
      goto add_ccilin
   end

   clear ccilin
  @scroll_RESET_LIST REFRESH     0   1 1
//                                        line# col# (col# added 09/02/1990)
 
#IFDEF TitleMarkerNeverTrue
Property String _MainProcessing
#ENDIF
 
//========================> Main Processing <=================================
Start_list:


// @system_problem exit "Changes for B3line code expansion not completed. Soon!"  // 2025-02-21



// Remember:  After a scroll, all keyproc's are toast!
//   Move (bacfstat.status_op >= 10) to gbRatingFinished  // 2019-03-19
// 2018-03-08
   If (ccimas.cci_id <> gsThis_cci_id) Begin
       @system_problem exit "Ccimas Id changed from [" ccimas.cci_id ;
                            "] to [" ccimas.cci_id
   End
   Relate Ccimas    // to get bacf and opcust
   GOSUB REFRESH_SCREEN  // does title_line from bacf and opcust  // 2018-03-06
// 2018-03-08 end   
   
   PAGE_HELP screenHELPlist
   PAGE      screenLIST
   PAGE      screenLISTend
   PAGE      screenLINECODEdisplay
// Bottom Help Line 4 choices
   If (gbUpdateOk) Begin  
       // 2020-04-28
       // 2025-05-02 KRC Knockout IID specific Code
       //If (gbSubmitIID) @message "<F9>Add <F6>Del <F7>InsRepl <F8>B3LnCd <F3>Info <F4>Pga <Enter>Add/Upd <F10>APR" <- This was already commented 2025-05-02
       //If (gbGotBacfIID) @message "<F9>Add <F6>Del <F7>InsRepl <F8>B3LnCd <F3>Info <F4>Pga <Enter>Add/Upd <F10>APR"
       // 2020-04-28 end
       //Else             @message "<F9>Add <F6>Del <F7>InsRepl <F8>B3LnCd <Enter>Add/Upd <F10>Autorate"
       @message "<F9>Add <F6>Del <F7>InsRepl <F8>B3LnCd <F3>Info <F4>Pga <Enter>Add/Upd <F10>APR"
   End
   Else Begin
       // 2020-04-28
       // 2025-05-02 KRC Knock out IID Specific Code
       //If (gbSubmitIID) @message "NO UPDATE: <F8>B3LnCode <F3>PgmQAInfo <F4>Pga <Enter>RightSide <F10>APR" <-- Already Commented
       //If (gbGotBacfIID) @message "NO UPDATE: <F8>B3LnCode <F3>PgmQAInfo <F4>Pga <Enter>RightSide <F10>APR"
       // 2020-04-28 end
       //Else             @message "NO UPDATE: <F8>B3LnCode  <Enter>Right hand side <F10>APR"
       @message "NO UPDATE: <F8>B3LnCode <F3>PgmQAInfo <F4>Pga <Enter>RightSide <F10>APR"
   End
   INDICATE @scroll_SHOW_ZERO_LINE True
   MOVE 0 TO FILENUMBER
   MOVE 0 TO FIELDNUMBER

   @SCROLL.BEGIN

   @SCROLL.START:
      [@SAVE_DONE] BEGIN  // go down to next line - could be zero
         If (giNewline_added) INDICATE @scroll_SKIPTO_NEXT_LINE True
         INDICATE @SAVE_DONE FALSE
         move giFalse to giNewline_added
      END
   RETURN

   @SCROLL.DISPLAY_LINE:
      PAGE screenLIST
      MOVE ccilin.page#       TO sl_page#&
      MOVE ccilin.line#       TO sl_line#&
      MOVE ccilin.b3line_code TO sl_b3line_code&
      // MOVE ccilin.edit_ok     TO sl_edit_ok&
      MOVE ""                 TO sl_edit_ok&
      MOVE ccilin.amount      TO sl_amount&
      SET_PGA_FILE   // dmlib086.pkg   sets gbPga and pga_cfia pga_... indicators
      if (gbPga) begin
         If ccilin.pgapgm_list ne "" Move ccilin.pgapgm_list to sl_edit_ok&
      //Todo1: Maybe make this count of PGA'a
      End
      
      // 2025-01-30
      Get Update_Ccilin_New_Fields_From_Old_20250130 of oCadUtil to gsMessage
      If (gsMessage <> "OK") Begin
         @system_problem exit "Update New failed [" gsMessage "]"
      End
      // 2025-01-30 end
      
      
   RETURN

   @SCROLL.DISPLAY_EXTRA:
     // giScreen#
     //    1       Normal
     //    2       PGA part 1 if (gbPga)
     //            Screen saying NoPga     if not
     //    3       F8-C Cad screen
     //    4       F8-S SIMA screen
Integer giSave1
      // 2025-01-31
      Get Update_Ccilin_New_Fields_From_Old_20250130 of oCadUtil to gsMessage
      If (gsMessage <> "OK") Begin
         @system_problem exit "Update New2 failed [" gsMessage "]"
      End
      // 2025-01-31 end

      // 2019-03-20    
      Move (Ccilin.cci_id + Ccilin.ccil_id) to gsRef_Cciln
      Move Ccilin.recnum                    to giCcilinRecnum 
      // 2019-03-20 end
      Move windowindex to giSave1
      move giFalse to giDisplayed_pga
      move (false) to gbPage2
      if giScreen# eq 1 gosub SCROLL.DISPLAY_EXTRA1
      If giScreen# eq 2 Begin  // <F4-CcXtraSw>
                           move (false) to gbPage2
                           gosub SCROLL.DISPLAY_EXTRA1              // Top part
                           // 2020-12-22
                           Get HasCcxtraSw of oSwInfo gsRef_Cciln to gbHasCcxtraSw  
                           // gbPga true if PgmPgm_List is not blank
                           // If (gbPga)                   gosub SCROLL.DISPLAY_EXTRA2   // PGA Overright Top and Bottom
                           If ((gbHasCcxtraSw) or (gbPga)) gosub SCROLL.DISPLAY_EXTRA2   // PGA Overright Top and Bottom
                           // 2020-12-22 end
                           Else   PAGE screenENTERnoPGA1
                           // At "gbHasCcxtraSw [" gbHasCcXtraSw "] gbPga [" gbPga "]"
      End
      // 2021-10-03
      If (giScreen# = 3) Begin
          gosub SCROLL.DISPLAY_ENTERCAD     
      End
      If (giScreen# = 4) Begin
          gosub SCROLL.DISPLAY_ENTER3
      End
      // 2021-10-03 end
      
// 2019-03-12
//    If giScreen# eq 3 Begin
//                         Move (True) to gbPage2
//                         gosub SCROLL.DISPLAY_EXTRA1
//                         If (gbPga) gosub SCROLL.DISPLAY_EXTRA2   // PGA
//                         Else   PAGE screenENTERnoPGA2
//                      End
//    If giScreen# eq 4 gosub SCROLL.DISPLAY_ENTER3   // Hidden fields
// 2019-03-12 end
      Move giSave1 to windowindex
      // (only ACCORD sees hidden screens)
      
      Move (Ccilin.b3line_code = "") to gbB3LineCode_WasBlank  // 2020-08-19
   RETURN

// 2019-03-12
//   SCROLL.DISPLAY_ENTER3:
//      PAGE screenENTERhidden
//   RETURN
// 2019-03-12 end

#IFDEF TitleMarkerNeverTrue
Property String SCROLL.DISPLAY_EXTRA2:
#ENDIF
SCROLL.DISPLAY_EXTRA2:    // giScreen# 2 and  gbPga true
    // 2021-05-03 
    // Check at end that 104 x 114 x 115 = 105
    // Must have all of them so start them all at -9
    Number  gn104 gn114 gn115 gn105 gn105_converted
    Integer gi105_line  gi116_line                 
    String  gs116_uom
    Number gnConvertFactor
    Move -9 to gn104
    Move -9 to gn114
    Move -9 to gn115
    Move -9 to gn105
    // 2021-05-03 end
    // Screen holds 18 items
    screenmode @colour_LO ON 
    blankform screenENTERsw
    Move 0            to giLineSw
    Move Ccilin.bacf# to gsBacfSw
    //    Move (Ccilin.cci_id + Ccilin.ccil_id) to gsRef_Cciln
    blankform screenENTERswHEADER
    screenmode @colour_HI ON
    Move "SW PGA INFO" to swh_title      // 2019-01-26
    Move gsBacfSw      to swh_bacf#
    Move gsRef_Cciln   to swh_ref_cciln
    Move Ccilin.line#  to swh_line#
    screenmode @colour_LO ON 
    
    Clear ccxtrasw
    Move gsBacfSw    to ccxtrasw.bacf
    Move gsRef_Cciln to ccxtrasw.ref_cciln
    Repeat
       Find gt ccxtrasw by Index.1  //  <bacf> <ref_cciln> <process_id> <recnum>
       Move (Found) to gbGotit
       If (gbGotit) Move (ccxtrasw.bacf      = gsBacfSw)    to gbGotit
       If (gbGotit) Move (ccxtrasw.ref_cciln = gsref_cciln) to gbGotit
       If (gbGotit) Begin
          Add 1 to giLineSw
          Clear SwProcId 
          Move ccXtraSw.Process_Id to SwProcId.id
          Find eq SwProcId by Index.1  //  <Id>
          If (Found) Move SwProcId.Title to gsTitle
          Else       Move "??Unknown??"  to gsTitle
          //+++ 2019-01-19
          //----------- Keep in sync with dmCcxtSw.src ------------
          //----------- Keep in sync with dmCcxtSw.src ------------
          //----------- Keep in sync with dmCcxtSw.src ------------
          SETWINDOWINDEX_SW giLineSw
          //Move (gfProcessIdTitle(CcXtraSw.process_id)) to sw_process_id_title&
          Get SwProcessIdTitle of oPgaInfo.obj CcXtraSw.process_id to sw_process_id_title&  
          Move CcXtraSw.code to sw_code&
          Move CcXtraSw.value_coded to sw_value_coded&
          Move (trim(CcXtraSw.value_text1) * trim(CcXtraSw.value_text2)) to sw_value_text&
    
          // LPCO
          If (ItsaLpco(ghoLpcoNad, CcXtraSw.Process_Id)) Begin 
              Send SetLpcoListDescriptions to oXtraSw "B" gsBacfSw CcXtraSw.code
              Get psList_ProcessTitle of oXtraSw to sw_process_id_title&
              Get psList_ValueCoded   of oXtraSw to sw_value_coded&      
              Get psList_ValueText    of oXtraSw to sw_value_text&       
          End
          // NAD
          If (ItsaNad(ghoLpcoNad, CcXtraSw.Process_Id)) Begin  
              Send SetNadListDescriptions to oXtraSw "B" gsBacfSw CcXtraSw.code sw_process_id_title&
              Get psList_ProcessTitle of oXtraSw to sw_process_id_title&
              Get psList_ValueCoded   of oXtraSw to sw_value_coded&      
              Get psList_ValueText    of oXtraSw to sw_value_text&       
          End
          // 2021-05-03
          // -WARN  -STOP append to sw_value_coded&
          Get AppendWarnStopToValueCoded_Line sw_value_coded& sw_value_text& to sw_value_coded&
          If (left(sw_value_coded&,3) = "104") Move sw_value_text& to gn104
          If (sw_value_coded&         = "114") Move sw_value_text& to gn114
          If (sw_value_coded&         = "115") Move sw_value_text& to gn115
          If (Left(sw_value_coded&,3) = "105") Move sw_value_text& to gn105
          If (Left(sw_value_coded&,3) = "105") Move giLineSw       to gi105_line
          If (Left(sw_value_coded&,3) = "116") Move giLineSw       to gi116_line
          If (Left(sw_value_coded&,3) = "116") Move (trim(uppercase(sw_value_text&))) to gs116_uom 
          // 2021-05-03 end
          // End - Max Line 
          If (giLineSw = giMaxLineSw) Begin
              Move (False) to gbGotit
          End
         
       End  //  gbGotit
    Until (not(gbGotit))
    // 2021-05-03
    If ((gn104 <> -9) and (gn114 <> -9) and (gn115 <> -9) and (gn105 <> -9)) Begin
       // 1. Check calc of items on the list
       // at ("gn105 [" + (String(gn105)) )
       // 2021-06-03
       // If (gn105 <> (gn104 * gn114 * gn115)) Begin
       Number gn104_114_115 gnMax gnMin
       Move (gn104 * gn114 * gn115) to gn104_114_115
       Move (gn105 + 1)     to gnMax
       Move (gn105 - 1)     to gnMin
       // at ("gn105 [" + (String(gn105)) + "] Max [" + (String(gnMax)) + "] Min [" + (String(gnMin)) + ;
       //       "] gn104_114_115 [" +(String(gn104_114_115)) + "]")
       If ((gn104_114_115 > gnMax) or (gn104_114_115 < gnMin)) Begin
       // 2021-06-03 end 
       // at "gn105 does not match 104x114x115 so STOP1 " gi105_line
           SETWINDOWINDEX_SW gi105_line
           Move "105-STOP1" to sw_value_coded&
       End
       Else Begin
           // 2. Compare the total in gi105 to ccilin.wgt_quan_inv 
           Move (Convert_uomiid(ghoI20, gs116_uom, Ccilin.wgt_uom_inv)) to gnConvertFactor
           // At "gs116Uom [" gs116_uom "] ccilin wgt uom inv [" ccilin.wgt_uom_inv "]"
           Move (gn105 * gnConvertFactor) to gn105_converted
           // at ("gn105 [" + (String(gn105)) + "] Factor [" + (String(gnConvertFactor))) "] Converted [" gn105_converted "]"
           Send AppendWarnStop105 gi105_line gn105_converted Ccilin.wgt_quan_inv
       End 
    End
    // 2021-05-03 end
    Move giTrue to giDisplayed_pga
    
    PAGE screenENTERswHEADER
    PAGE screenENTERsw
    screenmode @colour_HI OFF    // 2019-01-20
RETURN

    // 2021-10-03
    
#IFDEF TitleMarkerNeverTrue
Property String SCROLL.DISPLAY_ENTERCAD
#ENDIF
SCROLL.DISPLAY_ENTERCAD:
// at3 "[dmCcil1 DISPLAY_ENTERCAD] ccilin.oic_code is [" ccilin.oic_code "]"    
    screenmode @colour_HI ON
    Page screenENTERcad
    Move "CAD INFO"                      to sc_title
    Move giBacf#                         to sc_bacf#
    Move gsRef_Cciln                     to sc_ref_cciln
    Move Ccilin.line#                    to sc_line#

    // Move Ccilin.Override_Cbsa_Calc_Y     to sc_Override_Cbsa_Calc_Y   // 2024-12-10          
    Move Ccilin.Vaping_Amount            to sc_Vaping_Amount           
    Move Ccilin.Luxury_Tax_Amount        to sc_Luxury_Tax_Amount       
    Move Ccilin.Alcohol_Percent          to sc_Alcohol_Percent         
    Move Ccilin.Destination_Province     to sc_Destination_Province    
    Move Ccilin.Provincial_Amount        to sc_Provincial_Amount       
    Move Ccilin.Other_Accept_Rate_Amount to sc_Other_Accept_Rate_Amount
    Move Ccilin.Other_Accept_Rate_Type   to sc_Other_Accept_Rate_Type  
    
    Move Ccilin.Override_HS              to sc_Override_HS             
    Move Ccilin.Override_Annex           to sc_Override_Annex          
    Move Ccilin.Excise_Tax_Code          to sc_Excise_Tax_Code         
    Move Ccilin.Gst_Code                 to sc_Gst_Code                
    Move Ccilin.Permit_Number            to sc_Permit_Number           
    Move Ccilin.Oic_Code                 to sc_Oic_Code                
    Move Ccilin.Oic_Sub_Code             to sc_Oic_Sub_Code            
    Move Ccilin.Spec_Auth_Oic_Or_Drl     to sc_Spec_Auth_Oic_Or_Drl    
    Move Ccilin.Ruling_Number            to sc_Ruling_Number           
    Move Ccilin.Previous_Transaction     to sc_Previous_Transaction    
    Move Ccilin.Previous_Line            to sc_Previous_Line           
    Move Ccilin.TimeLimit_Start          to sc_TimeLimit_Start         
    Move Ccilin.TimeLimit_End            to sc_TimeLimit_End           
    Move Ccilin.TimeLimit_Type           to sc_TimeLimit_Type   // 2024-03-22    
    Move Ccilin.TimeLimitMonths          to sc_TimeLimitMonths         
    screenmode @colour_HI OFF 
RETURN // 2021-10-03 END
    
#IFDEF TitleMarkerNeverTrue
Property String SCROLL.DISPLAY_ENTER3
#ENDIF
SCROLL.DISPLAY_ENTER3: // 2021-10-07
    screenmode @colour_HI ON
    Page screenENTER3
    Move "SIMA INFO"                   to scs_title
    Move giBacf#                       to scs_bacf#
    Move gsRef_Cciln                   to scs_ref_cciln
    Move Ccilin.line#                  to scs_line#
    
    //Sima
    Move Ccilin.Sima_MifCode           to scs_Sima_MifCode          // f#6 101  ECCRD App G38           
    Move Ccilin.Sima_Subject_Code      to scs_Sima_subject_Code
                                       
    Move Ccilin.Sima_Note1             to scs_sima_Note1            
    Move Ccilin.Sima_Note2             to scs_sima_Note2         
    Move Ccilin.Sima_Note3             to scs_sima_Note3         
    Move Ccilin.Sima_Note4             to scs_sima_Note4         
                                       
    Move Ccilin.Sima_Code              to scs_sima_Code          
    Move Ccilin.Sima_Bond              to scs_sima_Bond          
    Move Ccilin.Sima_Mif_Provisional   to scs_Sima_Mif_Provisional 
    Move Ccilin.Sima_Inco_Term         to scs_sima_Inco_Term     
    // Move Ccilin.Sima_Override_Y     to scs_Sima_Override_Y         
                                       
    Move Ccilin.Product_Model_Id       to scs_Product_Model_Id // 2023-10-18
    Move Ccilin.Sima_BN15              to scs_Sima_BN15               
    Move Ccilin.SimaAcquisition        to scs_SimaAcquisition // 2021-10-25     
                                       
    Move Ccilin.Sima_Stb_Quan          to scs_sima_Stb_Quan      
    Move Ccilin.Sima_Stb_Uom           to scs_sima_Stb_Uom    
       
    Move Ccilin.SimaCntrVailAmt          to scs_SimaCntrVailAmt   
    Move Ccilin.Override_CounterVail_Amt to scs_Override_CounterVail_Amt      
    Move Ccilin.SimaAntiDumpAmt          to scs_SimaAntiDumpAmt  
    Move Ccilin.Override_AntiDump_Amt    to scs_Override_AntiDump_Amt        
    
    Move Ccilin.Sima_Dedn_Amt          to scs_Sima_Dedn_Amt           
    Move Ccilin.Sima_Dedn_Curr         to scs_Sima_Dedn_Curr
    Move Ccilin.ItemChgAmt             to scs_ItemChgAmt          
    Move Ccilin.ItemChgAmt_Curr        to scs_ItemChgAmt_Curr
       
    //Surtax
    Move Ccilin.Surtax_Code            to scs_Surtax_Code // f#6 102  ECCRD App G36   
    Move Ccilin.Surtax_Subject_Code    to scs_Surtax_Subject_Code // f#6 102  ECCRD App G36           
    
    screenmode @colour_LO ON        
    Get SurtaxRate of oSurtaxCalculator scs_Surtax_Code scs_Surtax_Subject_Code to scs_Surtax_Rate        
    Move Ccilin.SurtaxAmount           to scs_Surtax_Amount   
    screenmode @colour_HI ON
    Move Ccilin.Override_Surtax_Amt    to scs_Override_Surtax_Amt      
    
    //Safeguard                                   
    Move Ccilin.Safeguard_Code         to scs_Safeguard_Code            // f#6 103  ECCRD App G37   
    Move Ccilin.Safeguard_Subject_Code to scs_Safeguard_Subject_Code    // f#6 102  ECCRD App G36           
    Move Ccilin.SafeguardAmount        to scs_Safeguard_Amount    
    Move Ccilin.Override_Safeguard_Amt to scs_Override_Safeguard_Amt      
    
    screenmode @colour_HI OFF            
    Send SimaSurtaxSafeGuardRefresh       
RETURN    

#IFDEF TitleMarkerNeverTrue
Property String SCROLL.DISPLAY_EXTRA1
#ENDIF
    
SCROLL.DISPLAY_EXTRA1:
    Move 0 to current_window   // dont display till all done
    screenmode @colour_LO ON
    [im_AUTO_PAGE#] Move ccilin.page#             to s_page#
    [im_AUTO_PAGE#] Move ccilin.line#             to s_line#
    Move ccilin.cci_id            to s_cci_id
    Move " "                      to s_takes_cash_disc   
    Move ccilin.amount_cad        to s_amount_cad        // 2019-02-13
    Move ccilin.orig_new_part#    to sop_orig_new_part#  // 2019-06-26
    Move ccilin.orig_new_part#    to snp_orig_new_part#  // 2019-06-26
    Move ccilin.new_rat_item#     to snp_new_rat_item#   // 2019-06-26
    Move ccilin.RATING_ITEM#      to sh_rating_item#     // 2020-12-13
    
    screenmode @colour_HI ON
    [not im_AUTO_PAGE#] Move ccilin.page#             to s_page#
    [not im_AUTO_PAGE#] Move ccilin.line#             to s_line#
    Move ccilin.b3line_code       to s_b3line_code
    Move ccilin.PART#             to s_PART#
    Move ccilin.RATING_REC#       to s_RATING_REC#
    Move ccilin.TAR_TREAT         to s_TAR_TREAT
    Move ccilin.VFD               to s_VFD
    Move ccilin.CTRY_ORIG         to s_CTRY_ORIG
    Move ccilin.CELLO             to s_CELLO
    Move ""                       to s_FORCE_NEW_B3LC
    screenmode @colour_HI OFF
    // Move ccilin.RATING_ITEM#      to sh_rating_item#  // 2020-12-13 removed
    Move ccilin.HS#               to sh_HS#
    
    Move ""                       to s_match_b3lc_descrip
    Move Ccilin.AutoRate_Method   to s_autorate_method     // 2015-07-03
    Move ccilin.AMOUNT            to s_AMOUNT
    
    SET_PGA_FILE
    SHOW_PGA // 2024-03-17
    // 2020-04-28
    // If (gbSubmitIID) Begin
    // 2025-05-02 KRC Generalize IID Specific Code
    //If (gbGotBacfIID) Begin
    // 2020-04-28 end
     Move ccilin.ogd_group_auto       to s_pga_auto    
     Move Ccilin.pgapgm_list          to s_pgapgm_list  // 2017-10-07
     Move Ccilin.pgaqa_list           to s_pgaqa_list   // 2018-03-31
     Move Ccilin.pgaqa_list           to gsPgaQaList    // 2020-04-30
     Move Ccilin.pgaqa_status         to s_pgaqa_status // 2018-03-31
     Move Ccilin.sima                 to s_sima         // 2017-10-07
    //End //END 2025-05-02        
    
    screenmode @colour_HI ON
    Move ccilin.DESC1             to s_DESC1
    Move ccilin.DESC2             to s_DESC2
    Move ccilin.DESC3             to s_DESC3
    // MOVE ccilin.DESC4             TO s_DESC4
    
    Move ccimas.ddp_value_y       to sh_ddp_value_y       // hidden screen
    Move ccilin.ddp_value_calc    to sh_ddp_value_calc    // hidden screen
    Move ccilin.ddp_duty_rate     to sh_ddp_duty_rate     // hidden screen
    Move ccilin.ddp_dedn_other    to sh_ddp_dedn_other    // hidden screen
    If (opcust.takes_disc = "Y") ;
     Move "Takes CDisc"         to s_takes_cash_disc
    Move ccilin.amount            to s_amount
    Move ccilin.trade_flag        to s_trade_flag
    Move ccilin.trade_pct         to s_trade_pct
    Move ccilin.trade_amt         to s_trade_amt
    Move ccilin.freight_flag      to s_freight_flag
    Move ccilin.freight_amt       to s_freight_amt
    Move ccilin.other_flag        to s_other_flag
    Move ccilin.other_uom         to s_other_uom
    Move ccilin.other_quan        to sh_other_quan
    Move ccilin.other_rate        to s_other_rate
    Move ccilin.other_pct         to s_other_pct
    Move ccilin.other_amt         to s_other_amt
    Move ccilin.term_flag         to s_term_flag
    Move ccilin.term_pct          to s_term_pct
    Move ccilin.term_amt          to s_term_amt
    Move ccilin.vfcc              to s_vfcc
    
    // Get b3line
    If ccilin.b3line_code eq "" Begin        
     If (ccilin.cci_id <> "") Begin
        @system_note "Ccilin cciId [" ccilin.cci_id ;
                     "] has blank b3line_code. lid[" ccilin.ccil_id "]"
     End
    End
    
    Clear b3line
    Move giBacf#           to b3line.bacf#
    Move ccilin.b3line_code to b3line.b3line_code
    Find eq b3line by Index.1  //  <bacf#> <b3line_code>
    [not Found] Clear b3line
    
    screenmode @colour_HI OFF
    // 2024-03-13
    // 2025-05-02 KRC Knockout IID Specific Code
    //    If (not(gbGotBacfIid)) Begin
    //     Move Ccilin.pgapgm_list   to s_pgapgm_list 
    //     Move Ccilin.pgaqa_list    to s_pgaqa_list  
    //     Move Ccilin.pgaqa_status  to s_pgaqa_status
    //    End
    // 2024-03-13 ebd
    Send gmDisplay_b3lc_uom_quan  // screen fields from b3lc, not ccilin
    
    Send gmDisplay_b3lc_addl to desktop
    Send gmSet_b3lc_hidn     to desktop
    
    // Uom quan lines, HI or LO
    Send gmDisplay_quantity_from_ccilin to desktop   // dmccil1.pkg
    
    // Totals
    page screenLISTend
    Move ccimas.moa_total_amt    to s_moa_total_amt
    Move ccimas.tot_line_amount  to s_tot_line_amount
    Move ccimas.tot_diff         to s_tot_diff
    
    // Values
    Send gmDisplay_all_values   // sets hi lo stuff
    
    PAGE screenENTER
    If (gbShowPgaInfo) Begin
      //Send gmDisplay_Pga1Info s_pgapgm_list //Program list with description of Programs
      //Send gmDisplay_Pga2Info gsPgaQaList //Q&A     list with description of Questions and Answers      
      Send DisplayPga1Info to oPgaInfo.obj s_pgapgm_list //Program list with description of Programs 2025-05-02 KRC 
      Send DisplayPga2Info to oPgaInfo.obj gsPgaQaList //Q&A list with description of Questions and Answers 2025-05-02 KRC 
    End   
    Else Begin 
     PAGE screenENTER1
     PAGE screenENTER2 
    End
    // 2019-06-26
    If (Ccilin.new_rat_item# <> 0) PAGE screenENTERnewPART
    Else                           PAGE screenENTERoriginalPART
    // 2019-06-26 end
RETURN  //  SCROLL.DISPLAY_EXTRA1
   
     

   @SCROLL.EXIT:
// @scroll_exit set at this point if [key.escape] or [key.return-not a find]
      [NOT @scroll_EXIT] INDICATE @scroll_EXIT GROUP ANY [KEY.CLEAR KEY.SAVE]
      [NOT @scroll_EXIT] INDICATE @scroll_EXIT AS [KEY.DELETE]
      [NOT @scroll_EXIT] INDICATE @scroll_EXIT GROUP ANY [KEY.USER KEY.USER2]
      [NOT @scroll_EXIT] INDICATE @scroll_EXIT GROUP ANY [KEY.SFIND]
      [NOT @scroll_EXIT] INDICATE @scroll_EXIT GROUP ANY [KEY.PRINT]
   RETURN

   @SCROLL.FIND_LT:
      IF @scroll_COL# LE 2 begin
         FIND LT ccilin by index.1  // <cci_id> <page#> <line#>
// 2019-11-08
//       [Found] If ccilin.cci_id gt gsThis_cci_id Begin
         [Found] If (gfCompareStrings(ccilin.cci_id, gsThis_cci_Id, gsCollate) = "GT") Begin
// 2019-11-08 end
            Clear ccilin
            move  gsThis_cci_id   to ccilin.cci_id
            move  9999            to ccilin.page#
            move  9999            to ccilin.line#
            goto @scroll.find_lt
         end
      end
      IF @scroll_COL# EQ 3 begin
         FIND LT ccilin by index.2  // <cci_id> <b3line_code> <page#> <line#>
// 2019-11-08
//       [Found] If ccilin.cci_id gt gsThis_cci_id Begin
         [Found] If (gfCompareStrings(ccilin.cci_id, gsThis_cci_Id, gsCollate) = "GT") Begin
// 2019-11-08 end
            Clear ccilin
            move  gsThis_cci_id     to ccilin.cci_id
            move  "zz"              to ccilin.b3line_code
            goto @scroll.find_lt
         end
      end
      [found] indicate found as ccilin.cci_id eq gsThis_cci_id
   RETURN

   @SCROLL.FIND_GT:
      IF @scroll_COL# LE 2 begin
         FIND GT ccilin by index.1  // <cci_id> <page#> <line#>
// 2019-11-08
//       [Found] If ccilin.cci_id lt gsThis_cci_id Begin
         [Found] If (gfCompareStrings(ccilin.cci_id, gsThis_cci_Id, gsCollate)= "LT") Begin
// 2019-11-08 end
            Clear ccilin
            move  gsThis_cci_id     to ccilin.cci_id
            move  -9              to ccilin.line#
            goto @scroll.find_gt
         end
      end
      If @scroll_COL# EQ 3 Begin
         FIND GT ccilin by index.2  // <cci_id> <b3line_code> <page#> <line#>
// 2019-11-08
//       [Found] If ccilin.cci_id lt gsThis_cci_id Begin
         [Found] If (gfCompareStrings(ccilin.cci_id, gsThis_cci_Id, gsCollate) = "LT") Begin
// 2019-11-08 end
            clear ccilin
            move  gsThis_cci_id   to ccilin.cci_id
            move  ""              to ccilin.b3line_code
            move  -9              to ccilin.page#
            goto @scroll.find_gt
         end
      end
      [found] indicate found as ccilin.cci_id eq gsThis_cci_id
   RETURN

   @SCROLL.FIND:
      uppercase sl_b3line_code& to sl_b3line_code&
      CLEAR ccilin
      move gsThis_cci_id TO ccilin.cci_id
      IF @scroll_COL# EQ 1 BEGIN
         MOVE sl_page#&   TO ccilin.page#
         FIND GE ccilin by index.1    // <cci_id> <page#> <line#>
      END
      IF @scroll_COL# EQ 2 BEGIN
         MOVE sl_page#&   TO ccilin.page#
         MOVE sl_line#&   TO ccilin.line#
         FIND GE ccilin by index.1    // <cci_id> <page#> <line#>
      END
      IF @scroll_COL# EQ 3 BEGIN
         MOVE sl_b3line_code& TO ccilin.b3line_code
         FIND GE ccilin by index.2    // <cci_id> <b3line_code> <page#> <line#>
      END

      [found] indicate found as ccilin.cci_id eq gsThis_cci_id
      [NOT FOUND] GOSUB @SCROLL.FIND_LT
      [NOT FOUND] CLEAR ccilin
      @scroll_RESET_LIST POSITION ccilin.recnum
   RETURN

   // ------------------------ End of List, Check for Function Key or Escape or Enter ---------
   @SCROLL.End screenLIST  5 5 3 ccilin Index.1
   move windowindex to giWindowindexList  // 04/09/2007
   [KEY.ESCAPE] Goto @end_program                              // <Escape>

   if status ccilin ;
   if ccilin.cci_id ne gsThis_cci_id begin
      @system_problem exit "CCI ID mismatch. Got " ccilin.cci_id ;
                           " instead of "          gsThis_cci_id
   end
   Send pSet_gbUpdateOk giBacf#
   [KEY.Clear] If (gbUpdateOk) Goto ADD_ccilin                   // F9
   [KEY.SFIND] Begin  // F3
       Move (not(gbShowPgaInfo)) to gbShowPgaInfo  // 2019-03-12
       Goto start_list
    End
   [KEY.Print] Begin // F4  if (not(gbCadActive) Only switches between screens 1 and 2
     // giScreen#
     //    1       Normal
     //    2       PGA part 1 if (gbPga)
     //    3       CAD
     //    4       CAD - SIMA
                  Add 1 to giScreen#
                  If (giScreen# > 4) Move 1 to giScreen#
                  // If (not(gbCarmCadActive)) Begin
                  // If (not(gbCadActive)) Begin               // 2023-11-05
                  // 2024-03-29
                  // If ((not(gbCadActive)) or (not(gbIsCad))) Begin // 2023-11-14
                  If ((not(gbCadActive)) or ;
                     ((not(gbIsCad_All)) and (not(gbIsCad_EnterCalc)))) Begin 
                  // 2024-03-29 end  
                      If (giScreen# > 2) Move 1 to giScreen#
                  End
                  Goto start_list
    End

   // Add - Enter from a zero line
   [KEY.RETURN] If (gbUpdateOk) If not STATUS ccilin Begin     // <Enter> From a blank line
      Move 1 to giScreen#
      Goto ADD_CciLin
   End  

   If not STATUS ccilin Goto start_list

   @define String gsParam_LocnRef  // 2017-10-17 JAC gsParam_LocnRef used here and dmShd, dmCci1, dmCcxtSw, SwProcFi and dmCod6fi
   Move ("LINE=" + (trim(String(Ccilin.recnum)))) to gsParam_LocnRef
   
   [KEY.RETURN] Begin                                         // <ENTER> From a non blank line
       If (giScreen# = 2) Begin
           @CALL_PROGRAM "DMCCXTSW" gsParam_LocnRef       
           Goto Start_list
       End
       If (giScreen# = 3) Goto SCREEN_ENTER2_CAD         // 2021-10-07         
       If (giScreen# = 4) Goto SCREEN_ENTER3_SIMA    // 2021-10-07         
       Goto start_enter
   End

   [KEY.Delete] If (gbUpdateOk) Goto DELETE_ccilin            // F6
   [KEY.USER]   If (gbUpdateOk) Goto LINE_ACTIONS             // F7
   [KEY.USER2]  Goto F8_ACTIONS                               // F8

   [KEY.Save] Begin                                           // F10
      If (gbUpdateOk) Begin
         // @ask_ok_to "A-Autorate P-make new Part#  R-update Rating pga info? (A/P/R/N) " "APRXN"
         @ask_ok_to "A-Autorate B-B3line P-make new Part#  R-update RatingPgaInfo? (A/B/P/R/N) " "ABPRXN"
         [not @ok_chr] Goto Start_List
         If (@chr = "A") Goto AutoRate1
         If (@chr = "P") Goto MakeNewPart
         If (@chr = "R") Goto UpdateRatingPgaInfo
         If (@chr = "B") Goto AddBackB3line           // 2025-03-11
      End 
      Else Begin
         @ask_ok_to "A-Autorate P-make new Part#  R-update Rating pga info? (A/P/R/N) " "APRXN"
         [not @ok_chr] Goto Start_List
         If (@chr = "A") Goto AutoRate2
         If (@chr = "P") Goto MakeNewPart
         If (@chr = "R") Goto UpdateRatingPgaInfo
      End
      // 2019-03-26
      @define String gsParam_LocnRef  // 2017-10-17 JAC gsParam_LocnRef used here and dmShd, dmCci1, dmCcxtSw, SwProcFi and dmCod6fi
      Move ("LINE=" + (trim(String(Ccilin.recnum)))) to gsParam_LocnRef

      If (@chr = "X") Begin
         If (giScreen# = 2) @CALL_PROGRAM "DMCCXTS2" gsParam_LocnRef       
         Goto Start_List
      End
     // 2019-03-26 end
   End  // key.save   
Goto start_list


// 2025-03-11
// ----------------------- Add Back B3Line ---------------------------
// ------------------------------------
                          AddBackB3Line:
// ------------------------------------
    String gsAddB3lineCode  
    Integer giAddB3lineBacfnum  
    // 1. Ensure that the ccilin has a b3line code and that the b3line does not exist
    // 1a. Not blank
    Move Ccilin.b3line_code to gsAddB3lineCode
    Move Ccilin.bacf#       to giAddB3lineBacfnum
    If (gsAddB3lineCode = "") Begin
        @errormsg "Cciline has a blank B3LineCode"
        Goto Start_List
    End
    // atc "AddBack Bacf#" giAddB3lineBacfNum 
    // 1b. B3lineCode does not exist
    Clear b3line
    Move giAddB3lineBacfnum to b3line.bacf#
    Move gsAddB3lineCode    to b3line.b3line_code
    Find eq b3line by Index.1  //  <bacf#> <b3line_code>
    [Found] Begin
        @errormsg "Cciline B3line code exists [" gsAddB3LineCode
        Goto Start_List
    End

    // 2. Add new B3Line from ccilin info
    indicate err False
    @lock b3line
    Clear b3line
        Move giAddB3lineBacfnum  to b3line.bacf#
        Move gsAddB3lineCode     to b3line.b3line_code
        Move Ccilin.cci_id       to b3line.cci_id
        Move Ccilin.rating_rec#  to b3line.rating_rec#
        Move Ccilin.rating_item# to b3line.ratitem_item#
        Move Ccilin.tar_treat    to b3line.tar_treat   
        Move Ccilin.vfd          to b3line.vfd_part1     
        Move Ccilin.vfd          to b3line.vfd                   // 2025-03-12 Missed this
        Move Ccilin.ctry_orig    to b3line.ctry_orig     
        Move Ccilin.cello        to b3line.cello         
    SaveRecord b3line
    @unlock b3line
    [err] Begin
       @system_problem exit "AddingBack B3line"
    End

    // 3. Ok message
    @message Wait "Ok. B3line code added [" gsAddB3LineCode "] Bacf[" giAddB3LineBacfnum "]"
Goto Start_List
// 2025-03-11 end

// 2019-03-19
// ----------------------- Update Rating Pga Info ---------------------------
// ------------------------------------
                   UpdateRatingPgaInfo:
// ------------------------------------
Integer gbRatingHasPgaInfo
String  giRatingItem#  gsRP
   @ask_ok_to "Update PGA info on rating Record or Part? (R/P/N) " "RPN"
   [not @ok_chr] Goto Start_List

//Todo: 1    ++++++++++++++++++++++++++++ to do ++++++++++++++++++++++
//Todo: 1    ++++++++++++++++++++++++++++ to do ++++++++++++++++++++++
//Todo: 1    ++++++++++++++++++++++++++++ to do ++++++++++++++++++++++
//Todo: 1    ++++++++++++++++++++++++++++ to do ++++++++++++++++++++++
//Todo: 1    ++++++++++++++++++++++++++++ to do ++++++++++++++++++++++
   Move @chr to gsRP
   If (gsRP = "R") Move 0               to giRatingItem#
   Else            Move sh_rating_item# to giRatingItem#
   
   Get mRatingHasPgaInfo of oRrec_info s_rating_rec# giRatingItem# ;
         to gbRatingHasPgaInfo   // dmlib024.pkg

   If (gbRatingHasPgaInfo) Begin
       If (gsRP = "R")  @message Wait "Warning. Rating RECORD already has PGA info"
       Else             @message Wait "Warning. Rating PART already has PGA info"
       @ask_ok_to "Continue? (C/N) " "CN"
       [not @ok_chr] Goto start_list
   End

   Get Copy_PgaInfo_Ccilin_To_Rating of oXtraSw s_rating_rec# ;   // cXtraSw.pkg
                                                giRatingItem# ;
                                                giBacf# ;
                                                gsRef_Cciln ;
                                                giCcilinRecnum to gsOk255
   If (gsOk255 <> "OK") Begin
       Move (Trim(gsOk255)) to gsOk255
       @errormsg gsOk255
       If (Length(gsOk255) > 70) @errormsg "Part2 - " (mid(gsOk255,80,70))
       Goto Start_List
   End
Goto Start_List

// 2019-03-19
// ----------------------- Make New Part ---------------------------
// ------------------------------------
                            MakeNewPart:
// ------------------------------------
// 1. Get the Part#
   @message "Key in the Part# for the new Part added to Rating Record# " s_rating_rec# " <Esc> Exit"
   keyproc off
   accept snp_orig_new_part#
   keyproc on
   [key.escape] Goto start_list

// 2. Add new Ratitem to Rating with Part# 
   Get CreateNewRatitem of oRrec_info s_rating_rec# snp_orig_new_part# ;
                                      s_desc1 s_desc2 s_desc3 to gsOk255
   If (gsOk255 = "OK") Begin
      Move ratitem.item# to snp_new_rat_item#
      @lock ccilin
      @refresh ccilin
         Move snp_orig_new_part# to ccilin.orig_new_part#
         Move snp_new_rat_item#  to ccilin.new_rat_item# 
      SaveRecord ccilin
      @unlock ccilin
   End
   Else Begin
       @system_problem exit gsOk255
   End

// 3. Copy CcXtraSw to RrXtraSw for new ratitem
   Get Copy_PgaInfo_Ccilin_To_Rating of oXtraSw s_rating_rec# ;   // cXtraSw.pkg
                                                snp_new_rat_item# ;
                                                giBacf# ;
                                                gsRef_Cciln ;
                                                giCcilinRecnum to gsOk255
   If (gsOk255 <> "OK") Begin
       Move (Trim(gsOk255)) to gsOk255
       @errormsg gsOk255
       If (Length(gsOk255) > 70) @errormsg "Part2 - " (mid(gsOk255,80,70))
       Goto Start_List
   End

// 4. Call amriup to allow update of Ratitem   
   @CALL_PROGRAM "AMRIUP" @date 11  // TT 11 is MX   (so what! sigh...)
Goto Start_List


// ---------------------- AutoRate1 code (gbUpdateOk)------------------
// fAutoRateOneLine           ghAutoRate  AutoRate One Line  in amlib132.pkg
// fUpdateRatitemCciLineDesc  ghAutoRate  update Description on part# rating item
// ---------------------
               AutoRate1:
// ---------------------                
        re$ ccilin
        If (ccilin.b3line_code <> "") Begin
// 2015-07-11
//         @ask_ok_to "Cancel existing line code and auto rate the line? (R/N) " "RN"
           If (Ccilin.autorate_method = 1) Begin
               @ask_ok_to "autoRate the line OR update Description on part# rating item? (R/D/N) " "RDN"
           End
           Else Begin
               @ask_ok_to "Cancel existing line code and auto rate the line? (R/N) " "RN"
           End
           [@ok_chr] Begin
               If (@chr = "D") Begin
                   Get fUpdateRatitemCciLineDesc of ghAutoRate Ccilin.Recnum to gbOk
                   If (not(gbOk)) Begin
                       Get psLastErrorMessage of ghAutoRate to gsErrorMessage
                       @errormsg "Failed. " gsErrorMessage
                   End
                   Goto start_list
               End 
               If (@chr = "R") Begin
                   // just carry on down the code below that does autorate
               End
           End
// 2015-07-11 end

// 2015-07-03
//         [not @ok_chr] goto start_list
           [not @ok_chr] Begin
               If (Ccilin.AutoRate_Method <> 0) Begin
                   @message Wait "AutoRate attempted using: Part#[" (trim(ccilin.autorate_part#)) "] then hs [" (trim(ccilin.autorate_hs#)) "]"
               End    
               If (Ccilin.AutoRate_Method = -1) Begin
                   @message Wait "AutoRate FAILED with both: Part#[" (trim(ccilin.autorate_part#)) "] and hs [" (trim(ccilin.autorate_hs#)) "]"
               End
               If (Ccilin.AutoRate_Method = 1) Begin
                   @message Wait "AutoRate worked with Part#[" (trim(ccilin.autorate_part#)) "]"
               End
               If (Ccilin.AutoRate_Method = 2) Begin
                   @message Wait "AutoRate failed with Part#[" (trim(ccilin.autorate_part#)) "] WORKED with line 3 hs [" (trim(ccilin.autorate_hs#)) "]"
               End
               If (Ccilin.AutoRate_Method = 3) Begin
                   @message Wait "AutoRate failed with Part#[" (trim(ccilin.autorate_part#)) "] WORKED with ccilin.hs# [" (trim(ccilin.autorate_hs#)) "]"
               End

               Goto start_list
           End
// 2015-07-03 end
        End

//          ------------------------------
        Get fAutoRateOneLine of ghAutoRate ;          // amlib132.pkg
                             ccilin.cci_id  ccilin.page# ccilin.line# to gbOk
//          ------------------------------
        If (not(gbOk)) Begin
           Get psRate_ErrorType    of ghAutoRate to gsErrorType
           Get pnRate_ErrorNumber  of ghAutoRate to gnErrorNumber
           Get psRate_ErrorMessage of ghAutoRate to gsErrorMessage
           If (gsErrorType = "P") Begin
              @system_problem exit gnErrorNumber " " gsErrorMessage
           End
           Else Begin
              @errormsg gnErrorNumber " " gsErrorMessage
              Goto start_list
           End
        End  //  not ok

// x. refresh screen
        @CHECK_GOSTART Goto end_program
        Move 0 to CURRENT_IMAGE
        @scroll_RESET_LIST POSITION ccilin.recnum
        gosub REFRESH_SCREEN



Goto start_list


// ---------------------- AutoRate2 code (not(gbUpdateOk))------------------
// fUpdateRatitemCciLineDesc    of ghAutoRate     update Part# rating item CCI description from this cci line
// fCopyRatitemNewPart#         of ghAutoRate     Add Ratitem Item for this Part#
// ---------------------
               AutoRate2:
// ---------------------                
       If (Ccilin.AutoRate_Method <> 0) Begin
// 2015-07-11
String gsUsePartNum 
           If (gbRateSupervisor) Begin
               If (Ccilin.autorate_method = 1) Begin  // Part# rating worked, so it must be there
                   @ask_ok_to "update Part# Rating Item CCI Description from this CCI Line? (D/N) " "DN"
                   [@ok_chr] Begin
                       Get fUpdateRatitemCciLineDesc of ghAutoRate Ccilin.Recnum to gbOk
                       If (not(gbOk)) Begin
                           Get psLastErrorMessage of ghAutoRate to gsErrorMessage
                           @errormsg "Failed. " gsErrorMessage
                       End
                       Goto start_list
                   End 
               End  // Part# worked
               Else Begin
                   If (Ccilin.autorate_part# <> "") Move (Trim(Ccilin.autorate_part#)) to gsUsePartNum
                   Else                             Move (Trim(Ccilin.part#))          to gsUsePartNum
                   Move (Code49(desktop,gsUsePartNum)) to gsUsePartNum  // special for Finning
                   @ask_ok_to ("Add Rating Item for this Part# [" + gsUsePartNum + "]?(A/N) ") "AN"
                   [@ok_chr] Begin
                       Get fCopyRatitemNewPart# of ghAutoRate gsUsePartNum ;    //+++++++++++++++++++ Note this one +++++++++++++++++
                                                              opcust.recnum ;
                                                              ccilin.Rating_Rec# ;
                                                              ccilin.Rating_Item# ;
                                                              Ccilin.Desc1 ;
                                                              Ccilin.Desc2 ;
                                                              Ccilin.Desc3 to gbOk
                       If (not(gbOk)) Begin
                           Get psLastErrorMessage of ghAutoRate to gsErrorMessage
                           @errormsg "Failed. " gsErrorMessage
                       End
                       Goto start_list
                   End
               End
           End
           Else Begin
// 2015-07-11 end
              @message Wait "AutoRate attempted using: Part#[" (trim(ccilin.autorate_part#)) "] then hs [" (trim(ccilin.autorate_hs#)) "]"
        
              If (Ccilin.AutoRate_Method = -1) Begin
                  @message Wait "AutoRate FAILED with both: Part#[" (trim(ccilin.autorate_part#)) "] and hs [" (trim(ccilin.autorate_hs#)) "]"
              End
              If (Ccilin.AutoRate_Method = 1) Begin
                  @message Wait "AutoRate worked with Part#[" (trim(ccilin.autorate_part#)) "]"
              End
              If (Ccilin.AutoRate_Method = 2) Begin
                  @message Wait "AutoRate failed with Part#[" (trim(ccilin.autorate_part#)) "] WORKED hs[" (trim(ccilin.autorate_hs#)) "]"
              End
              If (Ccilin.AutoRate_Method = 3) Begin
                  @message Wait "AutoRate failed with Part#[" (trim(ccilin.autorate_part#)) "] WORKED hs[" (trim(ccilin.autorate_hs#)) "]"
              End
           End
       End
       Else Begin
           @errormsg "Updates not allowed. AutoRate not done."
       End
Goto start_list
//END: AutoRate2
//========================> Enter for Add/Update <============================
start_enter:
// if giScreen# eq 2 goto start_enter2
// if giScreen# eq 3 goto start_ENTER3 
// If giScreen# eq 4 Goto start_list      // Hidden  (only if user is ACCORD)
   move 1 to giScreen#  // just in case

 
#IFDEF TitleMarkerNeverTrue
Property String start_enter1
#ENDIF
 
//========================> Enter1 for Add/Update <============================
start_enter1:

// -----------------------------------------
// 1. Get PGA PRODuct info from f#133 ccxtra
// -----------------------------------------

//++    gcGET_CCXTRA_PROD   // amlib085.pkg   (AREG TVIN and PROD)
//++                        // PRODuct info (make, model, size, brandname)


// ------------------------------
// 2. Warehouse out - copy option
// ------------------------------

// 07/20/1997
// Copy info from whitem, updating ccilin and creating b3line
// Popup Warehouse Info Screen if:
//   . not rating finished
//   . giWarehouse
//   . ccship.wh_prev_whbacf# is not 0
//   . ccilin.amount and acr_quan are both zero
   am_SET_WAREHOUSE b3main.f1_type
   IF (giWarehouse) ;
   IF bacfstat.status_op LT 10 begin
      If ccship.wh_prev_whbacf# NE 0 Begin
         if (ccilin.acr_quan eq 0 AND ccilin.amount eq 0) begin
            @CALL_PROGRAM_EXPORT_ONLY "AMCCILWH"

            re$ ccilin
            re$ ccimas
            re$ ccship

            GOSUB REFRESH_FILES_SCREEN

         end
      end
   end
// 07/20/1997 end
// --------------
// 3. ENTER start
// --------------

   move giFalse to iOk_upd_b3desc
   string sFlag_msg
   move ;
"Leave blank to use defaults. M-manually enter % or amount. N-none (all zero)";
      to  sFlag_msg
   @SCREENMODE @colour_HI OFF
// PAGE_HELP screenHELPenter

   @ENTER_SCROLL ccilin
//    KEYPROC KEY.USER  GOSUB ACTION_MENU
//    @scroll_SET_LINEINDEX    // If using screenLIST for enter
      KEYPROC KEY.UP        GOSUB return_start_enter11
      KEYPROC KEY.SFIND     GOSUB POPUP
//    KEYPROC KEY.PREVIOUS  GOSUB KEY_PREV
//    KEYPROC KEY.NEXT      GOSUB KEY_NEXT
      KEYPROC KEY.USER2     GOSUB UPDATE_B3DESC
      KEYPROC KEY.CALCULATE GOSUB OUTPUT_PGASCN 
      GOSUB ENTER.POSTFIND

//    INDICATE ENT$PERMISSIVE TRUE  // in enter; allows find/prev/next on
             // parent fields to change parent records, (not doing a superfind)
             // dangerous in master txn relationships with $ involved.

// -----------------------------------------
// 3.1 mInitialize_from_ccilin                              DmLib024.pkg  
//        Sets psPGA stuff in oRrec_info.obj
// -----------------------------------------

      Send mInitialize_from_ccilin to oRrec_info.obj
      Move ccilin.b3line_code      to gsPrev_b3lc
      
      Move Ccilin.rating_rec#      to giPrev_RatingRecnum //-+- 2020-12-12
      Move Ccilin.rating_item#     to giPrev_RatitemNum   //-+- 2020-12-12
      Move Ccilin.pgaQa_list       to gsPgaQaList         //-+- 2020-12-12

start_enter11:
         @EMESSAGE " "
         [@NEW_RECORD] BEGIN
            @system_problem exit "Should never get here as a new record."
            // If it is a new line, it has been created and giNewline_Added is true
         END
// ---------------
// 3.2 Skip to PGA
// ---------------
   Page screenENTER     // 2018-12-06
// 2019-03-12
   Move (True) to gbShowPgaInfo
   If (gbShowPgaInfo) Begin
      //Send gmDisplay_Pga1Info s_pgapgm_list //Program list with description of Programs
      //Send gmDisplay_Pga2Info gsPgaQaList //Q&A     list with description of Questions and Answers      
      Send DisplayPga1Info to oPgaInfo.obj s_pgapgm_list //Program list with description of Programs 2025-05-02 KRC 
      Send DisplayPga2Info to oPgaInfo.obj gsPgaQaList //Q&A list with description of Questions and Answers 2025-05-02 KRC 
   End
   Else Begin
       Page screenENTER1
       Page screenENTER2
   End
// 2019-03-12 end
   SHOW_PGA  // 2024-03-13
// ----------------
// 3.3 Normal Stuff
// ----------------

         @emessage ;
"Page# for Cadex cross reference. Auto reassigned from CCI's starting page#"
      [NOT im_AUTO_PAGE#] ENTRY ccilin.page#         s_page#
         @emessage "Line# for Cadex cross reference."
      [NOT im_AUTO_PAGE#] if s_page# ne ccilin.page# begin
         if s_page# gt ccimas.max_page# ;
            move 1 to s_line#
      end
      [NOT im_AUTO_PAGE#] ENTRY ccilin.line#         s_line# {forceput}
      ENTRY ccilin.cci_id        s_cci_id        {displayonly}

scn_code:
      // 2024-03-29 
      // If ((gbIsCaD) and (giNewline_Added)) Move ""  to s_b3line_code // 2023-05-30
      If ((gbIsCad_All) and (giNewline_Added)) Move ""  to s_b3line_code
      // 2024-03-29 end
      String gsOldB3lineCode                  // 2023-05-30
      Move s_b3line_code to gsOldB3lineCode   // 2023-05-30
      if s_b3line_code eq "" begin
         @EMESSAGE ;
    "If you know the B3 line code enter it. Otherwise leave it blank. <F3> List"
      end
      else begin
         @EMESSAGE ;
        "Hit enter to keep same code, type a new or existing one, or <F3> List"
      end
     //2013-06-22
     //    ENTRY ccilin.B3LINE_CODE   s_B3LINE_CODE   {capslock, forceput}
     //    ENTRY ccilin.B3LINE_CODE   s_B3LINE_CODE   {forceput}

      ENTRY ccilin.B3LINE_CODE   s_B3LINE_CODE   {capslock, forceput}  
      // at3 "[dmccil1.src AFter ENTRY s_b3line_code] s_vfd is [" s_vfd "]"
      // 2024-03-29
      // If ((gbIsCaD) and (not(giNewline_Added))) Move gsOldB3lineCode to s_b3line_code // 2023-05-30
      // If ((gbIsCaD) and (giNewline_Added))      Move ""              to s_b3line_code // 2023-05-30
      // 2024-09-25
      // If ((gbIsCad_All) and (not(giNewline_Added))) Move gsOldB3lineCode to s_b3line_code // 2023-05-30
      If ((gbIsCad_All) and (not(giNewline_Added)) and s_b3line_code <> "") ;
          Move gsOldB3lineCode to s_b3line_code 
      
      // 2024-09-25 end
      If ((gbIsCad_All) and (giNewline_Added)) ;
          Move ""              to s_b3line_code // 2023-05-30
      // 2024-03-29 end
       // decided it was less stressful all around to put it back.
      // This means you cannot manually choose a b3line code with LowerCase
      // 2013-06-22 end

      // 2024-11-01 end
      //++++++++++++++++If ((gbIsCad_All) and (giNewline_Added))      Move ""              to s_b3line_code // 2023-05-30
      // 2024-11-01 end
 


      Move (False) to gbNewB3lineCode           // 2018-06-25
      Move giFalse to giDisplay_rrec_pga_done   // 10/04/1998
      // send gmExit_b3line_code to desktop
      send gmSet_b3lc_status to desktop  // gets b3line & sets status
      //  ----------------------------
      //    giTyp_b3lc CHG   CODE
      //          1.   No    Blank
      //          2.   No    Existing         display main from b3lc
      //          3.   Yes   Blank
      //          4.   Yes   New
      //          5.   Yes   Existing         display main from b3lc
      //    giBad_b3lc  2/5.   if from another cci
      //  ----------------------------

      // at3 "[After ENTRY] giTyp_b3lc [" giTyp_b3lc "]"
      If  giTyp_b3lc eq 5 Begin  // Code has changed and we are using an existing code
                                 // This happens:
                                 //    on a  new      ccilin where we pick an existing B3line code
                                 // or on an existing ccilin where we change the code
           // 2018-04-05
           If (b3line.pga_auto <> "") Begin    //Todo: Why blank Y or N or ??
              Move b3line.pga_auto     to s_pga_auto
              Move b3line.pgaPgm_List  to s_pgaPgm_List                    
              Move b3line.sima         to s_sima 
           End
           SHOW_PGA   //  sets HI and LO  for s_pga_auto, s_pgaQa_List, s_pgapgm_list, s_sima
           // 2018-04-05 end
      End
      // Changes - new or existing. 
      //         . set desc123 from ratitem/rating
      if ( (giTyp_b3lc = 4) or (giTyp_b3lc = 5)) begin  // chg to new or existing
         send gpSet_ccilin_gsDesc123 to desktop b3line.rating_rec# b3line.ratitem_item#
         move gsDesc1 to s_desc1
         move gsDesc2 to s_desc2
         move gsDesc3 to s_desc3
      end
      // Using existing line code
      if (giTyp_b3lc eq 5 or giTyp_b3lc eq 2) begin     // use existing line code
         move s_b3line_code        to gsPrev_b3lc
         send gmDisplay_b3lc_main     // on the main entry screen   Dmccil1.pkg
         send gmDisplay_b3lc_addl     // screen under the list
         Goto skip_b3line_info
      end
      // Bad code
      if (giBad_b3lc) begin   // bad
         [not @enter_entskip] begin
            @errormsg# 8001 ;
                  "This Line code is used by another CCI on this BACF"
         end
      end
      // Highlight fields to enter
      // at3 "[After ENTRY Before gmDisplay_b3lc_main]"
      Send gmDisplay_b3lc_main  // highlights the fields to enter
      // at3 "[After ENTRY After gmDisplay_b3lc_main]"
      @emessage ""
      // somehow the ctry origin on b3line is blank on the 1st one so we force
      // it here - ccds does it too, but ...
      if s_ctry_orig eq "" ;
         Move ccimas.dcr_ctry_origin to s_ctry_orig   // ccimas main ctry_orig, never blank
                                          [key.down] Goto scn_new
scn_part#:
            @emessage ;
      "<F3> List of Rating Record Part#'s or Descriptions of Goods."
      If (giNewline_added) Move "" to sop_orig_new_part#
      ENTRY ccilin.PART#         s_PART#         {capslock, forceput}
      If ((giNewline_added) and ; 
          (sop_orig_new_part# = ""))   Move s_Part# to sop_orig_new_part# // 2019-06-26
            
            Send gmExit_part#        to desktop s_part#  20
              // 20 is the length of the screen field
                                              [key.down] Goto scn_new
            @emessage "<F3> List of Rating Records."
      ENTRY ccilin.RATING_REC#   s_RATING_REC#              {forceput}
            send gmExit_rating_rec#  to desktop s_rating_rec# sh_rating_item#
                                              [key.down] goto scn_new

            // 2024-01-24
            Integer gbRestricted_Ok   
            Get Restricted_Opcust_Ok   to gbRestricted_Ok  // in dmccil1.pkg 
            If (not(gbRestricted_Ok)) Begin
               @errormsg "Opcust is restricted on this rating record. Not allowed to use. "
               Goto scn_part#
            End
            Get Restricted_Exporter_Ok   to gbRestricted_Ok
            If (not(gbRestricted_Ok)) Begin
               @errormsg "Exporter is restricted on this rating record / Part#. Not allowed to use. "
               Goto scn_part#
            End
            // 2024-01-24 end

//------------------------------------------------------------------------
//   Notes on gmExit_[part#/rating_rec#] (in Dmccil1.pkg)
//    . Class cRrec_info is in DmLib024.pkg
//                       auto part# code
//                       popup amra1
//                       upon exit from popup, what is done
//                       internal table of current rrec ritem values
//    . dmccil1.pkg      has all the functions and procedures normally in .src
//                       declares Object oRrec_info
//    
//    Exit routines:
//            . decides to popup list or not or autoget part#
//            . if new rrec, gets values into properties of Object
//            . if something has changed, displays rrec info to screen fields.


scn_tt:
            @emessage "<F3> List of Tariff Treatments."
      ENTRY ccilin.TAR_TREAT     s_TAR_TREAT
            trim s_tar_treat to s_tar_treat
            if s_tar_treat ne "" begin
               move (gmTT_descrip(desktop, s_tar_treat)) to sh_tt_descrip // cc.pkg
               [not @enter_entskip] if (not(giGotit)) begin
                 @errormsg# 8006 "Tariff Treatment is invalid."
                 goto scn_tt
               end
            end
                                              [key.down] goto scn_new
scn_ctry_orig:
            @emessage "<F3> List of Valid Countries of Origin."
      ENTRY ccilin.CTRY_ORIG     s_CTRY_ORIG     {capslock, forceput}
            if s_ctry_orig ne "" begin
               move (gmCountry_quikname(desktop, s_ctry_orig)) to ;
                                                          sh_ctry_orig_descrip
               [not @enter_entskip] if (not(giGotit)) begin
                  @errormsg# 8008 "Country of Origin code is invalid."
                  goto scn_ctry_orig
               end
            end
                                              [key.down] goto scn_new


scn_vfd:
            @emessage "Value For Duty code.  1 or 2 then 3 4 5 6 7 8 or 9"
      ENTRY ccilin.VFD           s_VFD           {forceput}
            if s_vfd ne "" begin
               move (gmVFD_ok(desktop, s_vfd)) to sh_vfd_descrip // cc.pkg
               [not @enter_entskip] if (not(giGotit)) begin
                  @errormsg# 8007 "Value For Duty code is invalid."
                  goto scn_vfd
               end
            end
                                              [key.down] goto scn_new
            @emessage "Y - Grocery in Cello packages."
      ENTRY ccilin.CELLO         s_CELLO     {capslock,check="YN "}

      Entry ccilin.autorate_method  s_autorate_method  {displayonly}    // 2015-07-03

          // Big Tip: Never goto past this label. We always want to do this code.
scn_new:
          // Big Tip: Never goto past this label. We always want to do this code.
          
          // This is kindof a big step
          // Here we make sure that we got a line code that goes with what's on the
          // screen.
          // If we got one they can still override and say we want a new one.
          // Why? Cause there may be some other fields on b3line they want to be
          //      different, like override annex.
          // Dont want to be able to back up to this field,
          //      Why? cause we want to make sure we have always just done gmSet_match_b3lc
          //      So, we have an indicator that prevents it

          send gmSet_match_b3lc to desktop
          // Show description of match results
          send gmShow_match_b3lc to desktop

          if gsMatch_b3lc eq "" move "Y" to s_force_new_b3lc
          Else                  Move "N" to s_force_new_b3lc
          
          // 2024-03-29
          // If (gbIsCaD) Move "Y" to s_force_new_b3lc  // 2023-05-30
          If ((gbIsCad_All) or (gbIsCad_EnterCalc)) Begin
                Move "Y" to s_force_new_b3lc
          End
          // 2024-03-29 end
      
      integer giForceOk
      move (true) to giForceOK
         @emessage "Y - Forces a new B3 line code."
      If (giForceOk) ;
      ENTRY ccilin.FORCE_NEW_B3LC s_FORCE_NEW_B3LC {capslock,noput,check="YN"}
          // 2024-03-29          
          If ((gbIsCad_All) or (gbIsCad_EnterCalc)) Begin
             Move "Y" to s_force_new_b3lc
          End
          // 2024-03-29 end
           
         
         Move (False) to giForceOK
         // 01/31/2005 emd
          [@ENTER_ENTSKIP] begin // they hit save, no errors, just do it right
             if s_force_new_b3lc eq "N" ;
             if gsMatch_b3lc     eq ""  move "Y" to s_force_new_b3lc
          end
          if s_force_new_b3lc eq "N" ;
          if gsMatch_b3lc     eq ""  begin
             @errormsg ;
                  "Can't find existing b3line code that matches. Try again."
             goto scn_code
          end
            
          // 06/02/1997
          If s_force_new_b3lc eq "Y" ; 
          if (giWH_need_prev_txn#) begin
             PAGE screenPREVTXN#
             if spt_prev_txn# eq "" ;
                move ccship.wh_prev_tran_p2 to spt_prev_txn#
             ACCEPT spt_prev_txn#
             ACCEPT spt_prev_line#
          End // 06/02/1997 END

          Move (s_force_new_b3lc = "Y") to gbNewB3lineCode  // 2018-06-25
          If s_force_new_b3lc eq "Y" Send gmCreate_new_b3lc to desktop     // in dmccil1.pkg
          else                       send gmUse_match_b3lc  to desktop // empty


//-----------------------------------------------------------------------------
//    At this point:
//          1. we got the right b3line record in record buffer
//    If rating rec# is blank we still have a line code
//-----------------------------------------------------------------------------
skip_b3line_info:

   If not status b3line Begin
      @system_problem exit "No b3line record - Huh? BACF# " giBacf#
   end
   if b3line.bacf# ne giBacf# begin
      @system_problem exit "b3line is for BACF " b3line.bacf# ;
                           " s/b for " giBacf#
   end
   if s_b3line_code ne b3line.b3line_code ;
      move b3line.b3line_code to s_b3line_code

   move b3line.b3line_code to gsMatch_b3lc

   // 2018-04-15
   If ((s_force_new_b3lc = "Y") or (s_pga_auto = "Y")) Begin
      Move b3line.pgapgm_list  to s_pgapgm_list             
      Move b3line.sima         to s_sima
   End //+ 2018-04-15 End   
   Send gmShow_match_b3lc
   Send gmDisplay_b3lc_uom_quan // the stuff from b3line

   //---------------------------------------------------------------------
   //   PGA Info from rating record / rating item
   //            b3line.rating_recnum   b3line.ratitem_item#
   //       We got here in two ways:
   //          1. Entering a line code and going direct to here
   //                 (add, just enter line code or an update)
   //          2. Add, picking a rating record
   //       For 1. Add we want to display the info from the rating record / item
   //         
   //---------------------------------------------------------------------

   //---------------------------------------------------------------------
   //   PGA Info
   //               Auto Flag
   //               Auto-N then up to 4 groups and pgalist and sima
   //---------------------------------------------------------------------

   //-+- 2020-12-12
   // ------------------------------------------
   //         Q&A Question and Answer Info  (s_pgaQa_List)
   //             Either Set if from Rating/ratitem.pgaQa_List 
   //             of leave it alone
   // ------------------------------------------
   // Set gsPgaQaList and s_pgaQa_list
   // New rules: 
   //   SetPgaQaList integer iRrecNum integer iPartNum returns string in dmCcil1.pkg
   //   If only one of rating.PgaQa_List and ratitem.PgaQa_List is blank, use the non-blank one
   //   If both are non-blank, use Ratitem.PgaQa_List if it has at least one question answered. 
   //                                                 otherwise use rating.PgaQa_List
   // When to call SetPgaQaList  
   //   .1. If adding a new cci line (giNewline_added is true)
   //   .2. If not adding, only if Rrec or Ratitem has changed

   //                 Previously set to on ccilin         New value from screen
   //  Rating recnum    giPrev_RatingRecnum                s_rating_rec#
   //  Ratitem item#    giPrev_RatitemNum                  sh_Rating_Item#
   //   
   //   
   //   
   // gsPgaQaList set to ccilin.pgaQa_List at start of enter
   // In some cases described above we set it from RatingRec Ratitem PgaQa_List
   If (giNewline_added) Get SetPgaQaList of desktop s_rating_rec# sh_Rating_Item# to gsPgaQaList
   Else Begin
      If ((s_rating_rec#   <> giPrev_RatingRecnum) or ;
         (sh_rating_Item# <> giPrev_RatitemNum)) Begin
         Get SetPgaQaList of desktop s_rating_rec# sh_Rating_Item# to gsPgaQaList
      End
   End
   Move gsPgaQaList to s_pgaQa_List 

   SET_PGA_SCREEN   // from screen field s_...  calls gmSet_gbPga in dmlib086 with s_pga_pgm_list
   SHOW_PGA
   //Send gmDisplay_Pga1Info s_pgapgm_list   // 2019-03-12
   //Send gmDisplay_Pga2Info gsPgaQaList
   Send DisplayPga1Info to oPgaInfo.obj s_pgapgm_list //Program list with description of Programs 2025-05-02 KRC Rename Functions
   Send DisplayPga2Info to oPgaInfo.obj gsPgaQaList //Q&A list with description of Questions and Answers 2025-05-02 KRC 
   // s_pga_auto Auto       
   @emessage2 ("     Pgm/Sima Auto: Y-PgaPgmList/Sima Info From PgaHS tables based on Q&A      " + ;
               "                    N-Pgm List and Sima keyed manually.                        ")
              
   //ENTRY ccilin.ogd_group_auto  s_pga_auto {capslock, check="YN"}
    //   Indicate Iid_Release as (gbGotBacfIid)  // 2024-03-13
    //   [Iid_Release] Begin
    //      ENTRY ccilin.ogd_group_auto  s_pga_auto {capslock, check="YN "} //  2024-03-15      
    //   End   
   //2025-05-02 KRC Force Y/N. Also Enable for non IID Releases Again. Due to SIMA/Surtax.
   ENTRY ccilin.ogd_group_auto  s_pga_auto {capslock, check="YN"} //  2024-03-15                
   
   SHOW_PGA
   Indicate Auto_N as s_pga_auto eq "N"

   //Debug
    //   [Iid_Release] Begin
    //      At4 "[dmccil1] Iid_Release true"     
    //   End    
    //   [not Iid_Release] Begin
    //      At4 "[dmccil1] Iid_Release false"
    //   End
    //    
    //   If (gbGotBacfIid) Begin
    //      Indicate Iid_Release True
    //   End 
    //   Else Begin
    //      Indicate Iid_Release False   
    //   End
    //   [    Iid_Release] At4 "[dmccil1] Iid_Release2 true"     
    //   [not Iid_Release] At4 "[dmccil1] Iid_Release2 false"     
   //End Debug
     
   //Send gmDisplay_Pga1Info s_pgapgm_list   // Pga Program list with descriptions
   //Send gmDisplay_Pga2Info gsPgaQaList     // Pga Q&S     list with descriptions
   Send DisplayPga1Info to oPgaInfo.obj s_pgapgm_list //Program list with description of Programs 2025-05-02 KRC 
   Send DisplayPga2Info to oPgaInfo.obj gsPgaQaList //Q&A list with description of Questions and Answers 2025-05-02 KRC 

    [Auto_N]                                     [key.down] Goto scn_desc1  

// If auto, no entry allowed
// =====================================================
//                       PGA Info
// =====================================================
//       Pga_Auto is Y
//                     .1. Generate PgaPgm_List_BeforeQA
//                     .2. Ensure PgaQA contains all questions
//                     .3. Ensure all Questions have answers and Q/A valid
//                     .4. Generate PgaPgm_List                   
//       Pga_Auto is N
//                     .1. 
//                     .2.                                      
//                     .3. Ensure all Questions have answers and Q/A valid
//                     .4.                           
// -----------------------------------------
// 1. (Auto_Y) Generate PgaPgm_List_BeforeQA
// -----------------------------------------
//       Get HS code
      If (s_pga_auto = "Y") Begin
//         Move (scd_ovr_hs_code1 + scd_ovr_hs_code2 + ;
//               scd_ovr_hs_code3 + scd_ovr_hs_code4) to gsHsNodots

//       If (gsHsNoDots = "") Begin
// Ok, get it from s_rating_rec#
         If (rating.recnum = s_rating_rec#) Move rating.hs_code14 to gsHsNoDots
         Else Begin
            Clear rating
            Move s_rating_rec# to rating.recnum
            Find eq rating.recnum
            If (Found) Move rating.hs_code14 to gsHsNoDots
            Else Begin
               @system_problem exit "HS code is blank and rating rec not found"     
            End
         End
//       End
         Get gfInitialize2 of oSwInfo gsHsNoDots @date ;
                                       s_ctry_orig ccimas.dcr_ctry_export to gsOk  
         If (gsOk <> "OK") Begin
             @system_problem exit "Error from gfInitialize2 " gsOk
         End
   
         Get psPgaPgmList of oSwInfo to gsPgaPgmList_Before
// 2020-04-30
//       @message "Pgms Before QA " gsPgaPgmList_Before
         @message2 "Pgms Before QA " gsPgaPgmList_Before
// 2020-04-30 end
// -------------------------------------------------         
// 2. (Auto_Y) Ensure PgaQA contains all questions
// -------------------------------------------------
//               For now, if s_pgaqa_list is blank set it from 
//       If (s_pgaQa_list = "") Begin
         If (gsPgaQaList = "") Begin   // 2020-04-30
//          Get gfGenerateQuestionList to oPgaInfo.obj gsHsDots @date ;
//                                    s_ctry_orig ccimas.dcr_ctry_export to gsOk  
            Get gfGenerateQuestionList of oSwInfo to gsOk  
             If (gsOk <> "OK") Begin
                @system_problem exit "Error from gfGenerateQuestionList " gsOk
            End
            Get psPgaQaList       of oSwInfo to gsPgaQaList
            Get psPgaQaStatus     of oSwInfo to gsPgaQaStatus
            Get psPgaQaStatus_msg of oSwInfo to gsPgaQaStatus_Msg
            Move gsPgaQaList                  to s_pgaQa_list
            Move gsPgaQaStatus                to s_pgaQa_status
         End
      End  // If (s_pga_auto = "Y") Begin
    //Send gmDisplay_Pga1Info s_pgapgm_list   // 2019-03-12
    Send DisplayPga1Info to oPgaInfo.obj s_pgapgm_list //Program list with description of Programs 2025-05-02 KRC 

// ----------------------------
// 3. (All) - PGA Question list
// ----------------------------
more_s_pgaqa_list:
//    Send gmDisplay_Pga2Info s_pgaqa_list    
      //Send gmDisplay_Pga2Info gsPgaQaList   // 2020-04-30      
      Send DisplayPga2Info to oPgaInfo.obj gsPgaQaList //Q&A list with description of Questions and Answers 2025-05-02 KRC 
      // 2024-03-13
      // ACCEPT s_pgaqa_list {capslock}    // ignored, do F3 instead
      //If (gbGotBacfIid) ACCEPT s_pgaqa_list {capslock}    // ignored, do F3 instead
      ACCEPT s_pgaqa_list {capslock}    // 2025-05-02 KRC Allow for non IID shipments (Sima/Surtax)
      // 2024-03-13 end
// 2020-04-30
//    Send gmDisplay_Pga2Info s_pgaqa_list    
      Move gsPgaQaList to s_pgaqa_list       
      //Send gmDisplay_Pga2Info gsPgaQaList 
      Send DisplayPga2Info to oPgaInfo.obj gsPgaQaList //Q&A list with description of Questions and Answers 2025-05-02 KRC 
// 2020-04-30 end      

// 3.1 Generate PgaQA (internal) from QAList
//    Send gpGeneratePgaQA_FromQAList to oSwInfo s_pgaqa_list
      Send gpGeneratePgaQA_FromQAList to oSwInfo gsPgaQaList   // 2020-04-30
      Move pgm_qa_all_answered                 to s_pgaqa_status

// 3.2 Ensure all Questions have answers and Q/A valid 
//    Get gfVerifyQAList of oSwInfo s_pgaqa_list to gsOk
      Get gfVerifyQAList of oSwInfo gsPgaQaList to gsOk
      Get psPgaQaStatus     of oSwInfo to s_pgaqa_status    
      Get psPgaQaStatus_Msg of oSwInfo to gsPgaQaStatus_Msg
      If ((s_pgaqa_status <> "Y") and (s_pgaqa_status <> "")) Begin
          @errormsg gsPgaQaStatus_msg
          If (Length(gsPgaQaStatus_Msg) > 70) Begin
             @errormsg (mid(gsPgaQaStatus_msg, 100, 71))
          End
          Goto more_s_pgaqa_list
      End

// --------------------------------
// 4A. (Auto_Y) Generate PgaPgm_List
// --------------------------------                   
      If (s_pga_auto = "Y") Begin
         Get gfGeneratePgmList_AfterQA of oSwInfo to gsOk     // cSwInfo.pkg
         // Input is cod1_a1_q1
         If (gsOk <> "OK") Begin
             @errormsg "Error from gfGeneratePgmList_AfterQA " gsOk
             Move "Error generating PgmList After QA" to s_pgaPgm_list
             Goto more_s_pgaqa_list
         End
         Else Begin
             Move pgm_list to s_pgaPgm_list
             Move pgm_sima to s_sima
         End
//++++   Send gpOutputPgaScn "" "1"
         SHOW_PGA   //  sets HI LO on LPCO: LO if no pgm
      End  // If (s_pga_auto = "Y") Begin

// --------------------------------
// 4B. (Auto_N) Generate PgaPgm_List
// --------------------------------                   
    //Send gmDisplay_Pga1Info s_pgapgm_list   // 2019-03-12
    Send DisplayPga1Info to oPgaInfo.obj s_pgapgm_list //Program list with description of Programs 2025-05-02 KRC 

    @emessage "PGA Program List. eg 13TIRES|12BLOOD|1CFIA|SIMA27"
    // 2024-03-13 JAC Based on Iid_Release      
    // [Auto_N] ENTRY ccilin.pgapgm_list s_pgapgm_list {capslock}
    // 2025-05-02 KRC Revert to General
    //[Auto_N] [Iid_Release]     ENTRY ccilin.pgapgm_list s_pgapgm_list {capslock}
    //[Auto_N] [not Iid_Release] ENTRY ccilin.pgapgm_list s_pgapgm_list {displayonly} // 2024-03-13 end      
    [Auto_N] ENTRY ccilin.pgapgm_list s_pgapgm_list {capslock} //2025-05-02 END
    [Auto_N] SHOW_PGA
    //Send gmDisplay_Pga1Info s_pgapgm_list   // 2019-03-12
    Send DisplayPga1Info to oPgaInfo.obj s_pgapgm_list //Program list with description of Programs 2025-05-02 KRC 

    @emessage "SIMA. Y-subject to SIMA"
    //[not Iid_Release] If (s_sima = "") Move "N" to s_sima   // 2024-03-13 //KRC Knockout 2025-05-02
    [Auto_N] ENTRY ccilin.sima s_sima {capslock, check="YN ", forceput}
//+2018-04-04 End


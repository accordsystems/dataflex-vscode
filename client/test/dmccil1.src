//=============================> Procedures <====================

Function NewB3LineCode Returns String
    // Called by CALL_PROGRAM_COPY_LINE
    Local String  sNewB3LineCode
    Local String  sOldB3LineCode
    Local Integer iBacfNum
    // For F7-Copy when gbIsCad_All is true
    Move B3line.Bacf#        to iBacfNum
    Move b3line.B3line_Code  to sOldB3LineCode
    // 2025-02-21
    // Get gmNext_b3lc iBacfNum to sNewB3LineCode  // in dmCciL1.pkg
    Send gpStartTimer
    // 2025-02-24
    // Get gmNext_b3lc_v2 iBacfNum to sNewB3LineCode  // in dmCciL1x.pkg // 2025-02-21
    Get gfNextB3LineCode iBacfNum to sNewB3LineCode  // in sylib014.pkg in new.cmd in global.cmd
    // 2025-02-24 end

    Send gpStopTimer
    // @message Wait "Elapsed seconds [" giElapsedSeconds "]" 
    If sNewB3LineCode eq "??" Begin
        //@system_problem exit "Auto assign3 B3LC at max, Bacf#" giBacf# 
        @system_problem exit "Auto assign3 B3LC at max, Bacf#" giBacf# "]finds[" giCountFinds "]"
     End    
    // 2025-02-21 end 
    // Get back current b3line
    Clear b3line
    Move iBacfNum       to b3line.bacf#
    Move sOldB3LineCode to b3line.b3line_code
    Find eq b3line by Index.1  // <bacf#> <b3line
    [not Found] Begin
        @system_problem exit "F7-Copy error refinding b3line code [" sOldB3lineCode "]"
    End
    // Add new b3line with new b3line code
    indicate err False
    @lock b3line
    re$   b3line
       Move 0              to b3line.recnum   // creates a new identical record
       Move sNewB3LineCode to b3line.b3line_code
    SaveRecord b3line
    @unlock b3line
    [err] Begin
        @system_problem exit "F7-Copy error adding new b3line."
    End        
    Function_Return sNewB3LineCode
End_Function // 2024-02-21 end

// 2024-02-14
Procedure UpdateB3line_From_CadInfo 
    If ((not(gbIsCad_All)) and (not(gbIsCad_EnterCalc))) Procedure_Return   // 2025-03-05        
    Send CheckSet_B3line_Matches_Ccilin_Ccship "CadInfo"   //+ 2024-10-24    
    @lock b3line
    re$   b3line
        // 2024-03-01 ccilin.overide_annex is now being set from rating.annex_code  the rating record
        //            Even though b3line.Annex_Code is designed as a code that overrides what is on the rating record
        //            allow it to be set even though it is the same as the rating record rating.annex_code. 
        //            Might rename ccilin.override_annex to ccilin.annex_code
        If (Ccilin.Override_Annex <> "") Move Ccilin.Override_Annex to b3line.Annex_Code
        If (Ccilin.Override_Hs    <> "") Begin 
            Move (Mid(Ccilin.Override_Hs,4,1)) to b3line.Ovr_hs_code1
            Move (Mid(Ccilin.Override_Hs,2,5)) to b3line.Ovr_hs_code2
            Move (Mid(Ccilin.Override_Hs,2,7)) to b3line.Ovr_hs_code3
            Move (Mid(Ccilin.Override_Hs,2,9)) to b3line.Ovr_hs_code4
        End
        If (Ccilin.Gst_Code <> "") Move Ccilin.Gst_Code to b3line.GstRate_Ref#
        If (Ccilin.Oic_Code <> "") Move Ccilin.Oic_Code to b3line.Oic_Code     
        If (Ccilin.Oic_Sub_Code <> "") Move Ccilin.Oic_Sub_Code to b3line.Oic_Sub_Code 
        // 2025-01-15 b3 KRC fields are A9, move last 9 digits (not first) 
        //If (Ccilin.Previous_Transaction <> "") Move Ccilin.Previous_Transaction to b3line.Wh_Prev_Txn# 
        If (Ccilin.Previous_Transaction <> "") Move (Right(Ccilin.Previous_Transaction, 9)) to b3line.Wh_Prev_Txn# 
        If (Ccilin.Previous_Line <> "") Move Ccilin.Previous_Line        to b3line.Wh_Prev_Line#        
        If (Ccilin.Sima <> "") Move Ccilin.Sima        to b3line.Sima
        
        If (Ccilin.Luxury_Tax_Amount <> 0.00) Begin // 2024-02-16
            Move "Y"                      to b3line.LuxuryTax_Y
            Move "0000999969"             to b3line.LuxuryTax_Hs
            Move Ccilin.Luxury_Tax_Amount to b3line.LuxuryTaxAmount
        End // 2024-02-16
        If (Ccilin.Vaping_Amount <> 0.00) Begin
            Move "V"                  to b3line.LuxuryTax_Y
            Move ""                   to b3line.LuxuryTax_Hs
            Move Ccilin.Vaping_Amount to b3line.LuxuryTaxAmount
        End        
    SaveRecord b3line
    @unlock b3line
    
End_Procedure

Procedure UpdateB3line_From_SimaInfo
    Number nB3d_Sa_Amt 
    If ((not(gbIsCad_All)) and (not(gbIsCad_EnterCalc))) Procedure_Return   // 2025-04-21 KRC add gbIsCad_EnterCalc           
    Send CheckSet_B3line_Matches_Ccilin_Ccship "SimaInfo"   //+ 2024-10-24
    // 2024-03-12
    Move (Ccilin.SimaCntrVailAmt + ;
          Ccilin.SimaAntiDumpAmt + ;
          Ccilin.SurtaxAmount + ;
          Ccilin.SafeguardAmount) to nB3d_Sa_Amt
    re$ b3line
    If (b3line.b3d_sa_amt <> nB3d_Sa_Amt) Begin
        @lock b3line
        re$   b3line
            Move nB3d_Sa_Amt to b3line.b3d_sa_amt
        SaveRecord b3line
        @unlock b3line
    End
End_Procedure

Procedure CheckSet_B3line_Matches_Ccilin_Ccship String sScreenName
    Local Integer iBacfNum
    Move Ccilin.bacf# to iBacfNum
    // 1. Just cuz lets make sure that Ccship, Ccimas and Ccilin all have the same bacf#
    If (Ccimas.bacf# <> iBacfNum) Begin
        @system_problem# 8015 exit ;
        ("Update of b3line with " + sScreenName + "Bacf# mismatch ccilin vs ccimas") ;
        iBacfnum " vs " ccimas.bacf#
    End
    If (Ccship.bacf# <> iBacfNum) Begin
        @system_problem# 8016 exit ;
        ("Update of b3line with " + sScreenName + "Bacf# mismatch ccilin vs ccship") ;
        iBacfnum " vs " ccship.bacf#
    End

    // 2. Ok so lets make sure we have the right b3line. If not, find it
    re$ b3line
    If (b3line.b3line_code ne ccilin.b3line_code or ;
        b3line.bacf#       ne iBacfNum ) Begin
        Clear b3line
        Move iBacfNum           to b3line.bacf#
        Move Ccilin.b3line_code to b3line.b3line_code
        Find eq b3line by Index.1  // <bacf#> <b3line_code>
        [not Found] Begin
            @system_problem# 8017 exit ;
            ("Update of b3line with " + sScreenName + "Cannot find B3line with Bacf#") ;
            iBacfnum " and ccilin.b3line_code " ccilin.b3line_code
        End
    End
End_Procedure

// 2024-03-01
Function OicOrDrl String sOicCode String sOicSubCode Returns String
    Move (Trim(sOicCode)) to sOicCode
    If (sOicCode = "") Function_Return ""
    Clear Oic
    Move ""          to Oic.Inactive
    Move sOicCode    to Oic.Code
    Move sOicSubCode to Oic.Sub_Code       // we probably want his field to get the right one
    Find eq Oic by Index.1  // <Code_Ref> Overlaps <Inactive> <Code> <Sub_Code>
    If (Found) Begin
        If (oic.Duty_Relief_License_Drl_Y = "Y") Function_Return "DRL"
        Else                                     Function_Return "OIC"
    End
    Else Function_Return ""
End_Function

Function OicOk_OicOrDrl String sOicCode String sOicSubCode Returns Integer
    local Integer bOicOk
   Move (False) to bOicOk
    Move (Trim(sOicCode)) to sOicCode
    If (sOicCode = "") Begin
        Move ""     to sc_Spec_Auth_Oic_Or_Drl
        Move (True) to bOicOk
    End
    Else Begin
        Clear Oic
        Move ""          to Oic.Inactive
        Move sOicCode    to Oic.Code
        Move sOicSubCode to Oic.Sub_Code       // we probably want his field to get the right one
        Find eq Oic by Index.1  // <Code_Ref> Overlaps <Inactive> <Code> <Sub_Code>
        //Move (Found) to bOicOk
        [Found]     Move (True)  to bOicOk
        [not Found] Move (False) to bOicOk
        If (bOicOk) Begin
            If (oic.Duty_Relief_License_Drl_Y = "Y") Move "DRL" to sc_Spec_Auth_Oic_Or_Drl
            Else                                     Move "OIC" to sc_Spec_Auth_Oic_Or_Drl
        End
        Else Begin
            Move "" to sc_Spec_Auth_Oic_Or_Drl
        End    
    End
    // at3 "[dmCcil1 OicOk_OicOrDrl] sOicCode [" sOicCode "] OicOrDrl [" sc_Spec_Auth_Oic_Or_Drl "]ok[" bOicOk "]"
     Function_Return bOicOk
End_Function

// 2024-03-01 end
// 2024-03-14
Function OicOverrideCbsaCalc String sOicCode String sOicSubCode Returns String
    Move (Trim(sOicCode)) to sOicCode
    If (sOicCode = "") Function_Return ""
    Clear Oic
    Move ""          to Oic.Inactive
    Move sOicCode    to Oic.Code
    Move sOicSubCode to Oic.Sub_Code       // we probably want his field to get the right one
    Find eq Oic by Index.1  // <Code_Ref> Overlaps <Inactive> <Code> <Sub_Code>
    If (Found) Function_Return Oic.Override_Cbsa_Calc_Y
    Else       Function_Return ""
End_Function
// 2024-03-14 end

Procedure SurtaxRecalculateOnSave
    If ((trim(Ccilin.Surtax_Code)) <> "") Begin
        local Number nSurtaxRate
        Get SurtaxRate of oSurtaxCalculator Ccilin.Surtax_Code Ccilin.Surtax_Subject_Code  to nSurtaxRate 
        Get CalculateSurtaxAmount of oSurtaxCalculator ccilin.vfcc Ccimas.exchange_rate nSurtaxRate Ccilin.Surtax_Subject_Code to Ccilin.SurtaxAmount                     
    End
    Else Begin
        Move 0 to Ccilin.SurtaxAmount        
    End
End_Procedure

// 2025-01-19
//Sets indicators based on whether or not the code exists on the field
Procedure _SimaSurtaxSafeguardSetIndicators 
    indicate ItsSima      as scs_Sima_MifCode   ne ""
    indicate ItsSurtax    as scs_Surtax_Code    ne ""
    indicate ItsSafeguard as scs_Safeguard_Code ne ""
    
    Indicate ItsSaAlwaysOverride as gbIsSummary //2025-05-07 KRC Screen Entry Keyword requires indicators vs using bools
    
    //2025-04-15 KRC ItsSurtaxSubject ItsSafeguardSubject Determines a few things like Amounts and whether or not you can key    
    //Surtax
    [ItsSurtax] Begin
        indicate ItsSurtaxSubject as (scs_Surtax_Subject_Code = c_SubjectCodes_Subject)
    End
    [not ItsSurtax] Begin
       indicate ItsSurtaxSubject False
    End
    
    //Safeguard
    [ItsSafeguard] Begin
        indicate ItsSafeguardSubject as (scs_Safeguard_Subject_Code = c_SubjectCodes_Subject)
    End
    [not ItsSafeguard] Begin
        indicate ItsSafeguardSubject False
    End
End_Procedure


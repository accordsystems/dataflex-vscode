return_start_enter11:
RETURN start_enter11

Function gmItsa_zeroline Returns Integer
   If ccilin.amount      eq 0 ;
   If ccilin.acr_quan    eq 0 ;
   If ccilin.rating_rec# eq 0 Begin
      If ccilin.desc1       eq "" ;
      If ccilin.b3line_code eq "" Function_Return giTrue
   End
   Function_Return giFalse
End_Function
// -----
// When it is all done with the ENTER1.POSTSAVE, 
//   it goes here @ENTEREND_SCROLL
//   Normally just 
//      goto start_scroll

// 06/23/2004
// Adding a new ccilin
//   1. If we kept the one we added then do scroll_refresh
//   2. If we aborted and now delete the newly added line dont do scroll_refresh
   Integer giDoIt44
   @ENTEREND_SCROLL
// 10/19/1997 OK, if they created a dummy line then exited without saving it
//                delete the silly thing.
       Move (True) to giDoIt44  // 06/23/2004
       [not @DELETE_DONE] [not @SAVE_DONE] Begin
          If status ccilin ;
          If (gmItsa_zeroline(desktop)) Begin
             indicate err False
             @lock ccilin ccimas ccxtra
             re$   ccilin
             re$   ccimas
             Delete ccilin
             [not err] Send deleting to ;
                         (ccilin_ds(c_o))   // @decrement ccimas.count_lines
                                            // does save ccimas
             @unlock ccilin ccimas ccxtra
             [err] Begin
                @system_problem exit ;
                      "Deleting Empty CCILIN, BACF# " ccimas.bacf#
             End
             Move (False) to giDoIt44  //  06/23/2004
          End
       End                              
// 06/23/2004
       If ((giNewline_added) and (giDoIt44)) Begin
           @scroll_RESET_LIST POSITION ccilin.recnum
       End
// 06/23/2004 end
       [not @SAVE_DONE] Move giFalse to giNewline_added
// 10/19/1997 end

// 2017-10-12
// After a new line, if ccilin.ogd_group_auto is Y then copy b3line pga and sima info to ccilin 
//     If ((giNewline_added) and (giDoIt44)) Begin
//          SET_PGA_FILE
//          if (gbPga) goto start_enter2  //  01/31/2005
//     End
// 2017-10-12 end

Goto start_list

#IFDEF TitleMarkerNeverTrue
Property String ____Enter2forAdd/Update____
#ENDIF
 
#IFDEF TitleMarkerNeverTrue
Property String ____Subroutines____
#ENDIF

//========================> Subroutines <=====================================
// 2019-03-19
//REFRESH_UPDATE_OK:
//   INDICATE UPDATE_OK AS param1 NE "NO_UPDATE" // all others
//   RE$ bacfstat
//   If bacfstat.status_op GE 10 INDICATE UPDATE_OK False
//RETURN
// 2019-03-19 end

// 2019-03-19 end
//-------------------------------------
                     BACFMUSTBE_GIBACF#:
//-------------------------------------
   If (bacf.bacf# <> giBacf#) Begin
      Clear bacf
      Move giBacf# to bacf.bacf#
      Find eq bacf by Index.1  // <bacf#>
      If (not(Found)) Begin
         @system_problem exit "Unable to find giBacf# " giBacf# " in BacfMustBe_giBacf#"
      End
   End
   Relate Bacf  // to get opcust
RETURN
//-------------------------------------
                          UPDATE_B3DESC:
//-------------------------------------
// 1. Must be On or after Invoice description
   If (not(iOk_upd_b3desc)) Begin
      entagain
      return
   End

// 2. Check we got da right b3 line code
         re$   b3line
         If (b3line.b3line_code ne s_b3line_code or ;
             b3line.bacf#       ne ccship.bacf# ) Begin
             @system_problem# 8014 exit ;
               "B3line with B3 DESC. Mismatch to ccilin/bacf#" ;
                b3line.bacf# " vs " ccship.bacf# ;
                "[" b3line.b3line_code "]vs[" s_b3line_code
         End

// 4. Update b3line.
         indicate err False
            @lock b3line
            re$   b3line
               // 2021-09-21
               // Move s_desc1 to b3line.b3d_descrip1
               //  Move s_desc2 to b3line.b3d_descrip2
               Move (uppercase(s_desc1)) to b3line.b3d_descrip1
               Move (uppercase(s_desc2)) to b3line.b3d_descrip2
               // 2021-09-21 end
            SaveRecord b3line
            @unlock b3line
            [err] Begin
               @system_problem exit "Saving b3line.b3d_descrip1"
            End
   ENTAGAIN
RETURN

//-------------------------------------
                           LINE_ACTIONS:           // Insert Page / Line
//-------------------------------------
    If (not(gmCcilin_insync(desktop))) Goto start_list
// 2019-02-26
//    [im_AUTO_PAGE#] Begin
//       @ASK_OK_TO "insert Line prior or Replicate current line at end (L/R/N) " "LRN"
//       [not @ok_chr] Goto start_list
//    End
//    [not im_AUTO_PAGE#] Begin
//       @ASK_OK_TO "insert Page or Line prior or Replicate current line at end (P/L/R/N) " "PLRN"
//       [not @ok_chr] Goto start_list
//    End

    [im_AUTO_PAGE#] Begin
       @ASK_OK_TO "insert Line prior or Copy current line to end (L/C/N) " "LCN"
       [not @ok_chr] Goto start_list
    End
    [not im_AUTO_PAGE#] Begin
       @ASK_OK_TO "Insert page or line prior or Copy current line to end (I/C/N) " "ICN"
       [not @ok_chr] Goto start_list
    End
    If (@chr = "I") Begin
       @ASK_OK_TO "insert Page or Line prior (P/L/N) " "PLN"
       [not @ok_chr] Goto start_list
    End
// 2019-02-26 end

//  If @chr eq "C" Goto CALL_PROGRAM_REPLICATE_LINE   // 2019-01-20
    If @chr eq "C" Goto CALL_PROGRAM_COPY_LINE        // 2019-01-20
    If @chr eq "P" Goto CALL_PROGRAM_INSERT_PAGE
    If @chr eq "L" Goto CALL_PROGRAM_INSERT_LINE
Goto start_list

// 2021-10-03
//-------------------------------------
                             F8_ACTIONS:
//-------------------------------------
    // 2023-03-14
    // 2023-11-05
    // If (not(gbCarmCadActive)) Begin
    If (not(gbCadActive)) Begin
    // 2023-11-05    
        Goto Update_B3LC 
    End
    Else Begin
    // 2023-03-14 end
        @ASK_OK_TO "B3 line or Cad or Sima (B/C/S/N) " "BCSN"
        If @chr eq "B" Goto UPDATE_B3LC               
        If @chr eq "C" Goto SCREEN_ENTER2_CAD                   
        If @chr eq "S" Goto SCREEN_ENTER3_SIMA
    End   // 2023-03-14
Goto start_list

#IFDEF TitleMarkerNeverTrue
Property String SCREEN_ENTER2_CAD
#ENDIF


SCREEN_ENTER2_CAD:
//========================> Enter2 for Update <============================
   start_enter2:
   Move 3 to giScreen#
   Gosub SCROLL.DISPLAY_ENTERCAD
   
    // screenmode @colour_HI ON
    // Move "CAD INFO"    to sc_title      // 2019-01-26
    // Move giBacf#       to sc_bacf#
    // Move gsRef_Cciln   to sc_ref_cciln
    // Move Ccilin.line#  to sc_line#
    // // screenmode @colour_LO ON 
    // Page screenENTERcad
    @ENTER_SCROLL ccilin
    // @scroll_SET_LINEINDEX    // If using screenLIST for enter
    KEYPROC KEY.UP    GOSUB return_start_enter22
    KEYPROC KEY.SFIND GOSUB POPUP
    //+ GOSUB ENTER2.POSTFIND
    // INDICATE ENT$PERMISSIVE TRUE  // in enter; allows find/prev/next on
         // parent fields to change parent records, (not doing a superfind)
         // dangerous in master txn relationships with $ involved.
    start_enter22:
             @EMESSAGE " Hi there."
    scn2_ship:
          
         @emessage2 ""
      // 2024-12-10   
      //     @emessage2 ("Y- we send the flag to CBSA saying that we are providing the amounts normally " + ;
      //                 "calculated by CBSA")
      //  ENTRY Ccilin.Override_Cbsa_Calc_Y      sc_Override_Cbsa_Calc_Y     {capslock, check="Y "}}    
      //                                         [key.down] Goto screen_annex                          
      // 2024-12-10 end                                       
         @emessage2 "Our calculation of the Vaping Amount.  Updates b3line.LuxuryTaxAmount and b3lineLuxuryTax_Y 'V' not 'Y'"
      ENTRY Ccilin.Vaping_Amount             sc_Vaping_Amount        {forceput} 
                                             [key.down] Goto screen_destn_prov                         
          If (sc_vaping_amount <> 0)     Move 0 to sc_luxury_tax_amount  // 2024-02-16            
         @emessage2 "Our calculation of the Luxury Tax Amount. Updates b3line.LuxuryTaxAmount and b3lineLuxuryTax_Y 'Y' and hs to 0000 99 99 69"
      ENTRY Ccilin.Luxury_Tax_Amount         sc_Luxury_Tax_Amount    {forceput} 
                                              [key.down] Goto screen_destn_prov                      
         If (sc_luxury_tax_amount <> 0) Move 0 to sc_Vaping_amount      // 2024-02-16       
         @emessage2 "The percentage of alcohol. This came from the rating item"
      ENTRY Ccilin.Alcohol_Percent           sc_Alcohol_Percent            
                                              [key.down] Goto screen_destn_prov                     
      screen_destn_prov:  // 2025-03-07
         @emessage2 ("The Destination Province F3-popup list of provinces   f#6 type 41 " + ; 
                     "                        Source is ECCRD Appendix G31.")
      ENTRY Ccilin.Destination_Province      sc_Destination_Province       {capslock} 
                                              [key.down] Goto screen_annex                          
         @emessage2 ("Our calculation of Provincial Amounts. AAI is the Cad DutyTaxFee type code. Ref ECCRD Appendix G6") 
      ENTRY Ccilin.Provincial_Amount         sc_Provincial_Amount          
                                              [key.down] Goto screen_annex                          
         @emessage2 ("Our calculation of the Other Accept Rate Amount.")
      ENTRY Ccilin.Other_Accept_Rate_Amount  sc_Other_Accept_Rate_Amount
                                              [key.down] Goto screen_annex                          
         @emessage2 ("The Duty/Tax/Fee Type Code that applies to the Other Accept Rate Amount " + ;
                     "        Codes are from ECCRD Appendix G6    F3-Popup is to f#6 Type 109")
      ENTRY Ccilin.Other_Accept_Rate_Type    sc_Other_Accept_Rate_Type      {capslock} 
                                              [key.down] Goto screen_annex                          
         @emessage2 "Override Harmonized System Code. No dots, just the digits"
      ENTRY Ccilin.Override_HS               sc_Override_HS                
         @emessage2 "Override Annex Code"
      screen_annex: 
      ENTRY Ccilin.Override_Annex            sc_Override_Annex 
                                              [key.down] Goto screen_permit                          
         @emessage2 ("Excise Tax Code  Set from Rating Record  when CciLine added       Codes are from ECCRD Appendix G9 " + ;
                     "       F3-Popup to f#6 Type 108")
      ENTRY Ccilin.Excise_Tax_Code           sc_Excise_Tax_Code             {capslock} 
                                              [key.down] Goto screen_permit                          
         @emessage2 ("GST Code. Set from Rating Item (Part#) when CciLine added      Codes are from ECCRD Appendix G10   " + ;
                     "        F3-Popup to table#54 Gstrate")
      ENTRY Ccilin.Gst_Code                  sc_Gst_Code                    {capslock} 
screen_permit:
         @emessage2 ("Permit Number.")
      ENTRY Ccilin.Permit_Number             sc_Permit_Number               {capslock} 
                                              [key.down] Goto screen_prev_trans
screen_oic_code:
         @emessage2 ("Special Authority Code. Set from Rating Record when CciLine added       " +;
                     "           Codes are from our OIC Table.   F3-Popup to our f#14 OIC")
      ENTRY Ccilin.Oic_Code                  sc_Oic_Code                   {capslock} 
                                              [key.down] Goto screen_prev_trans
         @emessage2 ("Normally blank. One character sub code to allow there to be mulitple records " + ;
                     " in the OIC table with the same code")
      ENTRY Ccilin.Oic_Sub_Code              sc_Oic_Sub_Code               {capslock} 
         Get OicOk_OicOrDrl of current_object sc_Oic_Code sc_Oic_Sub_code to gbOicOk
         If (not(gbOicOk)) Begin
            @errormsg "Special Authority Code invalid. Not in F3-Popup OCI Table. "
            Goto screen_oic_code 
         End
                                              [key.down] Goto screen_prev_trans
         @emessage2 ("The type of Special Authority. Either OIC or DRL (Duty Relief Licence)     " + ;
                     "            WARNING. This is automatically set from the OIC table#14. ")
      ENTRY Ccilin.Spec_Auth_Oic_Or_Drl      sc_Spec_Auth_Oic_Or_Drl        {capslock, check="OIC|DRL|   "} 
         Get OicOk_OicOrDrl  sc_Oic_Code sc_Oic_Sub_Code to gbOicOk

         @emessage2 "Ruling Number"
      ENTRY Ccilin.Ruling_Number             sc_Ruling_Number               {capslock}
screen_prev_trans:    // 2025-03-07
         @emessage2 "Previous Transaction number. 14 digits "
      ENTRY Ccilin.Previous_Transaction      sc_Previous_Transaction       
         @emessage2 ("Previous line number. From 1 to 5 digits.          " + ;
                     " The leading zeros will be automatically added when transmitted")
      ENTRY Ccilin.Previous_Line             sc_Previous_Line              
         @emessage2 "TIme Limit Start - Its a date field."
      ENTRY Ccilin.TimeLimit_Start           sc_TimeLimit_Start            
         @emessage2 "Time Limit End  -  Its a date field"
      ENTRY Ccilin.TimeLimit_End             sc_TimeLimit_End              
      // 2024-03-22
         @emessage2 "Time Limit Type - eg 1 2 3 or 4 from ECCRD Appendix G23"
      ENTRY ccilin.TimeLimit_Type            sc_TimeLimit_Type  {check="1234 "}  // 2024-03-22   
      // 2024-03-22 end
         @emessage2 " Time Limit Months  - Its a number, the number of months"
      ENTRY Ccilin.TimeLimitMonths           sc_TimeLimitMonths            
         @emessage2 ""

      RETURN

      ENTER2.PRESAVE:
         // 1. Set gbUpdateOk (not rating finished)
         Send pSet_gbUpdateOk giBacf#
         If (not(gbUpdateOk)) Begin
            If bacfstat.status_op GE 10 Begin
               @ERRORMSG "Updates not allowed - already rating finished."
            End
            Else Begin
               // 2023-09-19
               // @ERRORMSG "Updates not allowed."
               If (gbCciLocked) Begin
                   @errormsg "Updates not allowed. Cci is locked, never updateable. (Proctype R is Y)"
               End
               Else Begin
                  @ERRORMSG "Updates not allowed. gbUpdateOk set in am.cmd is false"
               End 
               // 2023-09-19 end                
            End
            INDICATE ERR True
            RETURN
         End
         // 2. No New_Record here
         [@NEW_RECORD] Begin
            @ERRORMSG "To add a new LINE, hit <F9> from the LIST."
            INDICATE ERR True
            RETURN
         End
         FILE_MODE ccilin DEFAULT
         indicate err False
      RETURN

      ENTER2.Save:
      RETURN
      ENTER2.POSTSAVE:
         FILE_MODE ccilin READ_ONLY
at3 "[dmCciL1 ENTER2.POSTSAVE] start before call to UpdateB3line_From_CadInfo"
         Send UpdateB3line_From_CadInfo    // 2024-02-14     
      RETURN
      ENTER2.PREDELETE:
         INDICATE ERR True  
         FILE_MODE ccilin DEFAULT
      RETURN
      ENTER2.POSTDELETE:
         FILE_MODE ccilin READ_ONLY
      RETURN
      ENTER2.PREFIND:
      ENTER2.CLEARING:
         INDICATE ERR True   // disables the find, pgup, pgdn keys
      RETURN
      ENTER2.POSTCLEAR:
      ENTER2.POSTFIND:
         //GOSUB @SCROLL.DISPLAY_LINE
      RETURN
      return_start_enter22:
      RETURN start_enter22
   @ENTEREND_SCROLL

Goto start_list
// 2021-10-03 end
// 2021-10-07
//-------------------------------------



#IFDEF TitleMarkerNeverTrue
Property String SCREEN_ENTER3_SIMA
#ENDIF
SCREEN_ENTER3_SIMA:
    Move 4 to giScreen#
    
    #IFDEF TitleMarkerNeverTrue
        Property String start_enter3
    #ENDIF     
    Gosub SCROLL.DISPLAY_ENTER3    
    @ENTER_SCROLL ccilin
    // @scroll_SET_LINEINDEX    // If using screenLIST for enter
    KEYPROC KEY.UP    GOSUB return_start_enter3_sima
    KEYPROC KEY.SFIND GOSUB POPUP      
    // INDICATE ENT$PERMISSIVE TRUE  // in enter; allows find/prev/next on
        // parent fields to change parent records, (not doing a superfind)
        // dangerous in master txn relationships with $ involved.
    
    start_enter3_sima:
    @EMESSAGE " Hi there."   
         
    Send SimaSurtaxSafeGuardRefresh
    
    //Sima MIF Code
    @emessage2 ("SIMA Measure In Force Code.       Reference ECCRD Appendix G38." + ;
                   "                    Popup is to t#6 type 101. ")      
    ENTRY ccilin.Sima_MifCode scs_Sima_MifCode {capslock}    
    Send SimaSurtaxSafeGuardRefresh 
    [key.down] Goto screen_sima_code
    
    //Sima Subject Code  
    @message2 (    "         Sima Subject Code: [S]ubject [N]onsubject [U]ndertaking               " + ;
                   "                 Appendix G11. Popup is to t#6 type 104.                       ")
    [ItsSima] ENTRY ccilin.Sima_Subject_Code scs_Sima_Subject_Code {capslock, check ="SNU"}
    [key.down] Goto screen_sima_code        
    //Sima Notes: From Rating Item      
    @emessage "SIMA Notes"
    [ItsSima] ENTRY ccilin.Sima_Note1 scs_Sima_Note1   {displayonly}
    [ItsSima] ENTRY ccilin.Sima_Note2 scs_Sima_Note2   {displayonly}
    [ItsSima] ENTRY ccilin.Sima_Note3 scs_Sima_Note3   {displayonly}
    [ItsSima] ENTRY ccilin.Sima_Note4 scs_Sima_Note4   {displayonly}
    
    //Sima Code Screen
    screen_sima_code:
    @emessage2 ("SIMA Code eg  10, 20, 30, 31, 32, 40, 50, 51, 52      " + ;
                "Reference Appendix G19                      Popup is to t#6 type 105")
    [ItsSima] ENTRY ccilin.Sima_Code scs_sima_Code                    
    [key.down] Goto Screen_Stb_Quan
    //Sima Bond
    @emessage "SIMA Bond Y or blank"
    [ItsSima] ENTRY ccilin.Sima_Bond scs_sima_Bond {capslock, check ="Y "}
    [key.down] Goto Screen_Stb_Quan
    
    //Sima MIF Provisional
    @emessage2 (" SIMA Measure In Force Provisional Y or blank. " + ;
                " Set automatically from HsPgaPgm table in I20 Manage. " + ;
                "       User cannot change. suRtax-blank. saFeguard-blank.")
    [ItsSima] ENTRY ccilin.Sima_Mif_Provisional        scs_Sima_Mif_Provisional  {capslock}   
    [ItsSima] Begin
        // 2025-01-19
        // Get Sima_Mif_Provisional_From_HsPgaPgm of oCadUtil ; // also works just fine is of (oCadUtil(Current_Object)) ;
        //     scs_Sima_Surt_Safe_Mrf  scs_MifCode_Sima_Surt_Safe ;
        //     to gsProvisional 
        Get Sima_Mif_Provisional_From_HsPgaPgm of oCadUtil ; // also works just fine is of (oCadUtil(Current_Object)) ;
            "M"  scs_Sima_MifCode     to gsProvisional 
        // 2025-01-19 end    
        If (scs_sima_mif_provisional <> gsProvisional) Begin
            Move gsProvisional to scs_sima_mif_provisional 
            @errormsg "'User cannot change' means ya can't change the Provisional flag here."
            @errormsg "I20Manage HsPgaPgm tab is where ya gotta have someone change it."    
        End     
    End
    [not ItsSima] Move "" to scs_Sima_Mif_Provisional
    [key.down] Goto Screen_Stb_Quan
    
    //Inco Terms
    @emessage2 ("Inco Terms         Reference Appendix G32                       " + ;
                "                          Popup is to t#6 type 106")        
    [ItsSima] ENTRY ccilin.Sima_Inco_Term scs_sima_Inco_Term   {capslock}           
    [key.down] Goto Screen_Stb_Quan
    
    //Product Model Id
    [ItsSima] ENTRY ccilin.Product_Model_Id scs_Product_Model_Id         
    [key.down] Goto Screen_Stb_Quan
    
    //Sima Vendor BN15
    @emessage "SIMA Vendor Business Number"
    [ItsSima] Begin
        If ((scs_sima_bn15 = "") and (scs_Sima_Subject_Code = "S")) Begin // 2021-12-07
            Move Ccimas.sima_Bn15 to scs_sima_bn15 
        End
    End // 2025-01-19 end  
    [ItsSima] ENTRY ccilin.Sima_BN15 scs_sima_BN15 {capslock}                 
    [key.down] Goto Screen_Stb_Quan
    
    //Sima Aquisition Date
    @emessage "SIMA Acquistion Date. Date of Sale if different from Date of Direct Shipment"
    If ((scs_sima_code <> "") and (scs_simaAcquisition < 01/01/1980)) Begin
        Move gdDefaultAcquisitionDate to scs_simaAcquisition 
    End
    If (scs_sima_code = "") Move "" to scs_simaAcquisition    
    [ItsSima] ENTRY ccilin.SimaAcquisition scs_simaAcquisition {forceput}
    [key.down] Goto Screen_Stb_Quan
    
    //Stb Quantity    
    Screen_Stb_Quan:
    @emessage2 ""
    @emessage "Specific Tax Base Quantity"
    [ItsSima] ENTRY ccilin.Sima_Stb_Quan scs_sima_Stb_Quan                
    [key.down] Goto Screen_CounterVail
    
    //STB Unit of Measure
    @emessage "Specific Tax Base Unit of Measure"
    [ItsSima] ENTRY ccilin.Sima_Stb_Uom scs_sima_Stb_Uom {capslock} 
    
    //Sima CounterVailing Amount
    Screen_CounterVail:   
    @emessage "Sima Counter Vailing Amount"
    [ItsSima] ENTRY ccilin.SimaCntrVailAmt scs_simaCntrVailAmt                 
    [key.down] Goto screen_ENTER3_Surtax
    
    //Sima Override Countervailing Amount
    @emessage2 "Y-Override CounterVail Amt and send to CARM.  blank-No override, do not send amount."
    String gsCounterVailingOverrideAllowedValues
    [ItsSima] Begin
        [ItsSaAlwaysOverride] Begin
            @emessage2 "CLVS - [Y] Always Transmit CounterVail Amount"                     
            Move "Y" to ccilin.Override_CounterVail_Amt
            Move "Y" to scs_Override_CounterVail_Amt              
            Move "Y" to gsCounterVailingOverrideAllowedValues        
        End
        [not ItsSaAlwaysOverride] Begin
            @emessage2 "[Y]-Transmit CounterVail Amount [Blank]-Do Not transmit amount."                     
            Move "Y " to gsCounterVailingOverrideAllowedValues
        End
        ENTRY ccilin.Override_CounterVail_Amt scs_Override_CounterVail_Amt {capslock, check=gsCounterVailingOverrideAllowedValues}    
    End    
   
    [key.down] Goto screen_ENTER3_Surtax
    
    //Sima Anti Dumping Amount
    @emessage2 "SIMA AntiDumping Amount"
    [ItsSima] ENTRY ccilin.SimaAntiDumpAmt scs_simaAntiDumpAmt                 
    [key.down] Goto screen_ENTER3_Surtax
    
   //Sima Antidumping Override
   String gsAntiDumpingAllowedValues
   @emessage2 "Y-Override AntiDumping Amt and send to CARM  blank-No override, do not send amount."
   [ItsSima] Begin
      [ItsSaAlwaysOverride] Begin //ie. CLVS
         @emessage2 "CLVS - [Y] Always Transmit AntiDump Amount"
         move "Y" to ccilin.Override_AntiDump_Amt
         Move "Y" to scs_Override_AntiDump_Amt
         Move "Y" to gsAntiDumpingAllowedValues         
      End
      [not ItsSaAlwaysOverride] Begin
         @emessage2 "[Y]-Transmit AntiDump Amount [Blank]-Do Not transmit amount."            
         Move "Y " to gsAntiDumpingAllowedValues         
      End
      ENTRY ccilin.Override_AntiDump_Amt scs_Override_AntiDump_Amt {capslock, check=gsAntiDumpingAllowedValues}                      
   End
   [key.down] Goto screen_ENTER3_Surtax
    
    //Sima Deduction Amount
    @emessage "Sima Deduction Amount"
    [ItsSima] ENTRY ccilin.Sima_Dedn_Amt scs_sima_Dedn_Amt                    
    [key.down] Goto screen_ENTER3_Surtax
    
    //Sima Deduction Currency
    @emessage "Sima Deduction Currency"
    [ItsSima] ENTRY ccilin.Sima_Dedn_Curr scs_sima_Dedn_Curr   {capslock}
    [key.down] Goto screen_ENTER3_Surtax
    
    //Item Charge Amount
    @emessage "Item Charge Amount"
    [ItsSima] ENTRY ccilin.ItemChgAmt scs_ItemChgAmt
    [key.down] Goto screen_ENTER3_Surtax
    
    //Item Charge Currency
    @emessage "Item Charge Currency"
    [ItsSima] ENTRY ccilin.ItemChgAmt_Curr scs_ItemChgAmt_Curr  {capslock}
    //end screen_Sima
    
    //begin Surtax
    #IFDEF TitleMarkerNeverTrue
        Property String screen_ENTER3_Surtax
    #ENDIF
    screen_ENTER3_Surtax:
    
    //Surtax Code
    @emessage2 ("Surtax Code.                      Reference ECCRD Appendix G36." +;
                "                    Popup is to t#6 type 102. ")
    ENTRY ccilin.Surtax_Code scs_Surtax_Code {capslock} 
    Send SimaSurtaxSafeGuardRefresh           
    [key.down] Goto screen_ENTER3_Safeguard               
    
    //Surtax Subject Code
    [ItsSurtax] Begin
         @emessage2 ("               Surtax Subject Code [S|N]. Reference ECCRD Appendix G11.         " +;
                     "                         Popup is to t#6 type 102.                              ")

         ENTRY ccilin.Surtax_Subject_Code scs_Surtax_Subject_Code {capslock, check ="SN"}                    
         Send SimaSurtaxSafeGuardRefresh
    End
    [key.down] Goto screen_ENTER3_Safeguard                     

    //Surtax Amount
    [not ItsSurtaxSubject] Begin
        Move 0.0000 to scs_Surtax_Rate        
        Move 0.00 to scs_Surtax_Amount
        Move 0.00 to ccilin.SurtaxAmount
    End
    [ItsSurtaxSubject] Begin
        //Triggers if Surtax Code is Value
        @emessage2 "Surtax Amount. Uses CodeTabl.Help1"                        
        Get SurtaxRate of oSurtaxCalculator scs_Surtax_Code scs_Surtax_Subject_Code to scs_Surtax_Rate        
        Get CalculateSurtaxAmount of oSurtaxCalculator ccilin.vfcc Ccimas.exchange_rate scs_Surtax_Rate scs_Surtax_Subject_Code to scs_Surtax_Amount     
        ENTRY ccilin.SurtaxAmount scs_Surtax_Amount {forceput}
    End    
    [key.down] Begin
        Goto screen_ENTER3_Safeguard           
    End
    
    //Override Surtax Amount 
    String gsSurtaxAllowedValues   
    [not ItsSurtaxSubject] Begin
        Move "" to scs_Override_Surtax_Amt        
        Move "" to ccilin.Override_Surtax_Amt
        Move " " to gsSurtaxAllowedValues
    End
    [ItsSurtaxSubject] Begin 
      [ItsSaAlwaysOverride] Begin //ie. CLVS
         @emessage2 "CLVS - [Y] Always Transmit Surtax Amount"                     
         move "Y" to ccilin.Override_Surtax_Amt
         Move "Y" to scs_Override_Surtax_Amt
         Move "Y" to gsSurtaxAllowedValues         
      End
      [not ItsSaAlwaysOverride] Begin
         @emessage2 "[Y]-Transmit Surtax Amount [Blank]-Do Not transmit amount."            
         Move "Y " to gsSurtaxAllowedValues         
      End
      ENTRY ccilin.Override_Surtax_Amt scs_Override_Surtax_Amt {capslock, check=gsSurtaxAllowedValues}                      
      Send SimaSurtaxSafeGuardRefresh
    End    
    // 2025-02-03 end
//end screen_ENTER3_Surtax

    #IFDEF SectionMarkerNeverTrue
    Property String screen_ENTER3_Safeguard
    #ENDIF
screen_ENTER3_Safeguard:
    //Safeguard Code
    @emessage2 ("                  Safeguard Code. Reference ECCRD Appendix G37.                 " + ;
                "                            Popup is to t#6 type 103.                           ")
    ENTRY ccilin.Safeguard_Code    scs_Safeguard_Code    {capslock}   
    
    Send SimaSurtaxSafeGuardRefresh     
    //Safeguard Subject Code    
    [ItsSafeguard] Begin
        @emessage2 ("         Safeguard Subject Code [S|N]. Reference ECCRD Appendix G11.            " +;
                    "                         Popup is to t#6 type 104.                              ")
        ENTRY ccilin.Safeguard_Subject_Code scs_Safeguard_Subject_Code {capslock, check ="SN"}
    End    
    Send SimaSurtaxSafeGuardRefresh
    
    //Safeguard Amount
    @emessage2 "Safeguard Amount. Only set if Safeguard code in not blank."
    [not ItsSafeguardSubject] Begin
        Move 0.00 to scs_Safeguard_Amount    
        Move 0.00 to ccilin.SafeguardAmount
    End
    [ItsSafeguardSubject] Begin
        ENTRY ccilin.SafeguardAmount scs_Safeguard_Amount     
    End
    //Safeguard Override    
    @emessage2 "Y-Override Safeguard Amt and send to CARM  blank-No override, do not send amount."    
    String gsSafeguardAllowedValues
    [not ItsSafeguardSubject] Begin
        Move "" to scs_Override_Safeguard_Amt
        Move " " to gsSafeguardAllowedValues
    End
    
    [ItsSafeguardSubject] Begin    
        [ItsSaAlwaysOverride] Begin //ie. CLVS
         @emessage2 "CLVS - [Y] Always Transmit Safeguard Amount"                              
         Move "Y" to scs_Override_Safeguard_Amt
         Move "Y" to gsSafeguardAllowedValues         
      End
      [not ItsSaAlwaysOverride] Begin
         @emessage2 "[Y]-Transmit Safeguard Amount [Blank]-Do Not transmit amount."            
         Move "Y " to gsSafeguardAllowedValues         
      End
      ENTRY ccilin.Override_Safeguard_Amt scs_Override_Safeguard_Amt {capslock, check=gsSafeguardAllowedValues}                      
   End
    
    //End Screen
    @emessage2 ""      
RETURN //SCREEN_ENTER3_SIMA

#IFDEF TitleMarkerNeverTrue
Property String ENTER3.PRESAVE
#ENDIF

ENTER3.PRESAVE:
    // 1. Set gbUpdateOk (not rating finished)
    Send pSet_gbUpdateOk giBacf#
    If (not(gbUpdateOk)) Begin
        If bacfstat.status_op GE 10 Begin
           @ERRORMSG "Updates not allowed - already rating finished."
        End
        Else Begin
           @ERRORMSG "Updates not allowed."
        End
        INDICATE ERR True
        RETURN
    End
    // 2. No New_Record here
    [@NEW_RECORD] Begin
        @ERRORMSG "To add a new LINE, hit <F9> from the LIST."
        INDICATE ERR True
        RETURN
    End
    FILE_MODE ccilin DEFAULT
    indicate err False
RETURN

#IFDEF TitleMarkerNeverTrue
Property String ENTER3.Save
#ENDIF
    
ENTER3.Save:
    // 2024-11-14
    // Always send Product_Model_Id
    If (ccilin.Product_Model_Id = "") Move " " to ccilin.Sima_Send_Part
    Else                              Move "Y" to ccilin.Sima_Send_Part
    // 2024-11-14 end
RETURN

#IFDEF TitleMarkerNeverTrue
Property String ENTER3.POSTSAVE
#ENDIF

ENTER3.POSTSAVE:
    FILE_MODE ccilin READ_ONLY
    at3 "[dmCciL1 ENTER3.POSTSAVE] start"
    Send UpdateB3line_From_SimaInfo    // 2024-02-14     
    RETURN
    ENTER3.PREDELETE:
    INDICATE ERR True  
    FILE_MODE ccilin DEFAULT
    RETURN
    ENTER3.POSTDELETE:
    FILE_MODE ccilin READ_ONLY
RETURN


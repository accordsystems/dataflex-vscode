// 2021-10-07 END

//-------------------------------------
                            UPDATE_B3LC:
//-------------------------------------
    Number save_ccilin_rec#
    // 1. ccilin ok
    If (not(gmCcilin_insync(desktop))) Goto start_list
    Move ccilin.recnum to save_ccilin_rec#

    // 2. get b3line
    Clear b3line
    Move giBacf#           to b3line.bacf#
    Move ccilin.b3line_code to b3line.b3line_code
    Find eq b3line by Index.1
    [not Found] Begin
       @errormsg "Can't find b3line code to update."
       Goto start_list
    End

    // 3. call DMACLN1
    // 2019-03-19
    //   [UPDATE_OK] Begin
    //     CHAIN Wait "dmacln1 UPDATE_OK" EXPORT_FILES
    //   End
    //   [not UPDATE_OK] Begin
    //      CHAIN Wait "dmacln1 NO_UPDATE" EXPORT_FILES
    //   End
    If (gbUpdateOk) CHAIN Wait "dmacln1 UPDATE_OK" EXPORT_FILES
    Else            CHAIN Wait "dmacln1 NO_UPDATE" EXPORT_FILES
    // 2019-03-19 end


    // 4. refresh screen
    @CHECK_GOSTART Goto end_program
    Move 0 to CURRENT_IMAGE
    @scroll_RESET_LIST POSITION save_ccilin_rec#
    gosub REFRESH_SCREEN
Goto start_list

//-------------------------------------
                           CALL_PROGRAM:
//-------------------------------------
   CHAIN Wait "programx" EXPORT_FILES
   @CHECK_GOSTART Goto end_program
   Move 0 to CURRENT_IMAGE
   @scroll_RESET_LIST POSITION ccilin.recnum
   gosub REFRESH_SCREEN
Goto start_list

//-------------------------------------
                             ADD_ccilin:
//-------------------------------------
// [NOT UPDATE_OK]     GOTO start_list
   If (not(gbUpdateOk)) Goto start_list  // 2019-03-19
// 0. Still in sync?
   If not status ccimas Begin
      @errormsg "Add ccilin - Lost ccimas record"
   End
   If not status ccship Begin
      @system_problem exit "Add ccilin - lost ccship record"
   End
   If ccimas.cci_id ne gsThis_cci_id Begin
      @system_problem exit "Add ccilin - mismatch on ccimas.bacf#"
   End
   If ccship.bacf# ne giBacf# Begin
      @system_problem exit "Add ccilin - mismatch on ccship.bacf#"
   End
   // 2025-02-24
   If (ccimas.last_ccil_id = "zz") Begin
      @errormsg "Add ccilin - Problem - At max # of cci lines for this Cci master."
      @errormsg "Suggestion: Start a new CCI this Bacf and add lines to it."
      @system_problem exit "Hit SpaceBar to exit the program"
   End
   If (ccimas.count_lines > 2550) Begin  // 2,584 is the real max methinks
      @errormsg "Add ccilin - Problem - At max of 2550 cci lines for this Cci master."
      @errormsg "Suggestion: Start a new CCI this Bacf and add lines to it."
      @system_problem exit "Hit SpaceBar to exit the program"
   End
   // 2025-02-24 end
// 1. Add it
   indicate err False
   Clear ccilin
   @lock ccilin ccimas ccship
   re$   ccimas
   re$   ccship
      Move gsThis_cci_id  to ccilin.cci_id
      Send creating     to (ccilin_ds(c_o))   // assigns ccimas.next_line#
                                              // save ccimas
      Send update       to (ccilin_ds(c_o))   // @increment ccimas.tot_line_amount
                                              // recalc's   ccimas.tot_diff
                                              // save ccimas
    // 2024-03-13
    // 2025-05-02 KRC Non IID Handling Knocked Out for Surtax and Sima support
    //If (not(gbGotBacfIid)) Begin
        //Move "Y" to ccilin.ogd_group_auto                                       
        //Move "N" to ccilin.sima                                                 
        //Move ""  to ccilin.pgaqa_list 
        //Move ""  to ccilin.pgaqa_status
    //End
      // 2024-03-13 end
   SaveRecord ccilin
   @unlock ccilin ccimas ccship
   [err] Begin
      @system_problem exit "Adding ccilin."
   End

//++   gcBLANK_CCXTRA_PROD   // amlib085, blanks the gsProd_ fields

// 2. Update counts of CCI Lines (count#3)

    @GET_ZACTIV   // 04/08/1997

    @UPDATE_ZACTIV 3 1

// 2. Done
// 06/23/2004
// Do this later in case they hit escape
// @scroll_RESET_LIST POSITION ccilin.recnum
// 06/23/2004
   @emessage "CCI Line added."
   Move giTrue to giNewline_added  // so it skips to the next line when done, and for SIMA warning
   Move 1 to giScreen#  // 01/31/2005
   Move 0 to giNewline_added_count_cfia

Goto start_enter




//-------------------------------------
                          DELETE_ccilin:
//-------------------------------------
// 2019-03-23 String  gsCcil_id         //  2018-04-16
String  gsOkDelete        //  2018-04-16
// [not UPDATE_OK]      Goto start_list
   If (not(gbUpdateOk)) Goto start_list  // 2019-03-19

   @ask_ok_to "Delete this CCI line? (D/N) " "DN"
   [not @ok_chr] Goto start_list

// 0. Still in sync?
   If not status ccilin Begin
      @errormsg "No ccilin record to delete"
   End
   If ccilin.cci_id ne gsThis_cci_id Begin
      @system_problem exit "Delete ccilin - mismatch on ccilin.cci_id"
   End

   If not status ccimas Begin
      @errormsg "Delete ccilin - Lost ccimas record"
   End
   If not status ccship Begin
      @system_problem exit "Delete ccilin - lost ccship record"
   End
   If not status ccilin Begin
      @system_problem exit "Delete ccilin - lost ccship record"
   End
   If ccimas.cci_id ne gsThis_cci_id Begin
      @system_problem exit "Delete ccilin - mismatch on ccimas.bacf#"
   End
   If ccship.bacf# ne giBacf# Begin
      @system_problem exit "Delete ccilin - mismatch on ccship.bacf#"
   End

// 1. Delete
// 2019-03-23 Move Ccilin.ccil_id to gsCcil_id         //  2018-04-16
   indicate err False
   @lock ccilin ccimas ccship ccxtra
   re$   ccilin
   re$   ccimas
   re$   ccship
//    send backout    to (ccimas_ds(c_o))   // @decrement ccship.moa_total_cdn
//                                          //         by ccimas.total_cdn
      Send backout    to (ccilin_ds(c_o))   // @decrement ccimas.tot_line_amount
                                            // recalc's   ccimas.tot_diff
      Send deleting   to (ccilin_ds(c_o))   // @decrement ccimas.count_lines
                                            // does save ccimas
//    send update     to (ccimas_ds(c_o))   // @increment ccship.moa_total_cdn
//                                          //         by ccimas.total_cdn
   Delete  ccilin
   @unlock ccilin ccimas ccship ccxtra
   [err] Begin
      @system_problem exit "Deleting ccilin."
   End

// 2018-04-16
// 2. Delete all CcXtraSw associated with this Ccilin
// 2019-03-23
// Get mDelete_CcXtraSw_One_Ccilin of oRrec_info giBacf# (gsThis_cci_id + gsCcil_id) to gsOkDelete  // dmlib024.pkg
// 2019-05-29
// Get mDelete_CcXtraSw_One_Ccilin of oRrec_info giBacf# gsRef_Cciln to gsOkDelete  // dmlib024.pkg
   Get Delete_CcXtraSw_One_Ccilin of oXtraSw giBacf# gsRef_Cciln to gsOkDelete  // cXtraSw.pkg
// 2019-05-29 end
// 2019-03-23 end
// 2018-04-16 end

// 3. Update Count#3 - CCI Lines

    @GET_ZACTIV   // 04/08/1997

    @UPDATE_ZACTIV 3 -1

// 4. Done
   Clear ccilin
   @scroll_RESET_LIST REFRESH ccilin.recnum 1 1
//++ gcBLANK_CCXTRA_PROD
Goto start_list

//-------------------------------------
               CALL_PROGRAM_INSERT_PAGE:
//-------------------------------------
// [NOT UPDATE_OK]      GOTO start_list
   If (not(gbUpdateOk)) Goto start_list // 2019-03-19

   If (not(gmCcilin_insync(desktop))) Goto start_list

   Move ccilin.page# to giThis_page#
   Move ccilin.line# to giThis_line#

// 1. Call the function
// 2019-12-12
// @CALL_PROGRAM "CCFTN1 INSERT_PAGE" gsThis_cci_id giThis_line# giThis_page#
   @CALL_PROGRAM_LOWERCASE "CCFTN1 INSERT_PAGE" gsThis_cci_id giThis_line# giThis_page#
// 2019-12-12 end
   If ccilin.cci_id ne gsThis_cci_id Clear ccilin
   If ccimas.cci_id ne gsThis_cci_id Begin
      Clear ccimas
      Move gsThis_cci_id to ccimas.cci_id
      Find eq ccimas.cci_id
      [not Found] Begin
         @system_problem exit "Cant get back ccimas after insert line."
      End
   End
   @CHECK_GOSTART Goto end_program
   Move 0 to CURRENT_IMAGE
   @scroll_RESET_LIST POSITION ccilin.recnum
   gosub REFRESH_SCREEN
Goto start_list

//-------------------------------------
               CALL_PROGRAM_INSERT_LINE:
//-------------------------------------
// [NOT UPDATE_OK]      GOTO start_list
   If (not(gbUpdateOk)) Goto start_list  // 2019-03-19

   If (not(gmCcilin_insync(desktop))) Goto start_list

// @ask_ok_to "Insert a detail line PRIOR to this one (I/N) " "IN"
// [not @ok_chr] GOTO start_list


   Move ccilin.line# to giThis_line#
   Move ccilin.page# to giThis_page#

// 1. Call the function
// 2019-12-12
// @CALL_PROGRAM "CCFTN1 INSERT_LINE" gsThis_cci_id giThis_line# giThis_page#
   @CALL_PROGRAM_LOWERCASE "CCFTN1 INSERT_LINE" gsThis_cci_id giThis_line# giThis_page#
// 2019-12-12 end
   If ccilin.cci_id ne gsThis_cci_id Clear ccilin
   If ccimas.cci_id ne gsThis_cci_id Begin
      Clear ccimas
      Move gsThis_cci_id to ccimas.cci_id
      Find eq ccimas.cci_id
      [not Found] Begin
         @system_problem exit "Cant get back ccimas after insert line."
      End
   End
   READ_DFINI "DFINI23.CFG"   // 10/06/1998
   @CHECK_GOSTART Goto end_program
   Move 0 to CURRENT_IMAGE
   @scroll_RESET_LIST POSITION ccilin.recnum
   gosub REFRESH_SCREEN

// 2019-01-20
Goto start_list
//-------------------------------------
//          CALL_PROGRAM_REPLICATE_LINE:
                 CALL_PROGRAM_COPY_LINE:
//-------------------------------------
// [not UPDATE_OK]      Goto start_list
   If (not(gbUpdateOk)) Goto start_list // 2019-03-19

   If (not(gmCcilin_insync(desktop))) Goto start_list

   Move ccilin.line# to giThis_line#
   Move ccilin.page# to giThis_page#
   
String  gsOld_Ref_CciLn gsNew_Ref_CciLn  gsOld_ogd_group_auto
   Move (Ccilin.cci_id + Ccilin.ccil_id) to gsOld_Ref_CciLn
   
   
   // 2024-02-21
   String  gsB3line_Code
   Integer giB3line_B3line#   // n 4.0
   Integer giB3line_B3subh#   // n 4.0
   
   // 1. If CAD we need to create a new B3line code  (CadRule: 1 ccilin per b3line code)
   // 2024-03-29
   // If (gbIsCad) Begin
   If ((gbIsCad_All) or (gbIsCad_EnterCalc)) Begin
   // 2024-03-29 end 
      Get NewB3lineCode       to gsB3line_Code     
      Move Ccilin.b3line#     to giB3line_B3line#  
      Move Ccilin.subh#       to giB3line_B3subh#  
    
   End
   Else Begin
      Move Ccilin.b3line_code to gsB3line_Code     
      Move 0                  to giB3line_B3line#  
      Move 0                  to giB3line_B3subh#  
   End
   // Also of concern is the value of ccilin.b3line# and ccilin.subh# (maybe zero, set in GoRate) 
   
   
   // 2024-02-21 end
   // 2. Create the new line from existing.
   //      Move 0 to recnum and
   //      

   // 2. Add it
   indicate err False
   @lock ccilin ccimas ccship
   re$   ccilin
       Move Ccilin.ogd_group_auto to gsOld_ogd_group_auto
   re$   ccimas
   re$   ccship
      //    Move gsThis_cci_id  to ccilin.cci_id
      Move 0 to ccilin.recnum   // creates a new identical record
      Send creating     to (ccilin_ds(c_o))   // in ccds.pkg
                                              // sets ccilin.ccil_id     after incrementing ccimas.last_ccil_id
                                              //      ccilin.line# page# after incrementing ccimas.next_page#/line#
                                              //      ccilin.acr_uom     from ccimas.default_acr_uom
                                              //      ccilin.bacf#       from ccimas.bacf#
                                              //      ccilin.ogd_group_auto from ccship.ogd_auto_ynb   
                                              // save ccimas
      Send update       to (ccilin_ds(c_o))   // sets ccilin.quan/unit_decimals between 0 and 4
                                              //      ccilin.quan gmRound         
                                              //      ccilin.unit gmRound         
                                              //      ccimas.tot_diff tot_diff_vfcc
                                              //      ccimas.dcr_ctry_orig       
                                              //      ccilin.ctry_orig     if blank from ccimas.dcr_ctry_orig
                                              //      ccilin.curr        from ccimas.moa_total_curr
                                              //      ccimas.default_acr_uom from ccilin.acr_uom    
                                              //      ccimas.next_page# next_line#              
                                              // save ccimas
      Move gsOld_ogd_group_auto to ccilin.ogd_group_auto
      Move gsB3line_Code        to ccilin.b3line_code      // 2024-02-21
      Move giB3line_b3line#     to ccilin.b3line#          // 2024-02-21
      Move giB3line_b3subh#     to ccilin.Subh#            // 2024-02-21
   SaveRecord ccilin
   @unlock ccilin ccimas ccship
   [err] Begin
      @system_problem exit "Adding ccilin."
   End





   Move (Ccilin.cci_id + Ccilin.ccil_id) to gsNew_Ref_CciLn

   // 3. gfReplicate_CcXtraSw giBacf# gsOld_Ref_Cciln giBacf# giNew_Ref_Cciln 

   //@message Wait "2. Copy SwInfo_FromCciLine bacf# " giBacf# "  oldRef " gsOld_Ref_Cciln "  new ref " gsNew_Ref_Cciln

   Get Copy_CcXtraSw_To_CcXtraSw of oXtraSw giBacf# gsOld_Ref_CciLn giBacf# gsNew_Ref_CciLn (False) to gsOk255
   If (gsOk255 <> "OK") Begin
      @system_problem exit gsOk255
   End






   // 4. After show new line on list
   // @CALL_PROGRAM "CCFTN1 REPLICATE_LINE" gsThis_cci_id giThis_line# giThis_page#
   If ccilin.cci_id ne gsThis_cci_id Clear ccilin
   If ccimas.cci_id ne gsThis_cci_id Begin
      Clear ccimas
      Move gsThis_cci_id to ccimas.cci_id
      Find eq ccimas.cci_id
      [not Found] Begin
         @system_problem exit "Cant get back ccimas after insert line."
      End
   End

   // 2019-08-06   
   // 5. Update counts of CCI Lines (count#3)
    @GET_ZACTIV  

    @UPDATE_ZACTIV 3 1

   //   READ_DFINI "DFINI23.CFG"   // only if we call an oo program
   // @CHECK_GOSTART Goto end_program
   Move 0 to CURRENT_IMAGE
   @scroll_RESET_LIST POSITION ccilin.recnum
   gosub REFRESH_SCREEN
Goto start_list

#IFDEF EventMarkerNeverTrue
    Procedure POPUP
#ENDIF
//-------------------------------------
                                  POPUP:
//-------------------------------------
//    ENTRY ccilin.PART#         s_PART#         {capslock}
//    ENTRY ccilin.RATING_REC#   s_RATING_REC#
//    ENTRY ccilin.RATING_ITEM#  sh_rating_item#
//    ENTRY ccilin.HS#           sh_HS#
// VFD            // 2024-01-19
// B3Line Code
// Part#
// Rating Rec#
// HS#
// Tariff Treatment
// UOM
// UOM HS
// Country Origin
   #COMMAND PAGEALL 
      Move 0 to current_image
      Page screenLIST
      Page screenLISTend
      Page screenLINECODEdisplay
      // Page screenLINECODEdisplay2  //  2018-12-06
      Page screenENTER1  //  2019-06-14
      Page screenENTER2  //  2018-09-13
      Page screenENTER
   #ENDCOMMAND   
    // 2023-03-06
    // @D_SCREENS screenENTER screenENTER2 screenENTERcad screenENTER3
    @D_SCREENS screenENTER  screenENTER1 screenENTER2 screenENTERcad screenENTER3
    //at "POPUP  @d_window_name is " @d_window_name
    // Unit Price calc of Total
    If (@d_window_name = "S_AMOUNT") Begin
        Page screenENTER1popupUNITprice
        @message "Calculation of TOTAL using Unit Price. "
        more_s1u_uom:
        ACCEPT s1u_uom      {capslock}
        
        If (s1u_uom = "") Begin
            Move "" to s1u_uom_cwv
            Move "" to s1u_uom_descrip
        End
        Else Begin
            Clear uomiid 
            Move s1u_uom to uomiid.code
            Find eq uomiid by Index.1  // <Code>
            If (not(Found)) Begin 
                @errormsg "Unit of Measure is invalid"
                Goto more_s1u_uom
            End
            Move uomiid.type    to s1u_uom_cwv
            Move uomiid.descrip to s1u_uom_descrip
        End
        ACCEPT s1u_quantity 
        If (s1u_uom <> "") Begin
            If (s1u_uom_cwv  = "C") Begin
                Move s1u_quantity to s_cnt_quan_inv
                Move s1u_uom      to s_cnt_uom_inv 
            End
            If (s1u_uom_cwv  = "W") Begin
                Move s1u_quantity to s_wgt_quan_inv
                Move s1u_uom      to s_wgt_uom_inv 
            End
            If (s1u_uom_cwv  = "V") Begin
                Move s1u_quantity to s_vol_quan_inv
                Move s1u_uom      to s_vol_uom_inv 
            End
            PAGE screenENTER2
            PAGE screenENTER1popupUNITprice
        End
        ACCEPT s1u_price
        Move ((s1u_quantity * s1u_price) + 0.005) to s_amount
        Page screenENTER1
    End
    
    // 2023-03-06 end 
   If @d_window_name EQ "SC_OTHER_ACCEPT_RATE_TYPE" Begin
      Clear codetabl
      Move 109                        to codetabl.type
      Move  sc_Other_Accept_Rate_Type to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 109
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 109 OK_GOSUB SET_OTHER_ACCEPT_RATE_TYPE
      Page screenENTERcad
   End  
   If @d_window_name EQ "SC_DESTINATION_PROVINCE" Begin
      Clear codetabl
      Move 41                       to codetabl.type
      Move  sc_Destination_Province to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 41
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 41 OK_GOSUB SET_DESTINATION_PROVINCE
      Page screenENTERcad
   End  
   // CAD Addl Info Type G 1
   If @d_window_name EQ "SCS_SSS_ADDLINFO_STMTTYPE" Begin
     // 2024-01-25
     // Clear CadCode
     // Move "G1"               to CadCode.CadCodeType
     // Move scs_Sss_AddlInfo_StmtType to CadCode.code
     // Find GE CadCode by Index.1
     // [Found] indicate Found as CadCode.CadCodeType eq "G1"
     // [not Found] Find LT CadCodeType by Index.1
     // @CALL_POPUP "ALL" "CdCodeFi 3" 29 "G1" OK_MOVE CadCode.Code to scs_Sss_AddlInfo_StmtType
      @errormsg "No popup yet for Appendix G1"
     // 2024-01-25 end 
      Page screenENTERcad
   End
   // SIMA MifCode, Surtax Code, Safeguard Code
   Number gnCodetablType
   // 2025-01-19
   // If @d_window_name EQ "SCS_MIFCODE_SIMA_SURT_SAFE" Begin
   //                                      Move 101 to gnCodetablType
   //    If (scs_Sima_Surt_Safe_Mrf = "M") Move 101 to gnCodetablType  // SIMA Mif Code
   //    If (scs_Sima_Surt_Safe_Mrf = "R") Move 102 to gnCodetablType  // Surtax Code
   //    If (scs_Sima_Surt_Safe_Mrf = "F") Move 103 to gnCodetablType  // Safeguard Code 
   //    Clear codetabl
   //    Move gnCOdetablType             to codetabl.type
   //    Move scs_MifCode_Sima_Surt_Safe to codetabl.code
   //    Find GE codetabl by Index.1
   //    [Found] indicate Found as codetabl.type eq gnCodetablType
   //    [not Found] Find LT codetabl by Index.1
   //    @CALL_POPUP "ALL" "f#6fi2 3" 99 gnCodetablType OK_GOSUB SET_MIFCODE
   //    Page screenENTER3
   // End
   If @d_window_name EQ "SCS_SIMA_MIFCODE" Begin
      Clear codetabl
      Move 101               to codetabl.type
      Move  scs_Sima_MifCode to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 101
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 101 OK_GOSUB SET_SIMA_MIFCODE
      Page screenENTER3
   End    
   //If @d_window_name EQ "SCS_SURTAX_CODE" Begin
   If @d_window_name EQ c_popup_dmccil1_surtaxCode Begin   
      Clear codetabl
      Move 102              to codetabl.type
      Move  scs_Surtax_Code to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 102
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 102 OK_GOSUB SET_SURTAX_CODE      
      Page screenENTER3
   End    
   If @d_window_name EQ "SCS_SAFEGUARD_CODE" Begin
      Clear codetabl
      Move 103               to codetabl.type
      Move  scs_Safeguard_Code to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 103
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 103 OK_GOSUB SET_SAFEGUARD_CODE
      Page screenENTER3
   End    
   // 2025-01-19 end
   
   // 2025-01-20
   //++ If @d_window_name EQ "SCS_SSS_SUBJECTGOODS_STMTCODE" Begin
   //++    Clear codetabl
   //++    Move 104                            to codetabl.type
   //++    Move  scs_Sss_SubjectGoods_StmtCode to codetabl.code
   //++    Find GE codetabl by Index.1
   //++    [Found] indicate Found as codetabl.type eq 104
   //++    [not Found] Find LT codetabl by Index.1
   //++    @CALL_POPUP "ALL" "f#6fi2 3" 99 104 OK_GOSUB SET_SSS_SUBJECTGOODS
   //++    Page screenENTER3
   //++ End  
   If @d_window_name EQ "SCS_SIMA_SUBJECT_CODE" Begin
      Clear codetabl
      Move 104                   to codetabl.type
      Move  scs_Sima_Subject_Code to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 104
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 104 OK_GOSUB SET_SIMA_SUBJECT_CODE 
      Page screenENTER3
   End 
   If @d_window_name EQ "SCS_SURTAX_SUBJECT_CODE" Begin
      Clear codetabl
      Move 104                      to codetabl.type
      Move  scs_Surtax_Subject_Code to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 104
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 104 OK_GOSUB SET_SURTAX_SUBJECT_CODE 
      Page screenENTER3
   End 
   If @d_window_name EQ "SCS_SAFEGUARD_SUBJECT_CODE" Begin
      Clear codetabl
      Move 104                   to codetabl.type
      Move  scs_Safeguard_Subject_Code to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 104
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 104 OK_GOSUB SET_SAFEGUARD_SUBJECT_CODE
      Page screenENTER3
   End 
   // 2025-01-20 end
   If @d_window_name EQ "SCS_SIMA_CODE" Begin
      Clear codetabl
      Move 105            to codetabl.type
      Move  scs_Sima_Code to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 105
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 105 OK_GOSUB SET_SIMA_CODE
      Page screenENTER3
   End 
   // STB Quantity UOM's   All types CVW?  Only B3 (not inv or iid)
   If @d_window_name EQ "SCS_SIMA_STB_UOM" Begin
      Clear uomiid
      Move scs_Sima_Stb_Uom to uomiid.code
      Find GE uomiid by Index.1  //  <code>
      [not Found] Find LT uomiid by Index.1  //  <code>
      @CALL_POPUP "ALL"   "dmUomIF 3" 29 "CVW B3"  OK_MOVE uomiid.code to scs_Sima_Stb_Uom 
   End
   // If @d_window_name EQ "SCS_SURTAX_STB_UOM" Begin
   //    Clear uomiid
   //    Move scs_Surtax_Stb_Uom to uomiid.code
   //    Find GE uomiid by Index.1  //  <code>
   //    [not Found] Find LT uomiid by Index.1  //  <code>
   //    @CALL_POPUP "ALL"   "dmUomIF 3" 29 "CVW B3"  OK_MOVE uomiid.code to scs_Surtax_Stb_Uom 
   // End
   // If @d_window_name EQ "SCS_SAFEGUARD_STB_UOM" Begin
   //    Clear uomiid
   //    Move scs_Safeguard_Stb_Uom to uomiid.code
   //    Find GE uomiid by Index.1  //  <code>
   //    [not Found] Find LT uomiid by Index.1  //  <code>
   //    @CALL_POPUP "ALL"   "dmUomIF 3" 29 "CVW B3"  OK_MOVE uomiid.code to scs_Safeguard_Stb_Uom 
   // End
   // 
   If @d_window_name EQ "SCS_SIMA_INCO_TERM" Begin
      Clear codetabl
      Move 106                 to codetabl.type
      Move  scs_Sima_Inco_Term to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 106
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 106 OK_GOSUB SET_SIMA_INCO_TERM
      Page screenENTER3
   End     
   // CAD Excise G9
   // If @d_window_name EQ "SC_EXCISE_TAX_CODE" Begin
   //    Clear CadCode
   //    Move "G9"         to CadCode.CadCodeType
   //    Move sc_Excise_Tax_Code  to CadCode.code
   //    Find GE CadCode by Index.1
   //    [Found] indicate Found as CadCode.CadCodeType eq "G9"
   //    [not Found] Find LT CadCodeType by Index.1
   //    @CALL_POPUP "ALL" "CdCodeFi 3" 29 "G9" OK_MOVE CadCode.Code to sc_Excise_Tax_Code
   //    Page screenENTERcad
   // End
  If @d_window_name EQ "SC_EXCISE_TAX_CODE" Begin 
      Clear codetabl
      Move 108                 to codetabl.type
      Move  scs_Sima_Inco_Term to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 108
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 108 OK_GOSUB SET_EXCISE_TAX_CODE 
      Page screenENTERcad
   End     
   //+ 2024-01-02 end
     
   // CAD GST G10
   If @d_window_name EQ "SC_GST_CODE" Begin
     // 2024-01-25
     // Clear CadCode
     // Move "G10"       to CadCode.CadCodeType
     // Move sc_Gst_Code to CadCode.code
     // Find GE CadCode by Index.1
     // [Found] indicate Found as CadCode.CadCodeType eq "G10"
     // [not Found] Find LT CadCodeType by Index.1
     // @CALL_POPUP "ALL" "CdCodeFi 3" 29 "G10" OK_MOVE CadCode.Code to sc_Gst_Code
     //+ 2024-02-20
     //+ @errormsg "No popup for GST Code Appendix G10"
     //+ // 2024-01-25 end
     @CALL_POPUP "ALL" "f#54new" 0  0  OK_MOVE gstrate.ref# to sc_gst_code  
     //+ 2024-02-20 end
      Page screenENTERcad
   End
   // CAD GST G10
   If @d_window_name EQ "SC_OIC_CODE" Begin
      Clear Oic
      Move sc_Oic_Code     to Oic.code
      Move sc_Oic_Sub_Code to Oic.sub_code
      Find GE Oic by Index.1  // <Code_Ref>
      @CALL_POPUP "ALL" "f#14" 0 0 OK_GOSUB SET_OIC                         
      Page screenENTERcad
      @emessage2 ""
   End
   If @d_window_name EQ "SC_OIC_SUB_CODE" Begin
      Clear Oic
      Move sc_oic_sub_code to oic.sub_code
      Move sc_Oic_Code     to Oic.code
      Find GE Oic by Index.1  // <Code_Ref>
      @CALL_POPUP "ALL" "f#14" 0 0 OK_GOSUB SET_OIC                       
      Page screenENTERcad
      @emessage2 ""
   End
// Deduction Amount Currency                                       
   If @d_window_name EQ "SCS_SIMA_DEDN_CURR" Begin
      Clear Currency
      Move scs_Sima_Dedn_Curr to Currency.code
      Find GE Currency by Index.1  //  <code>
      [not Found] Find LT Currency by Index.1  //  <code>
      @CALL_POPUP "ALL"   "f#34fi" 3 29 OK_MOVE Currency.code to scs_Sima_Dedn_Curr
   End
   // 2024-01-02
   // Deduction Amount Currency                                       
   If @d_window_name EQ "SCS_ITEMCHGAMT_CURR" Begin
      Clear Currency
      Move scs_ItemChgAmt_Curr to Currency.code
      Find GE Currency by Index.1  //  <code>
      [not Found] Find LT Currency by Index.1  //  <code>
      @CALL_POPUP "ALL"   "f#34fi" 3 29 OK_MOVE Currency.code to scs_ItemChgAmt_Curr
   End
   // 2024-01-02 end

     // 2018-04-03
     // PgaQA
     If (@d_window_name = "S_PGAQA_LIST") Begin
//     @CALL_FUNCTION "QALIST=" IN "dmqafi" WITH (trim(s_pgaqa_list))
       @CALL_FUNCTION "QALIST=" IN "dmqafi" WITH (trim(gsPgaQaList))   // 2020-04-30
       PAGEALL
       If (@return_code = "Y") Begin
           Move @return_str to s_pgaqa_list
           Move @return_str to gsPgaQaList  // 2020-04-30
       End 
     End
// 2018-04-03 end


// B3 Line Code
   If @d_window_name EQ "S_B3LINE_CODE" Begin
      @CALL_POPUP "ALL" "zmlnfi3 0  0 "  giBacf# s_cci_id ;
                                  OK_MOVE b3line.b3line_code to s_b3line_code
      page screenLIST
      page screenLISTend
      page screenENTER1    // 2019-06-14
      page screenENTER2    // 2018-09-13

      @CHECK_GOSTART
   // send gmExit_b3line_code to desktop
      Send gmSet_b3lc_status to desktop
//         ----------------------------
//           giTyp_b3lc CHG   CODE
//                 1.   No    Blank
//                 2.   No    Existing
//                 3.   Yes   Blank
//                 4.   Yes   New
//                 5.   Yes   Existing
//           giBad_b3lc  2/5.   if from another cci
//         ----------------------------

      If  giTyp_b3lc eq 5 Begin  // Code has changed and we are using an existing code
                                 // This happens:
                                 //    on a  new      ccilin where we pick an existing B3line code
                                 // or on an existing ccilin where we change the code
// 2018-04-05
         If (b3line.pga_auto <> "") Begin
            Move b3line.pga_auto     to s_pga_auto
            Move b3line.pgaPgm_List  to s_pgaPgm_List      
           //-+- Move b3line.pgaQA_List   to s_pgaQA_List       
           //-+- Move b3line.pgaQA_List   to gsPgaQaList   // 2020-04-30
           //-+- Move b3line.pgaQA_Status to s_pgaQA_Status     
            Move b3line.sima         to s_sima 
         End
         SHOW_PGA   //  sets HI and LO   
// 2018-04-05 end
       End

      If (giTyp_b3lc eq 2 or giTyp_b3lc eq 5) Begin
         Send gmDisplay_b3lc_main     // on the main entry screen   Dmccil1.pkg  
         Send gmDisplay_b3lc_addl     // screen under the list                   
      End
      If (giBad_b3lc) Begin   // bad
         @errormsg# 8001 ;
                  "This Line code is used by another CCI on this BACF"
      End
   End

// Part#
   If @d_window_name EQ "S_PART#" Begin
      If (giNewline_added) Move s_Part# to sop_orig_new_part# // 2019-06-26
      Send mPopup_part# to oRrec_info.obj s_part#
      Gosub BacfMustBe_GiBacf#   // 2020-08-20
      Send gmExit_done_rrec  to desktop   // redisplay screen and display new values
      Page screenENTER2  // 2019-06-14
      Page screenENTER1  // 2019-06-14
   End

// Rating Rec#
   If @d_window_name EQ "S_RATING_REC#" Begin
      Send mPopup_rrec# to oRrec_info.obj s_rating_rec#
      Gosub BacfMustBe_GiBacf#   // 2020-08-20
      Send gmExit_done_rrec  to desktop   // redisplay screen and display new values
      Page screenENTER2  // 2019-06-14
      Page screenENTER1  // 2019-06-14
   End

// HS Code
   If @d_window_name EQ "SH_HS#" Begin
      Send mPopup_hscode to oRrec_info.obj sh_HS#
      Send gmExit_done_rrec   to desktop   // redisplay screen and display new values
      Page screenENTER2  // 2019-06-14
      Page screenENTER1  // 2019-06-14
   End

// Tariff Treatment
   If @d_window_name EQ "S_TAR_TREAT" Begin
      Clear codetabl
      Move 9           to codetabl.type
      Move s_tar_treat to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 9
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi 3" 99 "9" OK_GOSUB SET_TAR_TREAT
      Page screenENTER2  //  2018-09-13
      Page screenENTER1  //  2019-06-14
   End
   // 2024-01-19
   // VFD - Value For Duty Code
   If @d_window_name EQ "S_VFD" Begin
      Clear codetabl
      Move 107         to codetabl.type
      Move s_vfd       to codetabl.code
      Find GE codetabl by Index.1
      [Found] indicate Found as codetabl.type eq 107
      [not Found] Find LT codetabl by Index.1
      @CALL_POPUP "ALL" "f#6fi2 3" 99 "107" OK_MOVE codetabl.code to s_vfd
      Page screenENTER2  //  2018-09-13
      Page screenENTER1  //  2019-06-14
   End
   // 2024-01-19 end
// Country Origin
   If @d_window_name EQ "S_CTRY_ORIG" Begin
      Clear scountry
      Move S_CTRY_ORIG to scountry.code
      Find GE scountry.code
      [not Found] Find LT scountry.code
      @CALL_POPUP "ALL"   "f#36fi"  0 99  OK_GOSUB SET_COUNTRY_ORIGIN
      Page screenENTER2  //  2018-09-13      
      Page screenENTER1  //  2019-06-14      
   End
// Quantity UOM's
   If @d_window_name EQ "S_CNT_UOM_INV" Begin
      Clear uomiid
      Move s_cnt_uom_inv to uomiid.code
      Find GE uomiid by Index.1  //  <code>
      [not Found] Find LT uomiid by Index.1  //  <code>
      //@CALL_POPUP "ALL"   "dmUomIF 3" 99 "C"  OK_GOSUB SET_CNT_UOM_INV
      @CALL_POPUP "ALL"   "dmUomIF 3" 99 "C INV"  OK_GOSUB SET_CNT_UOM_INV  // 2021-03-30
   End
   If @d_window_name EQ "S_CNT_UOM_IID" Begin
      Clear uomiid
      Move s_cnt_uom_iid to uomiid.code
      Find GE uomiid by Index.1  //  <code>
      [not Found] Find LT uomiid by Index.1  //  <code>
      //@CALL_POPUP "ALL"   "dmUomIF 3" 99 "C"  OK_GOSUB SET_CNT_UOM_IID
      @CALL_POPUP "ALL"   "dmUomIF 3" 99 "C IID"  OK_GOSUB SET_CNT_UOM_IID  // 2021-03-30
   End
   If @d_window_name EQ "S_WGT_UOM_INV" Begin
      Clear uomiid
      Move s_wgt_uom_inv to uomiid.code
      Find GE uomiid by Index.1  //  <code>
      [not Found] Find LT uomiid by Index.1  //  <code>
      //@CALL_POPUP "ALL"   "dmUomIF 3" 99 "W"  OK_GOSUB SET_WGT_UOM_INV
      @CALL_POPUP "ALL"   "dmUomIF 3" 99 "W INV"  OK_GOSUB SET_WGT_UOM_INV  // 2021-03-30
   End
   If @d_window_name EQ "S_WGT_UOM_IID" Begin
      Clear uomiid
      Move s_wgt_uom_iid to uomiid.code
      Find GE uomiid by Index.1  //  <code>
      [not Found] Find LT uomiid by Index.1  //  <code>
      //@CALL_POPUP "ALL"   "dmUomIF 3" 99 "W"  OK_GOSUB SET_WGT_UOM_IID
      @CALL_POPUP "ALL"   "dmUomIF 3" 99 "W IID"  OK_GOSUB SET_WGT_UOM_IID   // 2021-03-30
   End
   If @d_window_name EQ "S_VOL_UOM_INV" Begin
      Clear uomiid
      Move s_vol_uom_inv to uomiid.code
      Find GE uomiid by Index.1  //  <code>
      [not Found] Find LT uomiid by Index.1  //  <code>
      //@CALL_POPUP "ALL"   "dmUomIF 3" 99 "V"  OK_GOSUB SET_VOL_UOM_INV
      @CALL_POPUP "ALL"   "dmUomIF 3" 99 "V INV"  OK_GOSUB SET_VOL_UOM_INV  // 2021-03-30
   End
   If @d_window_name EQ "S_VOL_UOM_IID" Begin
      Clear uomiid
      Move s_vol_uom_iid to uomiid.code
      Find GE uomiid by Index.1  //  <code>
      [not Found] Find LT uomiid by Index.1  //  <code>
      //@CALL_POPUP "ALL"   "dmUomIF 3" 99 "V"  OK_GOSUB SET_VOL_UOM_IID
      @CALL_POPUP "ALL"   "dmUomIF 3" 99 "V IID"  OK_GOSUB SET_VOL_UOM_IID  // 2021-03-30
   End
   @EMESSAGE2 ""
   ENTAGAIN
RETURN 

// 2016-09-21 end
// 2025-01-19

// 2019-03-19
Procedure pSet_gbUpdateOk Integer iBacf#
// 1. zero bacf is invalid
   If (iBacf# = 0) Begin
      Move (False) to gbUpdateOk
      Procedure_Return
   End

// 2. Check we have the right bacfstat. If not get it. 
   If (bacfstat.bacf# <> iBacf#) Begin
      Clear bacfstat
      Move iBacf# to bacfstat.bacf#
      Find eq bacfstat by Index.1  // <bacf#>
      If (not(Found)) Begin
      //   Move (False) to gbUpdateOk
      //   Procedure_Return
         @system_problem exit "Unable to find bacfstat for bacf# " iBacf# 
      End
   End
// 2020-03-25
// 3. Check we have the right bacf. If not get it. 
   If (bacf.bacf# <> iBacf#) Begin
      Clear bacf
      Move iBacf# to bacf.bacf#
      Find eq bacf by Index.1  // <bacf#>
      If (not(Found)) Begin
      //   Move (False) to gbUpdateOk
      //   Procedure_Return
         @system_problem exit "pSet_gbUpdateOk: Unable to find bacf for bacf# " iBacf# 
      End
   End

// 4. Cci cannot be locked
   Clear proctype
   Move bacf.sub_type to proctype.type 
   Find eq proctype by Index.1  // <type>
   If (not(Found)) Begin
        @system_problem exit "pSet_gbUpdateOk: Unable to find bacf sub type [" bacf.sub_type ;
                              "] in proctype table"
   End
 //  Move (proctype.code_R = "Y") to gbCciLocked  // 2020-04-28 Now in am.cmd
   If (gbCciLocked) Begin
      Move (False) to gbUpdateOk
      Procedure_Return
   End
// 2020-03-25 end

// 5. Check for parameter NO_UPDATE
   Move (param1 <> "NO_UPDATE")               to gbUpdateOk

// 6. Finally check bacfstat.status_op 
   re$ bacfstat
   If (bacfstat.status_op >= 10) Move (False) to gbUpdateOk
End_Procedure
// 2019-03-19 end


Object oPgaInfo is an Array //2025-05-02 KRC Organization, No unbounded procedures or functions

   //2025-05-02 KRC: Renamed From gmDisplay_Pga1Info 
   Procedure DisplayPga1Info String sPgmList 
      // Program List 8 x 51 char lines screenPGA1 AT 11 28
      local Integer iItem bGotItem
      local String  sPgm  sTitle
      screenmode @colour_LO ON
      blankform screenPGA1
      PAGE screenPGA1
      screenmode @colour_HI ON
      Move (Trim(sPgmList)) to sPgmList
      If (sPgmList = "") Procedure_Return

      Move 0 to iItem
      Repeat
         GET_DATA_ELEMENT sPgmList iItem "|" to sPgm   //  in edlib009.pkg
         Move (Trim(sPgm)) to sPgm
         Move (sPgm <> "") to bGotItem
      // 2.1 Get each item in sPgmList and show full description from HsPgaPgm
         If (bGotItem) Begin
            Move iItem to WindowIndex
            Clear hsPgaPgm
            Move sPgm to hsPgaPgm.Id_DataEntryKey
            Find eq HsPgaPgm by Index.2  //  <Id_DataEntryKey>
            If (Found) Move (sPgm + " - " + hsPgaPgm.Title) to sp1_Line1&
            Else       Move  sPgm                           to sp1_Line1&
            Add 1 to iItem
            If (iItem = 8) Begin 
               Move (Trim(sp1_Line1&) + " ..more..........") to sp1_Line1&
               Move (False) to bGotItem
            End
         End    
      Until (not(bGotItem))
   End_Procedure

   Procedure DisplayPga2Info String sQaList //former: gmDisplay_Pga2Info 2025-05-02 KRC
      // Q&A List 4 x 78 char lines screenPGA2 AT 18 0
      local Integer iItem bGotItem  bGotQ  bGotA
      local String  sQa  sQ  sA  sLine
      screenmode @colour_LO ON
      blankform screenPGA2
      screenmode @colour_HI ON
      PAGE screenPGA2
      Move (Trim(sQaList)) to sQaList
      If (sQaList = "") Procedure_Return
   
      Move 0 to iItem
      Repeat
         GET_DATA_ELEMENT sQaList iItem "|" to sQa   //  in edlib009.pkg
         GET_DATA_ELEMENT sQa     0     "=" to sQ    //  in edlib009.pkg
         GET_DATA_ELEMENT sQa     1     "=" to sA    //  in edlib009.pkg
         Move (Trim(sQ)) to sQ
         Move (Trim(sA)) to sA
         Move (sQ <> "") to bGotItem
         // 1. Get each item in sQaList and show full description from HsPgaPgm   
         If (bGotItem) Begin // 2020-04-30  
            If (iItem = 4) Begin  // Line 5
               Move (Trim(sp2_Line1&) + " ..more..........") to sp2_Line1&
               Move (False) to bGotItem
            End
         End // 2020-04-30 end         
         If (bGotItem) Begin
            Move iItem to WindowIndex
            // 1.1. Question
            Clear SwQuestn
            Move sQ to SwQuestn.Code
            Find gt SwQuestn by Index.2  //  <Code> <Idn>    
            Move (Found) to bGotQ          
            If (bGotQ) Move (SwQuestn.code = sQ) to bGotQ
            If (bGotQ) Begin
               Move (sQ + " (" + (trim(SwQuestn.Description)) + ")") to sLine
               // 1.2 Answer          
               Clear SwAnswer
               Move SwQuestn.Idn to SwAnswer.SwQuestn_Idn
               Move sA           to SwAnswer.Code
               Find gt SwAnswer by Index.2  //  <SwQuestn_Idn> <Code> <Idn>
               Move (Found) to bGotA
               If (bGotA) Move (SwAnswer.SwQuestn_Idn = SwQuestn.Idn) to bGotA
               If (bGotA) Move (SwAnswer.Code         = sA)           to bGotA
               If (bGotA) Begin
                  Move (sLine + " = " + sA + " (" + (trim(SwAnswer.Description)) + ")") to sLine
               End
            End   
            Else begin
               Move (sQ + " ???") to sLine
               Move (False) to bGotA
            End
            Move sLine to sp2_Line1&
            Add 1 to iItem
            // 2020-04-30
            //        If (iItem = 4) Begin   // Line 5
            //           Move (Trim(sp2_Line1&) + " ..more..........") to sp2_Line1&
            //           Move (False) to bGotItem
            //        End
            // 2020-04-30 end
         End    
      Until (not(bGotItem))
   End_Procedure 

   // 2019-01-19 JAC: Created
   // 2025-05-02 KRC: Renamed from gmProcessIdTitle
   // 2025-05-02 KRC: Appears unused.
   // 2025-05-07 KRC: It Is Used to Set the Proc Id in the PgaInfo screen
   Function SwProcessIdTitle String sId Returns String
      If (sId = "") Begin
         Function_Return ""
      End
      Clear SwProcId
      Move sId to SwProcId.Id
      Find eq SwProcId by Index.1  //  <Id>
      If (Found) Function_Return SwProcId.title
      Else       Function_Return "ID Invalid"
   End_Function    

   // 2018-04-11 Start
   // 2025-05-02 KRC: Renamed from gmOutputPgaScn
   // 2025-05-02 KRC: Appears unused.
   Procedure OutputPgaScn String sFolderName String sFilenameExtra
   // Real handy for debugging output compared to dmPgaR1.src calc test program F1-G  
   
      Local String sFullname sFilename sFolderName2
      If (zRun.Zc_Path_Textfil <> "") Begin
         Move zRun.Zc_Path_Textfil to sFolderName2
      End 
      Else Begin
         Move "c:\temp\" to sFolderName2
      End
      If (sFolderName = "") Begin
         Move sFolderName2   to sFolderName      
      End 
      Move (Trim(sFolderName))                  to sFolderName
      Move ("PgaScn" + sFilenameExtra + ".txt") to sFilename
      Move (sFolderName + sFilename) to sFullname
      Direct_Output sFullname
      Writeln "================== PgaPgmInfo ======================"
      Output PgaPgmInfo
      
      Writeln "================== PgaQA ==========================="
      Output PgaQA
      
      Writeln "================== HsPgmCod_OneHSCode =============="
      Output HsPgmCod_OneHSCode

      Close_Output
      Runprogram Background "notepad.exe" sFullname  // returns after notepad is loaded
   End_Procedure

End_Object      




 
 


// 2019-11-08
Function gfCompareStrings Global String s1 String s2 String sOrder Returns String //  EQ LT GT
   //  sOrder is "01234567890aAbBcCdDeEfFgGhHiIjJkKlLmMnNoOpPqQrRsStTuUvVwWxXyYzZ" 
     local Integer iLen1  iLen2 iLen  i 
    
     local Integer iPos1  iPos2
       Move (Length(s1)) to iLen1
       Move (Length(s2)) to iLen2
       If (iLen1 < iLen2) Move iLen1 to iLen
       Else               Move iLen2 to iLen

       If (s1 = s2) Function_Return "EQ"    
       For i from 1 to iLen
           Move (Pos(Mid(s1, 1, i), sOrder)) to iPos1
           Move (Pos(Mid(s2, 1, i), sOrder)) to iPos2
           If (iPos1 < iPos2) Function_Return "LT"
           If (iPos1 > iPos2) Function_Return "GT"
       Loop
       Function_Return "EQ"
End_Function
// 2019-11-08 end 

// 2021-05-03 
// 104 - Count  (Number of cases eg 2)
// 114 - Number of units per package (eg 5)
// 115 - Unit weight  (10 
// 105 - Weight 100
// 116 - Unit of Measure (eg LBS)

Function AppendWarnStopToValueCoded_Line String sValueCoded String sValueText Returns String
    String sReturn_ValueText sWeightUomInv sUom
    // 2021-05-06
    //Integer iValueText iCount iWeight
    Number nValueText nCount nWeight
    // 2021-05-06 end
    Number  nConvert
    Move sValueCoded to sReturn_ValueText
    Move Ccilin.cnt_quan_iid to nCount
    Move Ccilin.wgt_quan_iid to nWeight
    Move Ccilin.wgt_uom_inv  to sWeightUomInv
    // 104 - Count quantity
    If (sValueCoded = "104") Begin
        Move sValueText to nValueText
        If (nValueText <> nCount) Move (trim(sValueCoded) + "-WARN") to sReturn_ValueText
    End
    // 2021-05-06 Usually Overwritten by AppendWarnStop105
    // 105 - Weight Quantity
    If (sValueCoded = "105") Begin
        Move sValueText to nValueText
        If (nValueText <> nWeight) Move (trim(sValueCoded) + "-WARN") to sReturn_ValueText
    End
    // 116 - Weight Uom
    If (sValueCoded = "116") Begin
        Move (uppercase(trim(sValueText))) to sUom
        If (sUom = sWeightUomInv)               Function_Return (trim(sValueCoded) + "-OK")
        // 116.2 Must be convertible to an INV uom
        //Move (Convert_uomiid(ghoI20, sUom, sWeightUomInv)) to nConvert // cI20.pkg
        //If (nConvert <> 0) Function_Return (trim(sValueCoded) + "-OKcvt")
        If (Convert_uomiid(ghoI20, sUom, sWeightUomInv) <> 0) Function_Return (trim(sValueCoded) + "-OKcvt")
        // If not then its a Warning
        Function_Return (trim(sValueCoded) + "-WARN")
    End
    
    Function_Return sReturn_ValueText
End_Function   

Procedure AppendWarnStop105 Integer i105Line Number n105Converted Number nCcilinWgt
    Number nDiff  nDiffPercent nCcilinWgtAbs
    String s105
    // As determined by CBrown 2021-05-04
    SETWINDOWINDEX_SW i105Line
    Move (n105Converted - nCcilinWgt)         to nDiff
    If (nDiff < 0) Move (0 - nDiff)           to nDiff
    If (nCcilinWgt > 0) Move nCcilinWgt       to nCcilinWgtAbs
    Else                Move (0 - nCcilinWgt) to nCcilinWgtAbs
    Move (nDiff / nCcilinWgtAbs * 100.0)      to nDiffPercent
    //at ("105 [" + sw_value_coded& + "] WeightAbs [" + (String(nCcilinWgtAbs)) +  "] Diff [") nDiff "] Diff% [" nDiffPercent "]"
    // 1. CcilinWeight is Zero - WARN
    If (nCcilinWgt = 0) Begin
        Move "105-WARN" to sw_value_coded&
        Procedure_Return
    End
    Move "105" to sw_value_coded&
    // 2. Diff Zero - all is well
    If (n105Converted = nCcilinWgt) Procedure_Return 
    
    // 3. Weight up to 100
    If (nCcilinWgtAbs <= 100) Begin
        If (nDiffPercent > 10) Move "105-WARN%" to sw_value_coded&
        If (nDiffPercent > 20) Move "105-STOP%" to sw_value_coded&
        Procedure_Return
    End
    
    // 4. Weight over 100
    Else Begin
        If (nDiff > 10)  Move "105-WARN" to sw_value_coded&
        If (nDiff > 100) Move "105-STOP" to sw_value_coded&
        Procedure_Return
    End
End_Procedure
// 2021-05-03 end

                                                              Send gmRecalc_values_quantity_cnt
                                                              [key.down] Goto scr_cnt_end                    
//                                                           [key.up]   Goto scr_cnt                    
// 2019-02-01 
//not enter_gac] ENTRY ccilin.cnt_uom_iid       s_cnt_uom_iid      {forceput, capslock}   // sometimes 
        ENTRY ccilin.cnt_uom_iid       s_cnt_uom_iid      {forceput, capslock}   // all the time
// 2019-02-01 end
                                                               Send gmRecalc_values_quantity_cnt

scr_cnt_end:
        ENTRY ccilin.cnt_uom_cvt_iid   s_cnt_uom_cvt_iid      {forceput, noenter}
        ENTRY ccilin.cnt_quan_iid      s_cnt_quan_iid         {forceput, noenter}
        ENTRY ccilin.cnt_uom           s_cnt_uom              {forceput, noenter}
        ENTRY ccilin.cnt_uom_ok        s_cnt_uom_ok           {forceput, noenter}
        ENTRY ccilin.cnt_quan          s_cnt_quan             {forceput, noenter}

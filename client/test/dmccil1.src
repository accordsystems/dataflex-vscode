//not enter_gac] ENTRY ccilin.wgt_uom_iid       s_wgt_uom_iid      {forceput, capslock}   // sometimes 
        ENTRY ccilin.wgt_uom_iid       s_wgt_uom_iid      {forceput, capslock}   // all the time
// 2019-02-01 end
                                                              Send gmRecalc_values_quantity_wgt
scr_wgt_end:
        ENTRY ccilin.wgt_uom_cvt_iid   s_wgt_uom_cvt_iid      {forceput, noenter}
        ENTRY ccilin.wgt_quan_iid      s_wgt_quan_iid         {forceput, noenter}
        ENTRY ccilin.wgt_uom           s_wgt_uom              {forceput, noenter}
        ENTRY ccilin.wgt_uom_ok        s_wgt_uom_ok           {forceput, noenter}
        ENTRY ccilin.wgt_quan          s_wgt_quan             {forceput, noenter}
scr_vol:
        ENTRY ccilin.vol_quan_inv      s_vol_quan_inv     {forceput}                          
                                                              Send gmRecalc_values_quantity_vol
                                                              [key.down] Goto scr_vol_end                       
        ENTRY ccilin.vol_uom_inv       s_vol_uom_inv      {forceput, capslock}                
                                                              Send gmRecalc_values_quantity_vol
                                                              [key.down] Goto scr_vol_end                       
// 2019-02-01 
//not enter_gac] ENTRY ccilin.vol_uom_iid       s_wgt_uom_iid      {forceput, capslock}   // sometimes 
        ENTRY ccilin.vol_uom_iid       s_vol_uom_iid      {forceput, capslock}   // all the time
// 2019-02-01 end

                                                              Send gmRecalc_values_quantity_vol
  
scr_vol_end:                                                       
        ENTRY ccilin.vol_uom_cvt_iid   s_vol_uom_cvt_iid      {forceput, noenter}
        ENTRY ccilin.vol_quan_iid      s_vol_quan_iid         {forceput, noenter}
        ENTRY ccilin.vol_uom           s_vol_uom              {forceput, noenter}
        ENTRY ccilin.vol_uom_ok        s_vol_uom_ok           {forceput, noenter}
        ENTRY ccilin.vol_quan          s_vol_quan             {forceput, noenter}
   
// 2018-10-09 end    

    Send gmDisplay_all_values
    Send gmSet_Recalc_All

RETURN

#IFDEF TitleMarkerNeverTrue
Property String ENTER1.PRESAVE
#ENDIF

ENTER1.PRESAVE:
 // 2019-03-19
 //       GOSUB REFRESH_UPDATE_OK
 //       [NOT UPDATE_OK] BEGIN
 
 // 0. Set gbUpdateOk (not rating finished)
 Send pSet_gbUpdateOk giBacf#
 If (not(gbUpdateOk)) Begin
 // 2019-03-19 end
    IF bacfstat.status_op GE 10 BEGIN
       @ERRORMSG "Updates not allowed - already rating finished."
    END
    Else Begin
       // 2023-09-19
       // @ERRORMSG "Updates not allowed."
       If (gbCciLocked) Begin
           @errormsg "Updates not allowed. Cci is locked, never updateable. (Proctype R is Y)"
       End
       Else Begin
          @ERRORMSG "Updates not allowed. gbUpdateOk set in am.cmd is false"
       End 
       // 2023-09-19 end
    End
    INDICATE ERR TRUE
    RETURN
 END
 // 0.1 Not New_Record here
 [@NEW_RECORD] Begin
    @ERRORMSG "To add a new LINE, hit <F9> from the LIST."
    INDICATE ERR TRUE
    RETURN
 END

 // 1. Minimum if RMD is desc1, quan and uom
 if s_desc1 eq "" begin
    @errormsg "The 1st line of the description must always be entered"
    indicate err true
    return
 End
// at3 "[ENTER1.PRESAVE] giTyp_b3lc [" giTyp_b3lc ("] b3line.vfd [" + b3line.vfd + "] s_vfd [" + s_vfd + "]")

 send gmSet_b3lc_status to desktop
 //   ----------------------------
 //     giTyp_b3lc CHG   CODE
 //           1.   No    Blank
 //           2.   No    Existing
 //           3.   Yes   Blank
 //           4.   Yes   New
 //           5.   Yes   Existing
 //     giBad_b3lc  2/5.   if from another cci
 //   ----------------------------
 // aT this point, only 2 and 5 are allowed if giBad_b3lc is false

 if (giTyp_b3lc eq 2 or giTyp_b3lc eq 5) begin
    send gmDisplay_b3lc_main
    send gmDisplay_b3lc_addl
 end
 if (giBad_b3lc) begin   // bad
    @errormsg# 8003 ;
             "This Line code is used by another CCI on this BACF"
    indicate err true
    return
 End
 
 Get gfPgaCodeList_From_PgaPgmList of oSwInfo s_pgapgm_list to gsPgaCodeList  // 2018-08-17  cSwInfo.pkg
 // at "gsPgaCodeList is [" gsPgaCodeList "]"
 //     bad things that should never happen
 If  (giTyp_b3lc eq 1 or giTyp_b3lc eq 3) Begin
    @system_problem# 8004 exit ;
             "B3 Line Code cannot be blank at this point"
 end

 if  giTyp_b3lc eq 4 begin
    @system_problem# 8005 exit ;
             "Cannot find B3 line code [" ;
              s_b3line_code "]"
 end

 // 2018-10-10
 // 5. Quantity check
 Send gmRecalc_values_quantity  // in dmccil1.pkg
 If ((s_cnt_uom_cvt_iid = "NO") or ;
     (s_wgt_uom_cvt_iid = "NO") or ;
     (s_vol_uom_cvt_iid = "NO") ) Begin
       @errormsg# 8004 "Cvt (Convert) flag is NO. Problem converting Unit of Measure" 
      //        indicate err True
      //        return
 End
 If ((s_cnt_uom_cvt_iid = "nf") or ;
     (s_wgt_uom_cvt_iid = "nf") or ;
     (s_vol_uom_cvt_iid = "nf")) Begin
       @errormsg# 8004 "Cvt (Convert) flag is nf (Not Found). UoM code is invalid" 
       //        indicate err True
       //        return
 End
 // 2018-10-10 end
// at3 "[Before Backout] giTyp_b3lc [" giTyp_b3lc ("] b3line.vfd [" + b3line.vfd + "] s_vfd [" + s_vfd + "]")

 // 6. Do the backout here, prior to the record buffer being updated
 // Not quite right, but ...
 indicate err False
 @lock ccship ccimas
 re$   ccship
 re$   ccimas
    send backout          to (ccilin_ds(c_o))   // does save ccimas
    send backout          to (ccimas_ds(c_o))   // does save ccship
    send backout          to (ccship_ds(c_o))   // no save reqd
 @unlock ccship ccimas
 [err] begin
    @system_problem exit "Updating ccilin - backout prior to update"
 end

// at3 "[After Backout] giTyp_b3lc [" giTyp_b3lc ("] b3line.vfd [" + b3line.vfd + "] s_vfd [" + s_vfd + "]")

 FILE_MODE ccilin DEFAULT
 FILE_MODE ccimas DEFAULT
 FILE_MODE ccship DEFAULT
 indicate err false
RETURN


#IFDEF TitleMarkerNeverTrue
Property String ENTER1.Save
#ENDIF

ENTER1.SAVE:
 // at3 "[ENTER1.SAVE] giTyp_b3lc [" giTyp_b3lc ("] b3line.vfd [" + b3line.vfd + "] s_vfd [" + s_vfd + "]")

    [err] RETURN
    Move sop_orig_new_part# to ccilin.orig_new_part#  // 2019-06-26         
    // 2018-04-04
    // 1. PGA info
    //       Move s_pgaqa_list   to ccilin.PgaQa_List
    // 2024-08-26
    Move (Trim(s_pgapgm_list)) to s_pgapgm_list
    If (Left(s_pgapgm_list, 1) = "|") Begin
        Move (right(s_pgapgm_list, ((length(s_pgapgm_list)) - 1))) to s_pgapgm_list    
    End    
    // 2024-08-26 end
    Move gsPgaQaList    to ccilin.PgaQa_List   // 2020-04-30
    Move s_pgaqa_status to ccilin.PgaQa_Status
    Move s_pgapgm_list  to ccilin.PgaPgm_List
    Move s_sima         to ccilin.Sima        
    Move gsPgaCodeList  to ccilin.PgaCode_List   // 2018-08-17
    // 2018-04-04 end
    // 2019-02-01
    //       [enter_gac] Move s_cnt_uom_iid to ccilin.cnt_uom_iid   // 2018-10-09
    //       [enter_gac] Move s_wgt_uom_iid to ccilin.wgt_uom_iid   // 2018-10-09
    //       [enter_gac] Move s_vol_uom_iid to ccilin.vol_uom_iid   // 2018-10-09
    // 2. UOM IID info
    Move s_cnt_uom_iid to ccilin.cnt_uom_iid   // 2018-10-09
    Move s_wgt_uom_iid to ccilin.wgt_uom_iid   // 2018-10-09
    Move s_vol_uom_iid to ccilin.vol_uom_iid   // 2018-10-09 // 2019-02-01 end
    // 2019-02-25
    // 2019-05-07
    //          Move s_cnt_uom_inv to gsPrev_cnt_uom_inv
    //          Move s_cnt_uom_iid to gsPrev_cnt_uom_iid
    //          Move s_wgt_uom_inv to gsPrev_wgt_uom_inv
    //          Move s_vol_uom_inv to gsPrev_vol_uom_inv
    // 2.1 Save previous only if not blank
    If (s_cnt_uom_inv <> "") Move s_cnt_uom_inv to gsPrev_cnt_uom_inv
    If (s_cnt_uom_iid <> "") Move s_cnt_uom_iid to gsPrev_cnt_uom_iid
    If (s_wgt_uom_inv <> "") Move s_wgt_uom_inv to gsPrev_wgt_uom_inv
    If (s_vol_uom_inv <> "") Move s_vol_uom_inv to gsPrev_vol_uom_inv
    // 2019-05-07 end
    Move (s_pgapgm_list contains "1CFIA") to gbPrev_HasCfia   
    // 2019-02-25 end


    // 2018-10-14  
    // 3. fSetCcilin_Quan_Acr_From_Iid
    Get fSetCcilin_Quan_Acr_From_Iid of oSwInfo to gsOk  // cSwInfo.pkg
    If (gsOk <> "OK") Begin
        @unlock ccship ccimas ccilin
        @system_problem exit "fSetCcilin_Quan_Acr_From_Iid failed - not possible, it always returns OK"
    End
    // 2018-10-14 end         
    // 4. Update ccilin to do save ccimas
    Send update to (ccilin_ds(c_o))   // does save ccimas
    // 07/21/1997
    //  if its a warehouse out, force ccimas.moa_total_amt   to be
    //                                ccimas.tot_line_amount
    If (giWH_out) Begin
        Move ccimas.tot_line_amount to ccimas.moa_total_amt
    End
    // 5. Update ccimas
    Send Update to (ccimas_ds(c_o))   // does save ccship
    SaveRecord ccimas // 07/21/1997 not sure how it worked without this                    
    // 6. Update ccship
    Send update to (ccship_ds(c_o))
    SaveRecord ccship
    [err] Begin
        @unlock ccship ccimas ccilin
        @system_problem exit "Updating ccilin - enter.save"
    End
    // 7. Set fields for ccilin update from hidden fields   (sh_rating_item# is now on main screen)
    Move sh_rating_item#  to ccilin.rating_item# // 2015-03-18
    Move sh_other_quan    to ccilin.other_quan
    Move sh_acr_uom_cvt   to ccilin.acr_uom_cvt
    
    // 2019-05-05
    // 8. Set ccilin.hs#
    //      From rating rec
    //      Override from b3line.ovr_hs
    If (s_rating_rec# <> 0) Begin
        Clear rating
        Move s_rating_rec# to rating.recnum
        Find eq rating.recnum
        If (not(Found)) Clear rating
    End
    re$ b3line
    Move ""                                                 to ccilin.hs#
    If status rating              Move rating.hs_code14     to ccilin.hs#
    If b3line.ovr_hs_code14 ne "" Move b3line.ovr_hs_code14 to ccilin.hs#
    @@hscode_add_dots ccilin.hs# to ccilin.hs#
    // 2019-05-05 end
    // 2022-03-22
    // 9. Set ccilin.gst_code, oic_code, annex_code
    Move rating.gstrate_ref#   to ccilin.gst_code       // Overrideen below by b3line.gstreate_ref#   set in Enter2.Save 
    Move rating.rem_oic        to ccilin.oic_code       // Overridden below by b3line.oic_code     
    Move rating.rem_oic_sub    to ccilin.oic_sub_code   // Overrideen below by b3line.oic_sub_code 
    Move rating.annex_code     to ccilin.annex_code     // Overrideen below by b3line.oic_sub_code 
    // 2022-03-22 end
    // 2022-03-31
    If (b3line.gstrate_ref# <> "") Move b3line.gstrate_ref# to ccilin.gst_code
    If (b3line.oic_code <> "")     Move b3line.oic_code     to ccilin.oic_code
    If (b3line.oic_sub_code <> "") Move b3line.oic_sub_code to ccilin.oic_sub_code  // 2024-03-01 new field ccilin.oic_sub_code
    If (b3line.annex_code <> "")   Move b3line.annex_code   to ccilin.annex_code
    // 2022-03-31 end
    Get OicOrDrl of current_object b3line.Oic_Code b3line.Oic_Sub_code to ccilin.spec_auth_oic_or_drl    // 2024-10-17
    
    // 2024-01-07
    // ---------------------------------------------------------------------
    // 4. if (giNewline_added) or (gbRecPart_Changed) 
    //    Set Ccilin.Sima fields that may have been Set by set_from_rating_ratitem in dmLIb024.pkg
    // ---------------------------------------------------------------------
        at3 "[dmCcil1 Enter1.Save] gbNewLIne_added[" giNewline_added "] or gbRrecPart_Changed [" gbRrecPart_Changed "]"         
    If ((giNewline_added) or (gbRrecPart_Changed)) Begin
        at3 "[dmCcil1 Enter1.Save] gbNewLIne_added or gbRrecPart_Changed "
        Integer ghoRrecInfo
        Move (oRrec_info(Current_Object))     to ghoRrecInfo         
        Get psScnRr_Excise_Tax_Code           of ghoRrecInfo to Ccilin.Excise_Tax_Code           
        Get psScnRi_Sima_Surt_Safe_Mrf        of ghoRrecInfo to Ccilin.Sima_Surt_Safe_Mrf        
        Get psScnRi_MifCode_sima_surt_safe    of ghoRrecInfo to Ccilin.MifCode_sima_surt_safe    
        Get psScnRi_Sss_SubjectGoods_StmtCode of ghoRrecInfo to Ccilin.Sss_SubjectGoods_StmtCode 
        Get psScnRi_Sima_Code                 of ghoRrecInfo to Ccilin.Sima_Code                 
        Get psScnRi_Product_Model_Id          of ghoRrecInfo to Ccilin.Product_Model_Id          
        Get psScnRi_Sima_Stb_uom              of ghoRrecInfo to Ccilin.Sima_Stb_uom              
        Get psScnRi_Sima_Note1                of ghoRrecInfo to Ccilin.Sima_Note1                
        Get psScnRi_Sima_Note2                of ghoRrecInfo to Ccilin.Sima_Note2                
        Get psScnRi_Sima_Note3                of ghoRrecInfo to Ccilin.Sima_Note3                
        Get psScnRi_Sima_Note4                of ghoRrecInfo to Ccilin.Sima_Note4                
        Get pnScnRi_alcohol_percent           of ghoRrecInfo to Ccilin.alcohol_percent           
        Get psScnRi_Sima_Bond                 of ghoRrecInfo to Ccilin.Sima_Bond                 
        Get psScnRi_Sima_Mif_Provisional      of ghoRrecInfo to Ccilin.Sima_Mif_Provisional      
        // 2024-01-18
        Get psScnRi_Ruling_Number             of ghoRrecInfo to ccilin.Ruling_Number
        Get psScnRr_Oic_Code                  of ghoRrecInfo to ccilin.Oic_Code     
        Get psScnRr_Oic_Sub_Code              of ghoRrecInfo to ccilin.Oic_Sub_Code             
        // 2024-01-18 end
        // 2025-01-27
        Get psScnRi_Sima_MifCode              of ghoRrecInfo to Ccilin.Sima_MifCode               
        Get psScnRi_Sima_Subject_Code         of ghoRrecInfo to Ccilin.Sima_Subject_Code
        //Surtax          
        Get psScnRi_Surtax_Code               of ghoRrecInfo to Ccilin.Surtax_Code                
        Get psScnRi_Surtax_Subject_Code       of ghoRrecInfo to Ccilin.Surtax_Subject_Code                
                    
        //Safeguard
        Get psScnRi_Safeguard_Code            of ghoRrecInfo to Ccilin.Safeguard_Code             
        Get psScnRi_Safeguard_Subject_Code    of ghoRrecInfo to Ccilin.Safeguard_Subject_Code     
            at3 "ENTER1.SAVE set ccilin.sima_code to [" ccilin.sima_code "]sima_MifCode[" ccilin.sima_mifcode "]"
        // 2025-01-27 end
        // 2024-03-01
        Get psScnRr_Annex_Code                of ghoRrecInfo to ccilin.override_annex  // 2024-03-01
        Get OicOrDrl of current_object sc_Oic_Code sc_Oic_Sub_code to ccilin.spec_auth_oic_or_drl 
        // 2024-03-01 end
        // 2024-03-17
        // @Syntax Get_Attribute DF_FETCH_FIELD_COUNT of {FileNumber} to {variable}    
        // New field Override_Cbsa_Calc_Y is field number 48  
        // 2024-03-17
        Move 14 to giFileNumber  // OIC table if f#14  
        Get_Attribute DF_FETCH_FIELD_COUNT of giFileNumber to giFieldCount 
        // Sadly giFieldCount was 44. Huh? Where did that come from
        // New field #48 is Override_Cbsa_Calc_Y         
        // Plan B. Get flag #63 Y-New Oic field is defined. 
        String gsFlag63
        Move (uppercase(mid(sysfile2.flags,1,63))) to gsFlag63
        If (gsFlag63 = "Y") Move 48 to giFieldCount
        Else                Move 47 to giFieldCount
        at4 "[dmccil1] OIC Field count is [" giFieldCount "]"
    
        If (giFieldCount >= 48) Begin
            Get OicOverrideCbsaCalc of current_object sc_Oic_Code sc_Oic_Sub_code to ccilin.override_cbsa_calc_Y // 2024-03-14
        End
        // 2024-03-17 end
    End
    
    //2025-04-15
    Send SurtaxRecalculateOnSave
    
    // 2024-22-01
    // ---------------------------------------------------------------------
    // 5. if (giNewline_added)  
    //    Set Ccilin.Permit_Number using Permit_Number_From_HsPgaPgm in cCadUtil.pkg 
    //    from HsPgaPgm.Permit_Number_ForCcilin  
    // ---------------------------------------------------------------------
    If (giNewline_added) Begin         
        Get Permit_Number_From_HsPgaPgm of oCadUtil (trim(ccilin.PgaPgm_List)) to ccilin.Permit_Number
        // Note PgaPgm is used to find HsPgaPgm.Id_DataEntryKey
    End
    // at3 "[ENTER1.SAVE End] giTyp_b3lc [" giTyp_b3lc ("] b3line.vfd [" + b3line.vfd + "] s_vfd [" + s_vfd + "]")
RETURN

//ENTER1.POSTSAVE
#IFDEF TitleMarkerNeverTrue
Property String ENTER1.POSTSAVE
#ENDIF

ENTER1.POSTSAVE:
    FILE_MODE ccilin READ_ONLY
    FILE_MODE ccimas READ_ONLY
    FILE_MODE ccship READ_ONLY
    at3 "[DmCciL1 ENTER1.POSTSAVE] Start"
    
    // 1. Update b3line.xxx_uom_us
    re$   b3line
    If (b3line.b3line_code ne ccilin.b3line_code or b3line.bacf# ne ccship.bacf# ) Begin     
        @system_problem# 8014 Exit ;
            "Prior to update of b3line with UOM_US's. Mismatch to ccilin/bacf#" ;
            b3line.bacf# " vs " ccship.bacf# ;
            "[" b3line.b3line_code "]vs[" ccilin.b3line_code
    End
    Integer gbUpdB3line
    Move (b3line.cnt_uom_us   ne s_cnt_uom or ;
          b3line.wgt_uom_us   ne s_wgt_uom or ;
          b3line.vol_uom_us   ne s_vol_uom) ;
            to gbUpdB3line
                
    If (not(gbUpdB3line)) Begin
        Move (b3line.pga_auto ne Ccilin.ogd_group_auto or ;
              b3line.pgaPgm_list ne Ccilin.pgaPgm_list or ;
              b3line.sima ne Ccilin.sima);
                to gbUpdB3line
    End     
    
    If (gbUpdB3line) Begin         
    @lock b3line
    re$   b3line
       Move s_cnt_uom        to b3line.cnt_uom_us
       Move s_wgt_uom        to b3line.wgt_uom_us
       Move s_vol_uom        to b3line.vol_uom_us
       Move s_pga_auto       to b3line.pga_auto      
       Move s_pgaPgm_list    to b3line.pgaPgm_list       
       Move s_sima           to b3line.sima          
    SaveRecord b3line
    @unlock b3line
    End  
    // 2024-02-14
    // 1.5 Update B3line from Cad fields
    //     Useful when a new line is being added cuz fields on other screens set automatically
    Send UpdateB3line_From_CadInfo 
    Send UpdateB3line_From_SimaInfo      
    // 2024-02-14 end
    
    // 2024-07-29
    // If b3line.ctry_orig is blank set from ccilin.ctry_orig
    Move (False) to gbAddSysnote_B3lineCtryOrig_Blank
    If ((b3line.ctry_orig = "") and (ccilin.ctry_orig <> "")) Begin
        @lock b3line
        re$   b3line
        Move ccilin.ctry_orig to b3line.ctry_orig
        SaveRecord b3line
        @unlock b3line
        Move (True) to gbAddSysnote_B3lineCtryOrig_Blank
    End
    // 2024-07-29 end
    
    // 2. Update ccimas.xxx_uom_us
    re$   ccimas
    If ccimas.cci_id ne ccilin.cci_id Begin
        @system_problem# 8015 Wait ;
            "Prior to update of ccimas with UOM_US's. Mismatch to ccilin" ;
            ccimas.cci_id " vs " ccilin.cci_id
    End
    If (ccimas.cnt_uom_us ne s_cnt_uom or ;
            ccimas.wgt_uom_us ne s_wgt_uom or ;
            ccimas.vol_uom_us ne s_vol_uom) Begin                        
        @lock ccimas
        re$   ccimas
        Move s_cnt_uom to ccimas.cnt_uom_us
        Move s_wgt_uom to ccimas.wgt_uom_us
        Move s_vol_uom to ccimas.vol_uom_us
        SaveRecord ccimas
    @unlock ccimas
    End
    // 2018-04-16
    // ---------------------------------------------------------------------
    // 3. if (giNewline_added) Set CcXtraWSw [ccilin] from RrXtraSw [rating]
    // ---------------------------------------------------------------------
    // 2018-08-17 gfiNewline_added is true when it shouldnt be.
    // 2020-08-19
    // If (giNewline_added) Begin
    Move ((gbB3LineCode_WasBlank) and (Ccilin.b3line_code <> "")) to gbB3LineCode_Added
    // 2021-02-19
    // If ((giNewline_added) or (gbB3LineCode_Added)) Begin
    Move ((giPrev_RatingRecnum <> Ccilin.rating_rec#) or (giPrev_RatitemNum <> Ccilin.rating_item#)) to gbRrecPart_Changed
    If ((giNewline_added) or (gbB3LineCode_Added) or (gbRrecPart_Changed)) Begin // 2021-02-19 end // 2020-08-19 end // 2019-05-29
        // Get mCopy_RrXtraSw_To_CcXtraSw of oRrec_info Ccilin.rating_rec# ;  
        Get Copy_RrXtraSw_To_CcXtraSw of oXtraSw Ccilin.rating_rec# ;  
                                                 Ccilin.rating_item# ;
                                                 Ccilin.bacf# ;
                                                (Ccilin.cci_id + (Trim(Ccilin.ccil_id))) to gsOk255  //  cXtraSw.pkg
        If (gsOk255 <> "OK") Begin
            @errormsg gsOk255
            @errormsg (mid(gsOk255,80,70))
            If (Length(gsOk255) > 41) Move (Right(gsOk255, 41)) to gsOk
            Else                      Move gsOk255              to gsOk 
            @system_problem exit ("[ENTER1.POSTSAVE] " + gsOk)
        End
    End  // (giNewline_added)
    // 2018-04-16 end
    // at3 ("[ENTER1.POSTSAVE End] b3line.vfd [" + b3line.vfd + "] s_vfd [" + s_vfd + "]")
    
    // 2024-07-29
    If (gbAddSysnote_B3lineCtryOrig_Blank) Begin
      @system_note "B3line CtryOrig blank Bacf# [" B3line.bacf# "] now [" b3line.ctry_orig "] from ccilin"           
    End
    // 2024-07-29 end
RETURN //ENTER1.POSTSAVE

